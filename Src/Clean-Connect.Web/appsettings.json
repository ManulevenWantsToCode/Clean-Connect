{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Authentication": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Sensitive": { "PermitLimit": 30, "WindowSeconds": 60 },
    "PublicRead": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "Jwt": {
    "DurationInMinutes": 60
  },
  "Email": {
    "Smtp": {
      "Port": 587
    }
  },
  "Paystack": {
    "BaseUrl": "https://api.paystack.co"
  },
  "AgoraChat": {
    "ApiHost": "https://a61.chat.agora.io",
    "UserTokenTtlSeconds": 1800,
    "AppTokenTtlSeconds": 1800,
    "ProvisionUsers": true
  }
}
