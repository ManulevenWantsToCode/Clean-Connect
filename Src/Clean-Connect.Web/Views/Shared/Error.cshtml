@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Error";
    var statusCode = Model.StatusCode == 0 ? 500 : Model.StatusCode;

    var statusLabel = statusCode switch
    {
        404 => "Page not found",
        403 => "Access denied",
        401 => "Sign in required",
        500 => "Something went wrong",
        _ => "Something went wrong"
    };

    var userFriendlyMessage = !string.IsNullOrWhiteSpace(Model.Message)
        ? Model.Message
        : statusCode switch
        {
            404 => "The page you're looking for doesn't exist or may have been moved.",
            403 => "You don't have permission to view this page. If this seems wrong, contact support.",
            401 => "Please sign in to your account to continue.",
            _ => "We ran into an unexpected problem. Our team has been notified and your data is safe."
        };
}

<div class="cc-error-container" data-request-id="@Model.RequestId">
    @if (Model.ShowRequestId)
    {
        <!-- Support Reference: @Model.RequestId -->
    }

    <div class="cc-error-card" role="region" aria-labelledby="errorHeading">
        <p class="cc-error-code">@statusCode</p>
        <h1 id="errorHeading" class="cc-error-title">@statusLabel</h1>
        <p class="cc-error-desc">@userFriendlyMessage</p>

        <div class="cc-error-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var dashboardController = User.IsInRole("Worker") ? "Worker" : User.IsInRole("Client") ? "Client" : "Dashboard";
                <a asp-controller="@dashboardController"
                   asp-action="Dashboard"
                   class="btn cc-action-button cc-action-button--primary">
                    Go to dashboard
                </a>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn cc-action-button cc-action-button--primary">
                    Go to homepage
                </a>
            }

            <button type="button"
                    onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }"
                    class="btn cc-action-button cc-action-button--secondary">
                Go back
            </button>
        </div>

        <p class="cc-error-help">
            Need help?
            <a asp-controller="Home" asp-action="Contact">Contact support</a>
        </p>
    </div>
</div>