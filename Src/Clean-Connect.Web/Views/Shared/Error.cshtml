@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <div class="error-page__card">
        <div class="error-page__icon">
            <i class="fa-solid @(Model.StatusCode == 404 ? "fa-compass" : Model.StatusCode == 403 ? "fa-lock" : Model.StatusCode == 401 ? "fa-user-lock" : "fa-circle-exclamation")"></i>
        </div>

        <span class="error-page__code">@(Model.StatusCode == 0 ? "500" : Model.StatusCode.ToString())</span>

        <h1>@Model.Title</h1>
        <p>@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <div class="error-page__trace">
                <span>Request ID</span>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-page__actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-pill px-4">
                <i class="fa-solid fa-house me-2"></i>Back to Home
            </a>
            <button type="button" onclick="history.back()" class="btn btn-outline-success rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-2"></i>Go Back
            </button>
        </div>
    </div>
</div>