@inject Clean_Connect.Application.Interface.Repositories.IPlatformSettingsRepository PlatformSettingsRepository
@{ var platformSettings = await PlatformSettingsRepository.GetAsync(Context.RequestAborted); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @platformSettings.PlatformName</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard-redesign.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/cleanconnect-frontend.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/profile-forms.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/notyf/notyf.min.css" />

    <link rel="stylesheet"
          href="~/css/toast-overrides.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <partial name="_DashboardNavbar" />

    <button type="button"
            class="cc-sidebar-mobile-toggle"
            id="ccSidebarMobileToggle"
            hidden
            aria-label="Open dashboard navigation"
            aria-controls="ccSidebar"
            aria-expanded="false"
            title="Open dashboard navigation">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <!-- Overlay backdrop -->
    <div class="cc-sidebar-overlay" id="ccSidebarOverlay" aria-hidden="true"></div>

    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/notyf/notyf.min.js"></script>
    @await Component.InvokeAsync("Notyf")

    <script>
        (function () {
            var BREAKPOINT = 1100;
            var SIDEBAR_STORAGE_KEY = 'cc_sidebar_collapsed_v2';
            var desktopToggle = document.getElementById('ccSidebarToggle');
            var mobileToggle = document.getElementById('ccSidebarMobileToggle');
            var overlay = document.getElementById('ccSidebarOverlay');
            var rail    = document.querySelector('.cc-rail');
            var shell   = document.querySelector('.cc-dashboard-shell');

            if (!rail || !shell || !desktopToggle || !mobileToggle) return;

            var closeButton = rail.querySelector('.cc-rail__close');
            var desktopToggleIcon = desktopToggle.querySelector('i');
            var desktopToggleLabel = desktopToggle.querySelector('span');
            var isMobileLayout = window.innerWidth <= BREAKPOINT;
            var previousBodyOverflow = '';

            function syncMobileToggle() {
                mobileToggle.classList.toggle('has-sidebar', isMobileLayout);
                mobileToggle.hidden = !isMobileLayout;
            }

            // ── Mobile Drawer Open / Close ─────────────────────────────────
            function openMobileDrawer() {
                if (!isMobileLayout) return;
                previousBodyOverflow = document.body.style.overflow;
                rail.classList.add('cc-rail--open');
                rail.removeAttribute('aria-hidden');
                rail.inert = false;
                mobileToggle.setAttribute('aria-expanded', 'true');
                if (overlay) {
                    overlay.classList.add('is-visible');
                    overlay.setAttribute('aria-hidden', 'false');
                }
                document.body.style.overflow = 'hidden';
                if (closeButton) closeButton.focus();
            }

            function closeMobileDrawer(restoreFocus) {
                rail.classList.remove('cc-rail--open');
                rail.setAttribute('aria-hidden', isMobileLayout ? 'true' : 'false');
                rail.inert = isMobileLayout;
                mobileToggle.setAttribute('aria-expanded', 'false');
                if (overlay) {
                    overlay.classList.remove('is-visible');
                    overlay.setAttribute('aria-hidden', 'true');
                }
                document.body.style.overflow = previousBodyOverflow;
                if (restoreFocus && isMobileLayout) mobileToggle.focus();
            }

            function setDesktopSidebarCollapsed(isCollapsed) {
                shell.classList.toggle('cc-sidebar-collapsed', isCollapsed);
                desktopToggle.setAttribute('aria-expanded', (!isCollapsed).toString());
                desktopToggle.setAttribute('aria-label', isCollapsed ? 'Expand sidebar' : 'Collapse sidebar');
                desktopToggle.setAttribute('title', isCollapsed ? 'Expand sidebar' : 'Collapse sidebar');
                if (desktopToggleLabel) desktopToggleLabel.textContent = isCollapsed ? 'Expand sidebar' : 'Collapse sidebar';
                if (desktopToggleIcon) {
                    desktopToggleIcon.className = isCollapsed
                        ? 'fa-solid fa-angles-right'
                        : 'fa-solid fa-angles-left';
                }
            }

            function getSavedDesktopSidebarState() {
                try {
                    var savedState = localStorage.getItem(SIDEBAR_STORAGE_KEY);
                    return savedState === null || savedState === 'true';
                } catch (e) {}
                return true;
            }

            // Restore the saved desktop width; mobile always starts with a closed drawer.
            if (isMobileLayout) {
                syncMobileToggle();
                setDesktopSidebarCollapsed(false);
                rail.setAttribute('aria-hidden', 'true');
                rail.inert = true;
            } else {
                syncMobileToggle();
                rail.removeAttribute('aria-hidden');
                rail.inert = false;
                setDesktopSidebarCollapsed(isMobileLayout ? false : getSavedDesktopSidebarState());
            }

            desktopToggle.addEventListener('click', function () {
                if (isMobileLayout) return;
                var isCollapsed = !shell.classList.contains('cc-sidebar-collapsed');
                setDesktopSidebarCollapsed(isCollapsed);
                try {
                    localStorage.setItem(SIDEBAR_STORAGE_KEY, isCollapsed ? 'true' : 'false');
                } catch (e) {}
            });

            mobileToggle.addEventListener('click', function () {
                if (rail.classList.contains('cc-rail--open')) {
                    closeMobileDrawer(false);
                } else {
                    openMobileDrawer();
                }
            });

            if (overlay) overlay.addEventListener('click', function () { closeMobileDrawer(true); });
            if (closeButton) closeButton.addEventListener('click', function () { closeMobileDrawer(true); });

            // Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && rail.classList.contains('cc-rail--open')) closeMobileDrawer(true);
            });

            var wasMobileLayout = isMobileLayout;
            window.addEventListener('resize', function () {
                var nextIsMobileLayout = window.innerWidth <= BREAKPOINT;
                if (nextIsMobileLayout === wasMobileLayout) return;
                wasMobileLayout = nextIsMobileLayout;
                isMobileLayout = nextIsMobileLayout;
                syncMobileToggle();
                closeMobileDrawer(false);
                setDesktopSidebarCollapsed(isMobileLayout ? false : getSavedDesktopSidebarState());
                if (!isMobileLayout) {
                    rail.removeAttribute('aria-hidden');
                    rail.inert = false;
                }
            });

            // Close drawer when a nav link is tapped on mobile
            rail.querySelectorAll('.cc-rail__link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (isMobileLayout) closeMobileDrawer(false);
                });
            });
        })();
    </script>
</body>
</html>

