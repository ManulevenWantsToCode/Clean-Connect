@model Clean_Connect.Application.Command.ClientCommands.CreateClientCommand

@{
    ViewData["Title"] = "Create Client Profile";
    var prefillReferral = Model is null && ViewData["ReferralCode"] is string rc && !string.IsNullOrWhiteSpace(rc) ? rc.Trim() : null;
}

<link rel="stylesheet" href="~/css/profile-forms.css" asp-append-version="true" />

<div class="client-profile-page py-5">
    <div class="container profile-form-container">

        <!-- ========================================= -->
        <!-- PAGE HERO HEADER -->
        <!-- ========================================= -->
        <div class="profile-header" data-aos="fade-down">
            <div class="profile-badge-pill">
                <span class="pulse-dot"></span>
                <i class="fa-solid fa-sparkles"></i>
                Client Onboarding
            </div>

            <h1 class="profile-title">
                Complete Your <span class="highlight-text">Client Profile</span>
            </h1>

            <p class="profile-subtitle">
                Set up your verified profile to start booking vetted, top-rated cleaning professionals across your area.
            </p>

            <!-- Trust Perks Strip -->
            <div class="profile-perks-strip">
                <span class="profile-perk-item">
                    <i class="fa-solid fa-shield-check"></i>
                    100% Vetted Cleaners
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-bolt"></i>
                    Instant Booking Confirmation
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-lock"></i>
                    Secure Escrow Payments
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-star"></i>
                    Satisfaction Guaranteed
                </span>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- PROGRESS STEPPER -->
        <!-- ========================================= -->
        <div class="profile-stepper-wrap" data-aos="fade-up" data-aos-delay="100">
            <div class="profile-stepper">
                <div class="step-item active" id="stepperItem1">
                    <div class="step-circle">1</div>
                    <div class="step-content">
                        <span class="step-label">Step 01</span>
                        <span class="step-title">Personal Details</span>
                    </div>
                </div>

                <div class="step-connector" id="connector1"></div>

                <div class="step-item" id="stepperItem2">
                    <div class="step-circle">2</div>
                    <div class="step-content">
                        <span class="step-label">Step 02</span>
                        <span class="step-title">Location & Invite</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- MAIN PROFILE FORM -->
        <!-- ========================================= -->
        <form asp-action="CreateClientProfile"
              asp-controller="Client"
              method="post"
              id="clientProfileForm"
              novalidate>

            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="profile-validation-summary" role="alert">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                        <strong>Please review the information you provided:</strong>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                </div>
            }

            <!-- ========================================= -->
            <!-- STEP 1: PERSONAL INFORMATION -->
            <!-- ========================================= -->
            <div id="step1" class="wizard-step active">
                <div class="profile-card" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-header-clean">
                        <div class="profile-card-header-left">
                            <div class="profile-card-icon-box">
                                <i class="fa-solid fa-user-check"></i>
                            </div>
                            <div class="profile-card-header-text">
                                <h3>Personal Information</h3>
                                <p>Tell us about yourself so our cleaning professionals know who they are serving.</p>
                            </div>
                        </div>
                        <span class="profile-card-badge">Step 1 of 2</span>
                    </div>

                    <div class="card-body-clean">
                        <div class="row g-4">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="FirstName" class="form-field-label">
                                        <span class="label-main">Legal First Name <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <input asp-for="FirstName"
                                               class="form-control"
                                               id="FirstName"
                                               placeholder="e.g. Samuel"
                                               autocomplete="given-name"
                                               required />
                                    </div>
                                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="LastName" class="form-field-label">
                                        <span class="label-main">Last Name / Surname <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <input asp-for="LastName"
                                               class="form-control"
                                               id="LastName"
                                               placeholder="e.g. Okonkwo"
                                               autocomplete="family-name"
                                               required />
                                    </div>
                                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Email Address -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="Email" class="form-field-label">
                                        <span class="label-main">Primary Email Address <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-envelope"></i>
                                        </div>
                                        <input asp-for="Email"
                                               type="email"
                                               class="form-control"
                                               id="Email"
                                               placeholder="samuel.okonkwo@example.com"
                                               autocomplete="email"
                                               required />
                                    </div>
                                    <span asp-validation-for="Email" class="field-validation-error"></span>
                                    <small class="field-help-text">Booking confirmations and invoices will be sent to this email.</small>
                                </div>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="Contact" class="form-field-label">
                                        <span class="label-main">Primary Phone Number <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-phone"></i>
                                        </div>
                                        <input asp-for="Contact"
                                               type="tel"
                                               class="form-control"
                                               id="Contact"
                                               placeholder="e.g. 0801 234 5678"
                                               autocomplete="tel"
                                               required />
                                    </div>
                                    <span asp-validation-for="Contact" class="field-validation-error"></span>
                                    <small class="field-help-text">Used for job alerts, cleaner arrival notifications, and updates.</small>
                                </div>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="Gender" class="form-field-label">
                                        <span class="label-main">Gender <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-venus-mars"></i>
                                        </div>
                                        <select asp-for="Gender"
                                                class="form-select"
                                                id="Gender"
                                                required>
                                            <option value="" disabled selected hidden>Select your gender</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Gender" class="field-validation-error"></span>
                                    <small class="field-help-text">Used to match you with suitably vetted cleaners.</small>
                                </div>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <label asp-for="Dob" class="form-field-label">
                                        <span class="label-main">Date of Birth <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-calendar-day"></i>
                                        </div>
                                        <input asp-for="Dob"
                                               type="date"
                                               class="form-control"
                                               id="Dob"
                                               required />
                                    </div>
                                    <span asp-validation-for="Dob" class="field-validation-error"></span>
                                    <small class="field-help-text">Used for identity confirmation and account security.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Action -->
                <div class="profile-actions-bar">
                    <div></div>
                    <button type="button"
                            id="nextBtn1"
                            class="btn-wizard-action btn-wizard-primary">
                        Continue to Location
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- ========================================= -->
            <!-- STEP 2: LOCATION & REFERRAL -->
            <!-- ========================================= -->
            <div id="step2" class="wizard-step">
                <div class="profile-card">
                    <div class="card-header-clean">
                        <div class="profile-card-header-left">
                            <div class="profile-card-icon-box">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div class="profile-card-header-text">
                                <h3>Location & Service Address</h3>
                                <p>Your location helps us connect you with certified cleaners closest to your home or facility.</p>
                            </div>
                        </div>
                        <span class="profile-card-badge">Step 2 of 2</span>
                    </div>

                    <div class="card-body-clean">
                        <!-- Auto-Detect Geolocation Banner -->
                        <div class="location-hero-banner">
                            <div class="location-hero-info">
                                <div class="location-hero-icon">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </div>
                                <div class="location-hero-text">
                                    <h5>Auto-Detect Current Location</h5>
                                    <p>Click below to automatically calibrate your GPS coordinates and state.</p>
                                </div>
                            </div>
                            <button type="button"
                                    id="detectLocationBtn"
                                    class="btn-detect-action">
                                <i class="fa-solid fa-location-crosshairs"></i>
                                Use My Current Location
                            </button>
                        </div>

                        <!-- Manual / Detected Coordinates Fields -->
                        <div class="row g-4 mb-4">
                            <!-- State -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <label asp-for="State" class="form-field-label">
                                        <span class="label-main">State / Region of Residence <span class="required-indicator">*</span></span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-map"></i>
                                        </div>
                                        <input asp-for="State"
                                               id="state"
                                               class="form-control"
                                               placeholder="e.g. Lagos, Abuja"
                                               required />
                                    </div>
                                    <span asp-validation-for="State" class="field-validation-error"></span>
                                    <small class="field-help-text">We use this to match you with the nearest certified cleaners.</small>
                                </div>
                            </div>

                            <!-- Latitude -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <label asp-for="Latitude" class="form-field-label">
                                        <span class="label-main">GPS Latitude</span>
                                    </label>
                                    <div class="custom-input-box readonly-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-compass"></i>
                                        </div>
                                        <input asp-for="Latitude"
                                               id="latitude"
                                               class="form-control"
                                               placeholder="Detected automatically"
                                               readonly />
                                    </div>
                                    <span asp-validation-for="Latitude" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Longitude -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <label asp-for="Longitude" class="form-field-label">
                                        <span class="label-main">GPS Longitude</span>
                                    </label>
                                    <div class="custom-input-box readonly-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-crosshairs"></i>
                                        </div>
                                        <input asp-for="Longitude"
                                               id="longitude"
                                               class="form-control"
                                               placeholder="Detected automatically"
                                               readonly />
                                    </div>
                                    <span asp-validation-for="Longitude" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Live Metrics Cards -->
                        <div class="location-metrics-grid">
                            <div class="location-metric-card">
                                <div class="location-metric-icon text-primary">
                                    <i class="fa-solid fa-map-pin"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Detected State</div>
                                    <span id="statePreview" class="location-metric-value">Not Detected</span>
                                </div>
                            </div>

                            <div class="location-metric-card">
                                <div class="location-metric-icon text-danger">
                                    <i class="fa-solid fa-location-dot"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Latitude</div>
                                    <span id="latPreview" class="location-metric-value">---</span>
                                </div>
                            </div>

                            <div class="location-metric-card">
                                <div class="location-metric-icon text-info">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Longitude</div>
                                    <span id="lngPreview" class="location-metric-value">---</span>
                                </div>
                            </div>
                        </div>

                        <!-- Map Preview Wrapper -->
                        <div class="map-embed-wrapper mb-4">
                            <div id="mapPlaceholder" class="map-placeholder-box">
                                <div class="map-placeholder-icon">
                                    <i class="fa-solid fa-map-location-dot"></i>
                                </div>
                                <h6>Interactive Map Preview</h6>
                                <p>Click "Use My Current Location" above to center the map on your exact cleaning address.</p>
                            </div>
                            <iframe id="mapFrame"
                                    class="map-embed-frame"
                                    style="display:none;"
                                    title="Cleaning Location Map"
                                    loading="lazy"></iframe>
                        </div>

                        <!-- Referral Code Section -->
                        <div class="referral-bonus-card">
                            <div class="referral-bonus-icon">
                                <i class="fa-solid fa-gift"></i>
                            </div>
                            <div class="referral-bonus-content flex-grow-1">
                                <h6>Have an Invitation Code?</h6>
                                <p class="mb-3">Enter the referral code of the Clean Connect member who invited you to claim initial booking discounts.</p>
                                <div class="form-field-group mb-0" style="max-width: 380px;">
                                    <label asp-for="ReferralCode" class="form-field-label">
                                        <span class="label-main">Referral / Invitation Code</span>
                                        <span class="optional-pill">Optional</span>
                                    </label>
                                    <div class="custom-input-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-ticket"></i>
                                        </div>
                                        <input asp-for="ReferralCode"
                                               class="form-control"
                                               id="ReferralCode"
                                               placeholder="e.g. CLEAN-XYZ123"
                                               value="@(prefillReferral)" />
                                    </div>
                                    <span asp-validation-for="ReferralCode" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Actions -->
                <div class="profile-actions-bar">
                    <button type="button"
                            id="prevBtn2"
                            class="btn-wizard-action btn-wizard-secondary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Personal Info
                    </button>

                    <button type="submit"
                            id="saveButton"
                            class="btn-wizard-action btn-wizard-primary">
                        <i class="fa-solid fa-sparkles"></i>
                        Create My Profile
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/client-profile.js" asp-append-version="true"></script>
}
