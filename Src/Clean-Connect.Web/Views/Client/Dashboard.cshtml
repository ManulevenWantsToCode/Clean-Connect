@model Clean_Connect.Application.Query.ClientsQuery.ClientDashboardDto

@{
    ViewData["Title"] = "Client Dashboard";
    Layout = "_DashboardLayout";

    var clientName = string.IsNullOrWhiteSpace(Model.ClientName) ? "Client" : Model.ClientName;
    var firstName = clientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Client";
    var activeStatusText = Model.ActiveBookings == 1 ? "1 active booking" : $"{Model.ActiveBookings} active bookings";
}

<div class="cc-dashboard cc-dashboard--client">
    <div class="cc-dashboard-shell">
        <aside class="cc-rail" aria-label="Client dashboard navigation">
            <a class="cc-rail__brand" asp-controller="Home" asp-action="Index" aria-label="Clean Connect home">
                <span class="cc-rail__logo"><i class="fa-solid fa-broom"></i></span>
                <span>
                    <strong>Clean Connect</strong>
                    <small>Client workspace</small>
                </span>
            </a>

            <nav class="cc-rail__nav">
                <a class="cc-rail__link is-active" asp-controller="Client" asp-action="Dashboard">
                    <i class="fa-solid fa-table-cells-large"></i>
                    <span>Overview</span>
                </a>
                <a class="cc-rail__link" asp-controller="Booking" asp-action="ChooseWorker">
                    <i class="fa-solid fa-calendar-plus"></i>
                    <span>Book service</span>
                </a>
                <a class="cc-rail__link" asp-controller="Booking" asp-action="ClientResponses">
                    <i class="fa-solid fa-clipboard-check"></i>
                    <span>Bookings</span>
                </a>
                <a class="cc-rail__link" asp-controller="Notifications" asp-action="Index">
                    <i class="fa-solid fa-bell"></i>
                    <span>Updates</span>
                </a>
                <a class="cc-rail__link" href="/Update-Client-Details">
                    <i class="fa-solid fa-id-card"></i>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="cc-rail__panel">
                <span class="cc-rail__panel-label">Referral code</span>
                <strong>@Model.ReferralCode</strong>
                <small>@Model.SuccessfulReferralCount successful referral@(Model.SuccessfulReferralCount == 1 ? "" : "s")</small>
            </div>
        </aside>

        <main class="cc-main">
            <section class="cc-hero" aria-labelledby="client-dashboard-title">
                <div class="cc-hero__content">
                    <span class="cc-kicker">
                        <i class="fa-solid fa-house-chimney"></i>
                        Client dashboard
                    </span>
                    <h1 id="client-dashboard-title">Welcome back, @firstName</h1>
                    <p>
                        Manage upcoming cleaning visits, review worker responses, and keep your service history in one place.
                    </p>

                    <div class="cc-hero__meta">
                        @if (!string.IsNullOrWhiteSpace(Model.State))
                        {
                            <span><i class="fa-solid fa-location-dot"></i>@Model.State</span>
                        }
                        <span><i class="fa-solid fa-clock"></i>@activeStatusText</span>
                    </div>
                </div>

                <div class="cc-hero__actions">
                    <a asp-controller="Booking" asp-action="ChooseWorker" class="cc-btn cc-btn--primary">
                        <i class="fa-solid fa-plus"></i>
                        Book a cleaner
                    </a>
                    <a asp-controller="Booking" asp-action="ClientResponses" class="cc-btn cc-btn--soft">
                        <i class="fa-solid fa-list-check"></i>
                        View bookings
                    </a>
                </div>
            </section>

            <section class="cc-metric-grid" aria-label="Client dashboard summary">
                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-green"><i class="fa-solid fa-broom"></i></span>
                    <span class="cc-metric__label">Total jobs</span>
                    <strong>@Model.TotalJobs</strong>
                    <small>Booked through Clean Connect</small>
                </article>

                <article class="cc-metric cc-metric--attention">
                    <span class="cc-metric__icon cc-tone-amber"><i class="fa-solid fa-hourglass-half"></i></span>
                    <span class="cc-metric__label">Active now</span>
                    <strong>@Model.ActiveBookings</strong>
                    <small>Awaiting, paid, or in progress</small>
                </article>

                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-blue"><i class="fa-solid fa-circle-check"></i></span>
                    <span class="cc-metric__label">Completed</span>
                    <strong>@Model.CompletedBookings</strong>
                    <small>Finished service visits</small>
                </article>

                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-teal"><i class="fa-solid fa-wallet"></i></span>
                    <span class="cc-metric__label">Total spent</span>
                    <strong>&#8358;@Model.TotalSpent.ToString("N0")</strong>
                    <a href="/Money-Review">Review breakdown</a>
                </article>
            </section>

            <section class="cc-content-grid">
                <article class="cc-panel cc-panel--wide">
                    <div class="cc-panel__head">
                        <div>
                            <span class="cc-section-label">Recent activity</span>
                            <h2>Bookings</h2>
                        </div>
                        <a asp-controller="Booking" asp-action="ClientResponses" class="cc-link-button">
                            View all
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>

                    @if (Model.RecentBookings == null || Model.RecentBookings.Count == 0)
                    {
                        <div class="cc-empty">
                            <span class="cc-empty__icon"><i class="fa-solid fa-calendar-plus"></i></span>
                            <h3>No bookings yet</h3>
                            <p>Start with a home, apartment, or office cleaning request. Worker responses will appear here.</p>
                            <a asp-controller="Booking" asp-action="ChooseWorker" class="cc-btn cc-btn--primary">
                                <i class="fa-solid fa-plus"></i>
                                Book your first cleaning
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="cc-booking-list">
                            @foreach (var booking in Model.RecentBookings)
                            {
                                var bookingStatus = (booking.BookingStatus ?? "").ToLower().Replace(" ", "");
                                var paymentStatus = (booking.PaymentStatus ?? "").ToLower().Replace(" ", "");
                                var workerInitial = string.IsNullOrWhiteSpace(booking.WorkerName) ? "C" : booking.WorkerName.Substring(0, 1).ToUpper();

                                <article class="cc-booking-row" onclick="window.location.href='/Client-Booking-Details/@booking.BookingId'">
                                    <div class="cc-avatar" aria-hidden="true">@workerInitial</div>
                                    <div class="cc-booking-row__main">
                                        <strong>@booking.WorkerName</strong>
                                        <span>@booking.ServiceName</span>
                                        @if (!string.IsNullOrWhiteSpace(booking.Address))
                                        {
                                            <small><i class="fa-solid fa-location-dot"></i>@booking.Address</small>
                                        }
                                    </div>
                                    <div class="cc-booking-row__date">
                                        <strong>@booking.DateOfService.ToString("MMM dd")</strong>
                                        <span>@booking.DateOfService.ToString("yyyy")</span>
                                    </div>
                                    <div class="cc-booking-row__status">
                                        <span class="cc-status cc-status--@bookingStatus">@booking.BookingStatus</span>
                                        <span class="cc-status cc-status--payment cc-status--@paymentStatus">@booking.PaymentStatus</span>
                                    </div>
                                    <a asp-controller="Booking" asp-action="Details" asp-route-bookingId="@booking.BookingId"
                                       class="cc-icon-button" aria-label="View booking details" onclick="event.stopPropagation();">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                </article>

                <aside class="cc-stack">
                    <article class="cc-panel">
                        <div class="cc-panel__head">
                            <div>
                                <span class="cc-section-label">Shortcuts</span>
                                <h2>Quick actions</h2>
                            </div>
                        </div>

                        <div class="cc-action-list">
                            <a asp-controller="Booking" asp-action="ChooseWorker" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-green"><i class="fa-solid fa-calendar-plus"></i></span>
                                <span><strong>Book a cleaner</strong><small>Schedule a new service</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a asp-controller="Booking" asp-action="ClientResponses" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-blue"><i class="fa-solid fa-user-check"></i></span>
                                <span><strong>Worker responses</strong><small>Review offers and payments</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a asp-controller="Notifications" asp-action="Index" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-amber"><i class="fa-solid fa-bell"></i></span>
                                <span><strong>Notifications</strong><small>Track updates</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="/Update-Client-Details" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-violet"><i class="fa-solid fa-id-card"></i></span>
                                <span><strong>Edit profile</strong><small>Update address and contact</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>

                    <article class="cc-panel cc-referral">
                        <div class="cc-panel__head">
                            <div>
                                <span class="cc-section-label">Rewards</span>
                                <h2>Referral link</h2>
                            </div>
                            <span class="cc-referral__count">@Model.SuccessfulReferralCount</span>
                        </div>

                        <p>Share Clean Connect with people who need reliable cleaning help. Your invite code stays ready below.</p>

                        <label class="cc-field-label" for="referralLinkInput">Referral link</label>
                        <div class="cc-copy-field">
                            <input type="text" id="referralLinkInput"
                                   value="@Url.Action("Register", "Auth", new { refCode = Model.ReferralCode }, Context.Request.Scheme)"
                                   readonly />
                            <button type="button" id="copyReferralLinkBtn" class="cc-copy-button">
                                <i class="fa-solid fa-copy"></i>
                                Copy
                            </button>
                        </div>

                        <div class="cc-share-row" aria-label="Share referral link">
                            <a href="#" id="shareWhatsAppBtn" class="cc-share cc-share--whatsapp" target="_blank" rel="noopener" title="Share on WhatsApp">
                                <i class="fa-brands fa-whatsapp"></i>
                            </a>
                            <a href="#" id="shareTelegramBtn" class="cc-share cc-share--telegram" target="_blank" rel="noopener" title="Share on Telegram">
                                <i class="fa-brands fa-telegram"></i>
                            </a>
                            <a href="#" id="shareXBtn" class="cc-share cc-share--x" target="_blank" rel="noopener" title="Share on X">
                                <i class="fa-brands fa-x-twitter"></i>
                            </a>
                            <a href="#" id="shareEmailBtn" class="cc-share cc-share--email" target="_blank" rel="noopener" title="Share by email">
                                <i class="fa-solid fa-envelope"></i>
                            </a>
                        </div>

                        <label class="cc-field-label" for="referralCodeInput">Invite code</label>
                        <div class="cc-copy-field cc-copy-field--code">
                            <input type="text" id="referralCodeInput" value="@Model.ReferralCode" readonly />
                            <button type="button" id="copyReferralBtn" class="cc-copy-button cc-copy-button--outline">
                                <i class="fa-solid fa-copy"></i>
                                Copy code
                            </button>
                        </div>
                    </article>
                </aside>
            </section>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function showCopyFeedback(btn, originalHtml) {
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied';
                btn.classList.add("is-copied");
                setTimeout(function () {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove("is-copied");
                }, 2000);
            }

            const copyBtn = document.getElementById("copyReferralBtn");
            const referralInput = document.getElementById("referralCodeInput");

            if (copyBtn && referralInput) {
                const originalCodeHtml = copyBtn.innerHTML;
                copyBtn.addEventListener("click", function () {
                    referralInput.select();
                    navigator.clipboard.writeText(referralInput.value).then(function () {
                        showCopyFeedback(copyBtn, originalCodeHtml);
                    }).catch(function () {
                        document.execCommand("copy");
                        showCopyFeedback(copyBtn, originalCodeHtml);
                    });
                });
            }

            const linkInput = document.getElementById("referralLinkInput");
            const copyLinkBtn = document.getElementById("copyReferralLinkBtn");

            if (copyLinkBtn && linkInput) {
                const originalLinkHtml = copyLinkBtn.innerHTML;
                copyLinkBtn.addEventListener("click", function () {
                    linkInput.select();
                    navigator.clipboard.writeText(linkInput.value).then(function () {
                        showCopyFeedback(copyLinkBtn, originalLinkHtml);
                    }).catch(function () {
                        document.execCommand("copy");
                        showCopyFeedback(copyLinkBtn, originalLinkHtml);
                    });
                });
            }

            const currentLink = linkInput ? linkInput.value : window.location.origin;
            const message = "Hey! Join me on Clean Connect to book verified, professional cleaning services. Use my link: " + currentLink;

            const shareWhatsAppBtn = document.getElementById("shareWhatsAppBtn");
            if (shareWhatsAppBtn) {
                shareWhatsAppBtn.href = "https://wa.me/?text=" + encodeURIComponent(message);
            }

            const shareTelegramBtn = document.getElementById("shareTelegramBtn");
            if (shareTelegramBtn) {
                shareTelegramBtn.href = "https://t.me/share/url?url=" + encodeURIComponent(currentLink) + "&text=" + encodeURIComponent("Join me on Clean Connect to book verified cleaning services.");
            }

            const shareXBtn = document.getElementById("shareXBtn");
            if (shareXBtn) {
                shareXBtn.href = "https://twitter.com/intent/tweet?url=" + encodeURIComponent(currentLink) + "&text=" + encodeURIComponent("Join me on Clean Connect to book verified cleaning services.");
            }

            const shareEmailBtn = document.getElementById("shareEmailBtn");
            if (shareEmailBtn) {
                shareEmailBtn.href = "mailto:?subject=" + encodeURIComponent("Join me on Clean Connect") + "&body=" + encodeURIComponent(message);
            }
        });
    </script>
}
