@model Clean_Connect.Application.DTO.MoneyReviewDto

@{
    ViewData["Title"] = "Money Review";
    Layout = "_DashboardLayout";
    var unitLabel = Model.IsWorker ? "Income" : "Spending";
}

<link rel="stylesheet" href="~/css/money-review.css" asp-append-version="true" />

<div class="dash-page money-review-page">
    <div class="container">

        <!-- Header -->
        <div class="dash-header d-flex flex-wrap align-items-center justify-content-between mb-4">
            <div>
                <h1>Money Review</h1>
                <p>@(Model.IsWorker ? "Track your income, platform fees and earning trends from completed jobs." : "Track your spending, booking trends and where your money goes.")</p>
            </div>
            <div class="d-flex gap-3 mt-3 mt-lg-0">
                <span class="dash-badge">
                    <i class="fa-solid fa-chart-line"></i>
                    Live Analytics
                </span>
            </div>
        </div>

        <!-- Top Stats Row -->
        <div class="stats-grid mb-5">
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="fa-solid fa-sack-dollar"></i>
                </div>
                <div class="stat-number">&#8358;@Model.TotalAmount.ToString("N0")</div>
                <p class="stat-label">Total @(Model.IsWorker ? "Income" : "Spent")</p>
            </div>

            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
                <div class="stat-number">&#8358;@Model.ThisMonthAmount.ToString("N0")</div>
                <p class="stat-label">This Month</p>
            </div>

            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-calendar-week"></i>
                </div>
                <div class="stat-number">&#8358;@Model.PreviousMonthAmount.ToString("N0")</div>
                <p class="stat-label">Last Month</p>
            </div>

            <div class="stat-card">
                <div class="stat-icon amber">
                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                </div>
                <div class="stat-number">@Model.PaidTransactionCount</div>
                <p class="stat-label">Paid @(Model.IsWorker ? "Jobs" : "Bookings")</p>
            </div>

            <div class="stat-card">
                <div class="stat-icon red">
                    <i class="fa-solid fa-filter-circle-dollar"></i>
                </div>
                <div class="stat-number">&#8358;@Model.AveragePerBooking.ToString("N0")</div>
                <p class="stat-label">Average per @(Model.IsWorker ? "Job" : "Booking")</p>
            </div>

            @if (Model.IsWorker)
            {
                <div class="stat-card">
                    <div class="stat-icon sky">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                    <div class="stat-number">&#8358;@Model.CommissionTotal.ToString("N0")</div>
                    <p class="stat-label">Platform Fees</p>
                </div>
            }
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="dash-card h-100">
                    <div class="card-head d-flex align-items-center justify-content-between">
                        <h4>
                            <i class="fa-solid fa-chart-column me-2"></i>@unitLabel Trends
                        </h4>
                        <span class="text-muted small">Last 6 months</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <div class="fs-4 fw-bold text-success">&#8358;@Model.ThisMonthAmount.ToString("N0") <span class="fs-6 text-muted fw-normal">this month</span></div>
                                <div class="small text-muted">@Model.PaidTransactionCount paid transaction(s) in total</div>
                            </div>
                            <div class="d-flex gap-3 text-muted small">
                                <span><i class="fa-solid fa-circle text-success me-1"></i> Previous</span>
                                <span><i class="fa-solid fa-circle text-info me-1"></i> Current</span>
                            </div>
                        </div>

                        <!-- Visual Bar Chart Graph -->
                        <div class="d-flex align-items-end justify-content-between pt-4 pb-2" style="height: 180px; gap: 12px;">
                            @foreach (var m in Model.MonthlySeries)
                            {
                                var height = m.Percentage <= 0 ? 2 : m.Percentage;
                                <div class="d-flex flex-column align-items-center flex-grow-1 h-100 justify-content-end">
                                    <div class="w-100 rounded-top" style="background: linear-gradient(180deg, @(m.IsCurrent ? "#0ea5e9" : "#10b981") 0%, #059669 100%); height: @(height)%;" title="@m.Month/@m.Year: &#8358;@m.Amount.ToString("N0")"></div>
                                    <span class="small @(m.IsCurrent ? "fw-bold text-success" : "text-muted") mt-2">@m.Label</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Service/Category Breakdown -->
            <div class="col-lg-4">
                <div class="dash-card h-100">
                    <div class="card-head">
                        <h4>
                            <i class="fa-solid fa-chart-pie me-2"></i>By Service
                        </h4>
                    </div>
                    <div class="card-body">
                        @if (Model.CategoryBreakdown.Count == 0)
                        {
                            <div class="empty-state py-4 text-center">
                                <i class="fa-solid fa-chart-pie fs-1 text-muted mb-3"></i>
                                <p class="mb-0 text-muted">No data yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-4">
                                @foreach (var c in Model.CategoryBreakdown)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold">
                                                <i class="fa-solid fa-broom me-1 text-success"></i>@c.Name
                                            </span>
                                            <span class="text-muted small">
                                                @c.Count job(s) &middot; <span class="fw-bold text-success">&#8358;@c.Amount.ToString("N0")</span>
                                            </span>
                                        </div>
                                        <div class="mr-cat-track">
                                            <div class="mr-cat-fill" style="width: @c.Percentage.ToString("N0")%;"></div>
                                        </div>
                                        <div class="text-muted small text-end mt-1">@c.Percentage.ToString("N1")% of total</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Transactions Table -->
        <div class="dash-card">
            <div class="card-head d-flex align-items-center justify-content-between">
                <h4>
                    <i class="fa-solid fa-receipt me-2"></i>Transaction History
                </h4>
                <span class="text-muted small">@Model.Transactions.Count record(s)</span>
            </div>
            <div class="card-body">
                @if (Model.Transactions.Count == 0)
                {
                    <div class="empty-state py-4 text-center">
                        <i class="fa-solid fa-money-bill-wave fs-1 text-muted mb-3"></i>
                        <p class="mb-0 text-muted">No paid transactions yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive mr-table-wrap">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>@(Model.IsWorker ? "Client" : "Worker")</th>
                                    <th>Service</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th class="text-end">@(Model.IsWorker ? "Net Income" : "Amount")</th>
                                    @if (Model.IsWorker)
                                    {
                                        <th class="text-end">Fee</th>
                                        <th class="text-end">Gross</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Transactions.Take(100))
                                {
                                    <tr>
                                        <td class="text-nowrap">@t.Date.ToString("MMM dd, yyyy")</td>
                                        <td>@t.CounterpartyName</td>
                                        <td>@t.ServiceName</td>
                                        <td>
                                            @if (t.BookingStatus == "Completed")
                                            {
                                                <span class="badge rounded-pill text-bg-success">@t.BookingStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill text-bg-info">@t.BookingStatus</span>
                                            }
                                        </td>
                                        <td>
                                            @if (t.PaymentStatus == "Successful")
                                            {
                                                <span class="badge rounded-pill text-bg-success">@t.PaymentStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill text-bg-secondary">@t.PaymentStatus</span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold text-success">&#8358;@t.Amount.ToString("N0")</td>
                                        @if (Model.IsWorker)
                                        {
                                            <td class="text-end text-muted">&#8358;@t.Fee.ToString("N0")</td>
                                            <td class="text-end text-muted">&#8358;@t.GrossAmount.ToString("N0")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
