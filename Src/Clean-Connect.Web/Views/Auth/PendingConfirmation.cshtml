
@model string
@{
    ViewData["Title"] = "Verify Your Email";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-right w-100 min-vh-100 d-flex align-items-center justify-content-center py-5">

    <div class="login-card shadow-lg text-center" data-aos="fade-up">

        <div class="pending-icon mb-3">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <h2 class="fw-bold">Verify Your Email</h2>

        <p class="mb-4 text-muted">
            We've sent a verification link to <strong class="text-success">@Model</strong>.<br />
            Please check your inbox and click the confirmation link to activate your Clean Connect account.
        </p>

        <div class="alert alert-light border text-start">
            <strong class="d-block mb-2 text-dark"><i class="fa-solid fa-circle-info text-primary me-2"></i>Didn't receive the email?</strong>
            <div class="small text-muted">
                • Check your Spam or Junk folder<br />
                • Make sure your email address was typed correctly<br />
                • Wait a few minutes before requesting a new link
            </div>
        </div>

        <div class="d-grid gap-3 mt-4">

            <form asp-action="ResendConfirmationEmail"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="email"
                       value="@Model" />

                <button type="submit"
                        class="btn btn-success login-btn w-100 py-3">
                    <i class="fa-solid fa-paper-plane me-2"></i>
                    Resend Verification Email
                </button>
            </form>

            <a asp-action="Login"
               asp-controller="Auth"
               class="btn btn-outline-secondary w-100 py-3 rounded-3">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Login
            </a>

        </div>

    </div>

</div>