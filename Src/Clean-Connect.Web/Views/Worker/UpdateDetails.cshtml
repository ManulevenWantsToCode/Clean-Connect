@model Clean_Connect.Application.Command.WorkerCommands.UpdateWorkerCommand

@{
    ViewData["Title"] = "Update Profile";
    Layout = "_DashboardLayout";
}

<div class="dash-page">
    <div class="container py-4">

        <!-- Page Header -->
        <div class="profile-edit-header mb-5">
            <div class="profile-edit-header__inner">
                <a asp-action="Dashboard" class="profile-back-link">
                    <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
                </a>
                <div class="mt-3">
                    <h1 class="profile-edit-title">
                        <span class="profile-edit-title__icon"><i class="fa-solid fa-user-pen"></i></span>
                        Edit Worker Profile
                    </h1>
                    <p class="profile-edit-subtitle">Keep your information accurate to attract more clients and jobs.</p>
                </div>
            </div>
            <span class="profile-role-badge worker">
                <i class="fa-solid fa-hard-hat me-1"></i> Worker
            </span>
        </div>

        <form asp-action="UpdateDetails" asp-controller="Worker" method="post" id="updateWorkerForm">
            @Html.AntiForgeryToken()
            <input asp-for="WorkerId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-4"></div>

            <div class="profile-edit-layout">

                <!-- LEFT SIDEBAR -->
                <aside class="profile-edit-sidebar">

                    <!-- Avatar / Identity Card -->
                    <div class="profile-id-card">
                        <div class="profile-avatar-wrap">
                            <div class="profile-avatar">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="profile-avatar-ring"></div>
                        </div>
                        <div class="profile-id-name">@Model.FirstName @Model.LastName</div>
                        <div class="profile-id-role">Cleaning Professional</div>
                        <div class="profile-id-divider"></div>
                        <div class="profile-id-stat">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="text-truncate">@Model.Email</span>
                        </div>
                        <div class="profile-id-stat">
                            <i class="fa-solid fa-phone"></i>
                            <span>@(string.IsNullOrEmpty(Model.Contact) ? "Not set" : Model.Contact)</span>
                        </div>
                        <div class="profile-id-stat">
                            <i class="fa-solid fa-map-pin"></i>
                            <span>@(string.IsNullOrEmpty(Model.State) ? "No location" : Model.State)</span>
                        </div>
                    </div>

                    <!-- Tips Card -->
                    <div class="profile-tips-card">
                        <div class="profile-tips-card__header">
                            <i class="fa-solid fa-lightbulb"></i> Pro Tips
                        </div>
                        <ul class="profile-tips-list">
                            <li>Keep your phone number up to date so clients can reach you.</li>
                            <li>An accurate address helps match you with nearby bookings.</li>
                            <li>Detecting your GPS location improves job matching accuracy.</li>
                        </ul>
                    </div>

                </aside>

                <!-- RIGHT FORM PANEL -->
                <div class="profile-edit-main">

                    <!-- PERSONAL INFORMATION CARD -->
                    <div class="dash-card mb-4">
                        <div class="card-head">
                            <h4>
                                <i class="fa-solid fa-user text-success me-2"></i>
                                Personal Information
                            </h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <!-- First Name -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                                            <label asp-for="FirstName"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="FirstName" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Last Name -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                                            <label asp-for="LastName"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="LastName" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="Email" class="form-control" placeholder="Email Address" />
                                            <label asp-for="Email"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Contact -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="Contact" class="form-control" placeholder="Phone Number" />
                                            <label asp-for="Contact"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Contact" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Gender -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-venus-mars"></i></span>
                                        <div class="form-floating">
                                            <select asp-for="Gender" class="form-select">
                                                <option value=""></option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                            <label asp-for="Gender"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Gender" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Date Of Birth -->
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-calendar-days"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                                            <label asp-for="DateOfBirth"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <!-- Service Type -->
                                <div class="col-md-12">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-broom"></i></span>
                                        <div class="form-floating">
                                            <select asp-for="ServiceTypeId" asp-items="ViewBag.ServiceType" class="form-select">
                                                <option value="">Select Service Type</option>
                                            </select>
                                            <label asp-for="ServiceTypeId"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="ServiceTypeId" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LOCATION CARD -->
                    <div class="dash-card mb-4">
                        <div class="card-head">
                            <h4>
                                <i class="fa-solid fa-location-dot text-success me-2"></i>
                                Location Information
                            </h4>
                        </div>
                        <div class="card-body">

                            <!-- GPS Detection Banner -->
                            <div class="location-detect-banner mb-4">
                                <div class="location-detect-banner__icon">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </div>
                                <div class="location-detect-banner__text">
                                    <strong>Auto-detect your location</strong>
                                    <span>Tap the button to fill your coordinates and state automatically.</span>
                                </div>
                                <button type="button" id="detectLocationBtn" class="btn btn-success btn-location px-4">
                                    <i class="fa-solid fa-location-crosshairs me-2"></i>Detect Location
                                </button>
                            </div>

                            <!-- Input Fields -->
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-map"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="State" id="state" class="form-control" placeholder="State" />
                                            <label asp-for="State"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="State" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-house"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="Address" class="form-control" placeholder="Address" />
                                            <label asp-for="Address"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Address" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="Latitude" id="latitude" class="form-control" readonly />
                                            <label asp-for="Latitude"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Latitude" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="input-group custom-input">
                                        <span class="input-group-text"><i class="fa-solid fa-location-crosshairs"></i></span>
                                        <div class="form-floating">
                                            <input asp-for="Longitude" id="longitude" class="form-control" readonly />
                                            <label asp-for="Longitude"></label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Longitude" class="text-danger small ms-2 mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Location Preview Chips -->
                            <div class="location-chips mb-4">
                                <div class="location-chip">
                                    <i class="fa-solid fa-map text-success"></i>
                                    <div>
                                        <div class="location-chip__label">State</div>
                                        <div class="location-chip__value" id="statePreview">Not Detected</div>
                                    </div>
                                </div>
                                <div class="location-chip">
                                    <i class="fa-solid fa-location-dot text-danger"></i>
                                    <div>
                                        <div class="location-chip__label">Latitude</div>
                                        <div class="location-chip__value" id="latPreview">---</div>
                                    </div>
                                </div>
                                <div class="location-chip">
                                    <i class="fa-solid fa-location-crosshairs" style="color:#3b82f6;"></i>
                                    <div>
                                        <div class="location-chip__label">Longitude</div>
                                        <div class="location-chip__value" id="lngPreview">---</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Map -->
                            <iframe id="mapFrame" width="100%" height="300" style="border:0;border-radius:16px;" loading="lazy"></iframe>
                        </div>
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex justify-content-end gap-3 mt-2 mb-5">
                        <a asp-action="Dashboard" class="btn btn-lg btn-outline-secondary px-4 rounded-pill">
                            <i class="fa-solid fa-xmark me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill">
                            <i class="fa-solid fa-save me-2"></i>Save Changes
                        </button>
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const detectLocationBtn = document.getElementById("detectLocationBtn");
            const latitudeInput = document.getElementById("latitude");
            const longitudeInput = document.getElementById("longitude");
            const stateInput = document.getElementById("state");
            const latPreview = document.getElementById("latPreview");
            const lngPreview = document.getElementById("lngPreview");
            const statePreview = document.getElementById("statePreview");
            const mapFrame = document.getElementById("mapFrame");

            function showToast(message, type) {
                let toast = document.getElementById("locationToast");
                if (!toast) {
                    toast = document.createElement("div");
                    toast.id = "locationToast";
                    toast.style.cssText = "position:fixed;top:30px;right:30px;z-index:99999;padding:15px 20px;border-radius:12px;color:#fff;font-weight:600;min-width:280px;box-shadow:0 10px 30px rgba(0,0,0,.15);transition:.35s;opacity:0;";
                    document.body.appendChild(toast);
                }
                var bg = "#0ea5e9";
                switch (type) {
                    case "success": bg = "#10b981"; break;
                    case "danger": bg = "#ef4444"; break;
                    case "warning": bg = "#f59e0b"; break;
                }
                toast.style.background = bg;
                toast.innerHTML = message;
                toast.style.opacity = "1";
                setTimeout(function () { toast.style.opacity = "0"; }, 3000);
            }

            function updatePreviews(lat, lng, state) {
                if (latPreview) latPreview.innerText = lat;
                if (lngPreview) lngPreview.innerText = lng;
                if (statePreview) statePreview.innerText = state || "Not Detected";
            }

            if (detectLocationBtn) {
                detectLocationBtn.addEventListener("click", function () {
                    if (!navigator.geolocation) {
                        showToast("Geolocation is not supported by your browser.", "danger");
                        return;
                    }
                    detectLocationBtn.disabled = true;
                    detectLocationBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Detecting...';

                    navigator.geolocation.getCurrentPosition(
                        async function (position) {
                            var lat = position.coords.latitude.toFixed(6);
                            var lng = position.coords.longitude.toFixed(6);
                            latitudeInput.value = lat;
                            longitudeInput.value = lng;
                            if (mapFrame) mapFrame.src = "https://maps.google.com/maps?q=" + lat + "," + lng + "&z=15&output=embed";
                            try {
                                var response = await fetch("https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=" + lat + "&lon=" + lng);
                                var result = await response.json();
                                var state = "";
                                if (result.address) {
                                    state = result.address.state || result.address.county || result.address.city || "";
                                }
                                stateInput.value = state;
                                updatePreviews(lat, lng, state);
                            } catch {
                                updatePreviews(lat, lng, "Unable to detect state");
                            }
                            detectLocationBtn.classList.add("btn-success");
                            detectLocationBtn.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i>Location Detected';
                            detectLocationBtn.disabled = false;
                            showToast("Location detected successfully.", "success");
                        },
                        function (error) {
                            detectLocationBtn.disabled = false;
                            detectLocationBtn.innerHTML = '<i class="fa-solid fa-location-crosshairs me-2"></i>Detect Location';
                            var msg = "Unable to retrieve location.";
                            switch (error.code) {
                                case error.PERMISSION_DENIED: msg = "Location permission denied."; break;
                                case error.POSITION_UNAVAILABLE: msg = "Location unavailable."; break;
                                case error.TIMEOUT: msg = "Location request timed out."; break;
                            }
                            showToast(msg, error.code === error.PERMISSION_DENIED ? "danger" : "warning");
                        },
                        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                    );
                });
            }

            function initPreview() {
                if (latitudeInput && latPreview) latPreview.innerText = latitudeInput.value || "---";
                if (longitudeInput && lngPreview) lngPreview.innerText = longitudeInput.value || "---";
                if (stateInput && statePreview) statePreview.innerText = stateInput.value || "Not Detected";
                if (latitudeInput && longitudeInput && latitudeInput.value && longitudeInput.value && mapFrame) {
                    mapFrame.src = "https://maps.google.com/maps?q=" + latitudeInput.value + "," + longitudeInput.value + "&z=15&output=embed";
                }
            }

            if (stateInput) {
                stateInput.addEventListener("keyup", function () {
                    if (statePreview) statePreview.innerText = stateInput.value || "Not Detected";
                });
            }

            initPreview();
        });
    </script>
}
