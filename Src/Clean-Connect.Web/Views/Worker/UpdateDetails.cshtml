@model Clean_Connect.Application.Command.WorkerCommands.UpdateWorkerCommand

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_DashboardLayout";
    var completedSections = new[]
    {
        !string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName) && !string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Contact) && !string.IsNullOrWhiteSpace(Model.Gender) && Model.DateOfBirth != default,
        Model.ServiceTypeId != Guid.Empty,
        Model.HourlyRate > 0,
        !string.IsNullOrWhiteSpace(Model.State) && !string.IsNullOrWhiteSpace(Model.Address)
    }.Count(done => done);
    var profileProgress = completedSections * 25;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
}

<main class="dash-page worker-profile-workspace">
    <div class="worker-profile-workspace__grid">
        <aside class="worker-profile-nav" aria-label="Worker account navigation">
            <span class="worker-profile-nav__label">Account</span>
            <a asp-controller="Worker" asp-action="Dashboard"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i>Dashboard</a>
            <span class="worker-profile-nav__label">Profile</span>
            <a asp-controller="Worker" asp-action="UpdateDetails" class="is-current" aria-current="page"><i class="fa-solid fa-user-pen" aria-hidden="true"></i>Edit profile</a>
            <a asp-controller="Worker" asp-action="PayoutDetails"><i class="fa-solid fa-building-columns" aria-hidden="true"></i>Payout details</a>
            <a asp-controller="Notifications" asp-action="Index"><i class="fa-regular fa-bell" aria-hidden="true"></i>Notifications</a>
        </aside>

        <div class="worker-profile-workspace__main">
            <header class="worker-profile-workspace__header">
                <div><span>Worker account</span><h1>Edit profile</h1><p>Keep your information current so clients can find and contact you.</p></div>
                <a asp-controller="Worker" asp-action="Dashboard" class="worker-profile-workspace__mobile-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Dashboard</a>
            </header>

            @if (profileProgress < 100)
            {
                <aside class="worker-profile-completion" aria-label="Profile completion">
                    <h2>Complete your profile</h2>
                    <div class="worker-profile-completion__meter" role="img" aria-label="Profile is @profileProgress percent complete" style="--profile-progress: @profileProgress%"><span>@profileProgress<small>%</small></span></div>
                    <ul>
                        <li class="@(completedSections > 0 ? "is-complete" : "")"><i class="fa-solid @(completedSections > 0 ? "fa-check" : "fa-xmark")" aria-hidden="true"></i><span>Personal information</span></li>
                        <li class="@(Model.ServiceTypeId != Guid.Empty ? "is-complete" : "")"><i class="fa-solid @(Model.ServiceTypeId != Guid.Empty ? "fa-check" : "fa-xmark")" aria-hidden="true"></i><span>Service category</span></li>
                        <li class="@(Model.HourlyRate > 0 ? "is-complete" : "")"><i class="fa-solid @(Model.HourlyRate > 0 ? "fa-check" : "fa-xmark")" aria-hidden="true"></i><span>Hourly rate</span></li>
                        <li class="@(!string.IsNullOrWhiteSpace(Model.State) && !string.IsNullOrWhiteSpace(Model.Address) ? "is-complete" : "")"><i class="fa-solid @(!string.IsNullOrWhiteSpace(Model.State) && !string.IsNullOrWhiteSpace(Model.Address) ? "fa-check" : "fa-xmark")" aria-hidden="true"></i><span>Work location</span></li>
                    </ul>
                </aside>
            }

            <form asp-action="UpdateDetails" asp-controller="Worker" method="post" id="updateWorkerForm" aria-busy="false">
                @Html.AntiForgeryToken()
                <input asp-for="WorkerId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <section class="worker-profile-photo" aria-labelledby="worker-photo-heading">
                    <div class="worker-profile-photo__preview" aria-hidden="true"><i class="fa-solid fa-user-tie"></i></div>
                    <div class="worker-profile-photo__copy">
                        <h2 id="worker-photo-heading">Profile photo</h2>
                        <strong>@Model.FirstName @Model.LastName</strong>
                        <p>Your photo and profile details are shown to clients when they view your worker profile.</p>
                    </div>
                </section>

                <section class="worker-profile-section" aria-labelledby="worker-personal-heading">
                    <div class="worker-profile-section__head"><h2 id="worker-personal-heading">Personal information</h2><p>Contact details and basic information.</p></div>
                    <div class="worker-profile-fields worker-profile-fields--three">
                        <div class="worker-profile-field"><label asp-for="FirstName">First name</label><input asp-for="FirstName" class="form-control" placeholder="Enter first name" autocomplete="given-name" maxlength="50" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="LastName">Last name</label><input asp-for="LastName" class="form-control" placeholder="Enter last name" autocomplete="family-name" maxlength="50" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Email">Email address</label><input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" autocomplete="email" maxlength="100" /><span asp-validation-for="Email" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Contact">Phone number</label><input asp-for="Contact" type="tel" class="form-control" placeholder="0803 555 0142" autocomplete="tel" inputmode="tel" minlength="11" maxlength="15" /><span asp-validation-for="Contact" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Gender"></label><select asp-for="Gender" class="form-select"><option value="">Select gender</option><option value="Male">Male</option><option value="Female">Female</option></select><span asp-validation-for="Gender" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="DateOfBirth">Date of birth</label><input asp-for="DateOfBirth" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="DateOfBirth" class="text-danger"></span></div>
                    </div>
                </section>

                <section class="worker-profile-section" aria-labelledby="worker-service-heading">
                    <div class="worker-profile-section__head"><h2 id="worker-service-heading">Service and rate</h2><p>Tell clients what work you take on.</p></div>
                    <div class="worker-profile-fields worker-profile-fields--service">
                        <div class="worker-profile-field"><label asp-for="ServiceTypeId">Service type</label><select asp-for="ServiceTypeId" asp-items="ViewBag.ServiceType" class="form-select"><option value="">Select service type</option></select><span asp-validation-for="ServiceTypeId" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="HourlyRate">Hourly rate (₦/hr)</label><div class="worker-profile-rate"><span aria-hidden="true">₦</span><input asp-for="HourlyRate" type="number" min="1" max="1000000" step="0.01" class="form-control" /></div><span asp-validation-for="HourlyRate" class="text-danger"></span></div>
                    </div>
                </section>

                <section class="worker-profile-section" aria-labelledby="worker-location-heading">
                    <div class="worker-profile-section__head"><h2 id="worker-location-heading">Work location</h2><p>Used to match your services with nearby clients.</p></div>
                    <div class="location-detect-banner">
                        <div class="location-detect-banner__icon"><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i></div>
                        <div class="location-detect-banner__text">
                            <strong>Automatic location detection</strong>
                            <span>We'll retrieve your browser coordinates to match you with nearby clients.</span>
                        </div>
                        <button type="button" id="detectLocationBtn" class="btn btn-outline-success"><i class="fa-solid fa-location-crosshairs me-2" aria-hidden="true"></i>Detect My Location</button>
                    </div>
                    <div id="profileLocationMap" class="worker-profile-map__canvas" role="application" aria-label="Select your location by clicking the map or dragging the marker"></div>
                    <p id="locationStatus" class="worker-profile-location-status" role="status" aria-live="polite">Click the map or move the marker to choose your location.</p>
                    <div class="worker-profile-fields">
                        <div class="worker-profile-field"><label asp-for="State">State</label><input asp-for="State" id="state" class="form-control" placeholder="e.g. Lagos" autocomplete="address-level1" maxlength="20" /><span asp-validation-for="State" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Address">Address</label><input asp-for="Address" class="form-control" placeholder="Street, area, city" autocomplete="street-address" minlength="10" maxlength="200" /><span asp-validation-for="Address" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Latitude">Latitude</label><input asp-for="Latitude" id="latitude" class="form-control" readonly /><span asp-validation-for="Latitude" class="text-danger"></span></div>
                        <div class="worker-profile-field"><label asp-for="Longitude">Longitude</label><input asp-for="Longitude" id="longitude" class="form-control" readonly /><span asp-validation-for="Longitude" class="text-danger"></span></div>
                    </div>
                </section>

                <footer class="worker-profile-actions"><a asp-controller="Worker" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a><button type="submit" id="saveWorkerProfile" class="btn btn-success"><i class="fa-solid fa-check me-2" aria-hidden="true"></i>Save changes</button></footer>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("updateWorkerForm");
            const saveButton = document.getElementById("saveWorkerProfile");
            const detectButton = document.getElementById("detectLocationBtn");
            const latitude = document.getElementById("latitude");
            const longitude = document.getElementById("longitude");
            const state = document.getElementById("state");
            const address = document.getElementById("Address");
            const mapElement = document.getElementById("profileLocationMap");
            const status = document.getElementById("locationStatus");

            let locationMap;
            let locationMarker;
            let reverseGeocodeTimer;

            function parseCoordinate(value) {
                if (value === null || value === undefined || String(value).trim() === "") return null;
                const parsed = Number(value);
                return Number.isFinite(parsed) ? parsed : null;
            }

            function setMapPosition(lat, lng) {
                const resolvedLat = Number(lat);
                const resolvedLng = Number(lng);
                if (!locationMap || !locationMarker || !Number.isFinite(resolvedLat) || !Number.isFinite(resolvedLng)) return;
                const point = [resolvedLat, resolvedLng];
                locationMarker.setLatLng(point);
                locationMap.setView(point, Math.max(locationMap.getZoom(), 14));
            }

            function setPickedLocation(lat, lng) {
                const resolvedLat = Number(lat);
                const resolvedLng = Number(lng);
                if (!Number.isFinite(resolvedLat) || !Number.isFinite(resolvedLng)) return;
                latitude.value = resolvedLat.toFixed(6);
                longitude.value = resolvedLng.toFixed(6);
                setMapPosition(resolvedLat, resolvedLng);
                status.textContent = "Updating address...";
                clearTimeout(reverseGeocodeTimer);
                reverseGeocodeTimer = setTimeout(async function () {
                    const resolved = await fillLocationDetails(true);
                    status.textContent = resolved
                        ? "Location updated from the map. Save your changes to keep it."
                        : "Coordinates updated. Address lookup is unavailable.";
                }, 350);
            }
            form.addEventListener("submit", function () {
                const validator = window.jQuery && window.jQuery(form).data("validator");
                if (validator && !window.jQuery(form).valid()) return;
                if (!form.checkValidity()) return;
                form.setAttribute("aria-busy", "true");
                saveButton.disabled = true;
                saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving changes…';
            });
            const hasSavedCoordinates = function () {
                const lat = parseCoordinate(latitude.value);
                const lng = parseCoordinate(longitude.value);
                return lat !== null && lng !== null && (lat !== 0 || lng !== 0);
            };

            let detectingLocation = false;

            function resetDetectButton() {
                detectButton.disabled = false;
                detectButton.innerHTML = '<i class="fa-solid fa-location-crosshairs me-2" aria-hidden="true"></i>Detect My Location';
            }

            async function fillLocationDetails(overwriteExisting) {
                try {
                    const response = await fetch("https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=" + latitude.value + "&lon=" + longitude.value);
                    if (!response.ok) throw new Error("Reverse geocoding failed");
                    const result = await response.json();
                    const detectedState = result.address?.state || result.address?.county || result.address?.city;
                    if (detectedState && (overwriteExisting || !state.value.trim())) state.value = detectedState;
                    if (result.display_name && address && (overwriteExisting || !address.value.trim())) {
                        address.value = result.display_name.slice(0, 200);
                    }
                    return true;
                } catch {
                    return false;
                }
            }

            if (window.L && mapElement) {
                const initialLat = parseCoordinate(latitude.value);
                const initialLng = parseCoordinate(longitude.value);
                const hasInitialCoordinates = initialLat !== null && initialLng !== null && (initialLat !== 0 || initialLng !== 0);
                const initialPoint = hasInitialCoordinates ? [initialLat, initialLng] : [6.5244, 3.3792];

                locationMap = L.map(mapElement).setView(initialPoint, hasInitialCoordinates ? 14 : 11);
                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
                }).addTo(locationMap);
                locationMarker = L.marker(initialPoint, { draggable: true }).addTo(locationMap);

                locationMap.on("click", function (event) {
                    setPickedLocation(event.latlng.lat, event.latlng.lng);
                });
                locationMarker.on("dragend", function (event) {
                    const point = event.target.getLatLng();
                    setPickedLocation(point.lat, point.lng);
                });
                setTimeout(function () { locationMap.invalidateSize(); }, 0);
            }

            function detectLocation(automatic) {
                if (detectingLocation) return;
                if (!navigator.geolocation) {
                    if (!automatic) status.textContent = "Geolocation is not supported by your browser.";
                    return;
                }

                detectingLocation = true;
                detectButton.disabled = true;
                detectButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Detecting location...';
                status.textContent = automatic ? "Detecting your current location..." : "Requesting your current location...";

                navigator.geolocation.getCurrentPosition(async function (position) {
                    const detectedLat = position.coords.latitude;
                    const detectedLng = position.coords.longitude;
                    latitude.value = detectedLat.toFixed(6);
                    longitude.value = detectedLng.toFixed(6);
                    setMapPosition(detectedLat, detectedLng);
                    await fillLocationDetails(!automatic);
                    detectingLocation = false;
                    detectButton.disabled = false;
                    detectButton.innerHTML = '<i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>Location detected';
                    status.textContent = "Location detected. Check the state and address before saving.";
                }, function (error) {
                    detectingLocation = false;
                    resetDetectButton();
                    if (error.code === error.PERMISSION_DENIED) {
                        status.textContent = automatic
                            ? "Location permission was denied. Enter your location manually."
                            : "Location permission was denied.";
                    } else if (error.code === error.TIMEOUT) {
                        status.textContent = automatic
                            ? "Automatic location detection timed out. Retry or enter your location manually."
                            : "Location request timed out.";
                    } else {
                        status.textContent = automatic
                            ? "We couldn't detect your location. Enter it manually or retry."
                            : "Unable to retrieve your location.";
                    }
                }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
            }

            detectButton.addEventListener("click", function () { detectLocation(false); });

            if (!hasSavedCoordinates()) {
                detectLocation(true);
            }
        });
    </script>
}
