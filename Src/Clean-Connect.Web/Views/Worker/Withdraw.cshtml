@model Clean_Connect.Web.Models.WithdrawViewModel

@{
    ViewData["Title"] = "Withdraw Funds";
    Layout = "_DashboardLayout";
}

<div class="dash-page">
    <div class="container">

        <!-- Header -->
        <div class="dash-header d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <div class="dash-eyebrow mb-1">
                    <i class="fa-solid fa-money-bill-transfer me-2"></i>Wallet
                </div>
                <h1>Withdraw Funds</h1>
                <p>Transfer from your wallet balance to your bank account.</p>
            </div>
            <a href="@Url.Action("Dashboard", "Worker")" class="dash-back-link">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>

        <!-- Wallet Balance Banner -->
        <div class="wallet-banner mb-5">
            <div class="wallet-banner__left">
                <div class="wallet-banner__icon">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <div>
                    <div class="wallet-banner__label">Available Balance</div>
                    <div class="wallet-banner__amount">&#8358;@Model.WalletBalance.ToString("N0")</div>
                </div>
            </div>
            <div class="wallet-banner__right">
                <span class="wallet-banner__hint">Withdrawable amount</span>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="dash-card">
                    <div class="card-head">
                        <h4>
                            <i class="fa-solid fa-building-columns"></i>
                            Bank Transfer Details
                        </h4>
                    </div>
                    <div class="card-body">
                        <form asp-action="Withdraw" asp-controller="Worker" method="post">
                            @Html.AntiForgeryToken()

                            @{
                                var modelErrors = ViewData.ModelState.Values
                                    .SelectMany(v => v.Errors)
                                    .Where(e => !string.IsNullOrWhiteSpace(e.ErrorMessage))
                                    .ToList();
                            }

                            @if (modelErrors.Count > 0)
                            {
                                <div class="alert alert-danger mb-3" role="alert">
                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                                    <strong>Withdrawal failed:</strong>
                                    <ul class="mb-0 mt-1">
                                        @foreach (var e in modelErrors)
                                        {
                                            <li>@e.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <div class="mb-3">
                                <label asp-for="Amount" class="form-label fw-semibold">Amount (NGN)</label>
                                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                                <div class="form-text">Cannot exceed your available balance of &#8358;@Model.WalletBalance.ToString("N0").</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="BankCode" class="form-label fw-semibold">Bank</label>
                                <select asp-for="BankCode" asp-items="@(ViewBag.Banks as SelectList)" class="form-select">
                                    <option value="">-- Select Bank --</option>
                                </select>
                                <span asp-validation-for="BankCode" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AccountNumber" class="form-label fw-semibold">Account Number</label>
                                <input asp-for="AccountNumber" class="form-control" placeholder="0123456789" />
                                <span asp-validation-for="AccountNumber" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="AccountName" class="form-label fw-semibold">Account Name</label>
                                <input asp-for="AccountName" class="form-control" placeholder="Full name on the account" />
                                <span asp-validation-for="AccountName" class="text-danger"></span>
                            </div>

                            <input type="hidden" asp-for="Currency" />

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                                    <i class="fa-solid fa-money-bill-transfer me-2"></i>Withdraw Now
                                </button>
                                <a href="@Url.Action("Dashboard", "Worker")" class="btn btn-outline-secondary btn-lg">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
