@model Clean_Connect.Application.DTO.WorkerDashboardDto

@{
    ViewData["Title"] = "Worker Dashboard";
    Layout = "_DashboardLayout";

    var workerName = string.IsNullOrWhiteSpace(Model.WorkerName) ? "Worker" : Model.WorkerName;
    var firstName = workerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Worker";
    var totalRatingCount = Model.OneStarCount + Model.TwoStarCount + Model.ThreeStarCount + Model.FourStarCount + Model.FiveStarCount;
}

<div class="cc-dashboard cc-dashboard--worker">
    <div class="cc-dashboard-shell">
        <aside class="cc-rail" aria-label="Worker dashboard navigation">
            <a class="cc-rail__brand" asp-controller="Home" asp-action="Index" aria-label="Clean Connect home">
                <span class="cc-rail__logo"><i class="fa-solid fa-broom"></i></span>
                <span>
                    <strong>Clean Connect</strong>
                    <small>Worker workspace</small>
                </span>
            </a>

            <nav class="cc-rail__nav">
                <a class="cc-rail__link is-active" asp-controller="Worker" asp-action="Dashboard">
                    <i class="fa-solid fa-table-cells-large"></i>
                    <span>Overview</span>
                </a>
                <a class="cc-rail__link" asp-controller="Booking" asp-action="Responses">
                    <i class="fa-solid fa-inbox"></i>
                    <span>Requests</span>
                </a>
                <a class="cc-rail__link" href="/Payout-Details">
                    <i class="fa-solid fa-bank"></i>
                    <span>Payout details</span>
                </a>
                <a class="cc-rail__link" asp-controller="Notifications" asp-action="Index">
                    <i class="fa-solid fa-bell"></i>
                    <span>Updates</span>
                </a>
                <a class="cc-rail__link" href="/Update-Worker-Details">
                    <i class="fa-solid fa-user-gear"></i>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="cc-rail__panel">
                <span class="cc-rail__panel-label">Availability</span>
                <strong>@(Model.IsAvailable ? "Available" : "Unavailable")</strong>
                <small>@Model.PendingBookings pending request@(Model.PendingBookings == 1 ? "" : "s")</small>
            </div>
        </aside>

        <main class="cc-main">
            <section class="cc-hero" aria-labelledby="worker-dashboard-title">
                <div class="cc-hero__content">
                    <span class="cc-kicker">
                        <i class="fa-solid fa-spray-can-sparkles"></i>
                        Worker dashboard
                    </span>
                    <h1 id="worker-dashboard-title">Good to see you, @firstName</h1>
                    <p>
                        Track booking requests, keep your payout details up to date, and keep your cleaning business moving with less admin.
                    </p>

                    <div class="cc-hero__meta">
                        @if (!string.IsNullOrWhiteSpace(Model.ServiceType))
                        {
                            <span><i class="fa-solid fa-broom"></i>@Model.ServiceType</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.State))
                        {
                            <span><i class="fa-solid fa-location-dot"></i>@Model.State</span>
                        }
                        <span><i class="fa-solid @(Model.IsAvailable ? "fa-circle-check" : "fa-circle-pause")"></i>@(Model.IsAvailable ? "Available for jobs" : "Unavailable for jobs")</span>
                    </div>
                </div>

                <div class="cc-hero__actions">
                    <a asp-controller="Booking" asp-action="Responses" class="cc-btn cc-btn--primary">
                        <i class="fa-solid fa-inbox"></i>
                        Review requests
                    </a>
                    <a href="/Update-Worker-Details" class="cc-btn cc-btn--soft">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Edit profile
                    </a>
                </div>
            </section>

            <section class="cc-wallet-strip" aria-label="Payout summary">
                <div>
                    <span>Payout account</span>
                    <strong>@(Model.HasBankDetails ? Model.PayoutAccount : "Not set yet")</strong>
                </div>
                <div>
                    <span>Total earnings</span>
                    <strong>&#8358;@Model.TotalEarnings.ToString("N0")</strong>
                </div>
                <div>
                    <span>Pending payouts</span>
                    <strong>@Model.PendingPayouts</strong>
                </div>
                <a href="/Payout-Details" class="cc-btn cc-btn--light">
                    <i class="fa-solid fa-bank"></i>
                    @(Model.HasBankDetails ? "Update payout details" : "Add payout details")
                </a>
            </section>

            <section class="cc-metric-grid" aria-label="Worker dashboard summary">
                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-green"><i class="fa-solid fa-briefcase"></i></span>
                    <span class="cc-metric__label">Completed jobs</span>
                    <strong>@Model.TotalJobs</strong>
                    <small>Finished and confirmed</small>
                </article>

                <article class="cc-metric cc-metric--attention">
                    <span class="cc-metric__icon cc-tone-blue"><i class="fa-solid fa-calendar-check"></i></span>
                    <span class="cc-metric__label">Active bookings</span>
                    <strong>@Model.ActiveBookings</strong>
                    <small>Accepted or in progress</small>
                </article>

                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-amber"><i class="fa-solid fa-star"></i></span>
                    <span class="cc-metric__label">Average rating</span>
                    <strong>@Model.AverageRating.ToString("F1")</strong>
                    <small>@Model.TotalRating review@(Model.TotalRating == 1 ? "" : "s")</small>
                </article>

                <article class="cc-metric">
                    <span class="cc-metric__icon cc-tone-teal"><i class="fa-solid fa-chart-pie"></i></span>
                    <span class="cc-metric__label">Earnings</span>
                    <strong>&#8358;@Model.TotalEarnings.ToString("N0")</strong>
                    <a href="/Money-Review">Review breakdown</a>
                </article>
            </section>

            <section class="cc-content-grid">
                <article class="cc-panel cc-panel--wide">
                    <div class="cc-panel__head">
                        <div>
                            <span class="cc-section-label">Latest work</span>
                            <h2>Recent bookings</h2>
                        </div>
                        <a asp-controller="Booking" asp-action="Responses" class="cc-link-button">
                            View all
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>

                    @if (Model.RecentBookings == null || Model.RecentBookings.Count == 0)
                    {
                        <div class="cc-empty">
                            <span class="cc-empty__icon"><i class="fa-solid fa-calendar-xmark"></i></span>
                            <h3>No booking requests yet</h3>
                            <p>New client requests will land here once clients book your service type in your area.</p>
                            <a href="/Update-Worker-Details" class="cc-btn cc-btn--primary">
                                <i class="fa-solid fa-user-gear"></i>
                                Check profile details
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="cc-booking-list">
                            @foreach (var booking in Model.RecentBookings)
                            {
                                var bookingStatus = (booking.BookingStatus ?? "").ToLower().Replace(" ", "");
                                var clientInitial = string.IsNullOrWhiteSpace(booking.ClientName) ? "C" : booking.ClientName.Substring(0, 1).ToUpper();

                                <article class="cc-booking-row" onclick="window.location.href='/Worker-Booking-Details/@booking.BookingId'">
                                    <div class="cc-avatar" aria-hidden="true">@clientInitial</div>
                                    <div class="cc-booking-row__main">
                                        <strong>@booking.ClientName</strong>
                                        <span>@booking.ServiceName</span>
                                        <small><i class="fa-solid fa-location-dot"></i>@booking.Address</small>
                                    </div>
                                    <div class="cc-booking-row__date">
                                        <strong>@booking.DateOfService.ToString("MMM dd")</strong>
                                        <span>@booking.TimeRange</span>
                                    </div>
                                    <div class="cc-booking-row__status">
                                        <span class="cc-status cc-status--@bookingStatus">@booking.BookingStatus</span>
                                    </div>
                                    <span class="cc-icon-button" aria-hidden="true">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </span>
                                </article>
                            }
                        </div>
                    }
                </article>

                <aside class="cc-stack">
                    <article class="cc-panel">
                        <div class="cc-panel__head">
                            <div>
                                <span class="cc-section-label">Shortcuts</span>
                                <h2>Quick actions</h2>
                            </div>
                        </div>

                        <div class="cc-action-list">
                            <a asp-controller="Booking" asp-action="Responses" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-green"><i class="fa-solid fa-broom"></i></span>
                                <span><strong>Booking requests</strong><small>Accept or decline jobs</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="/Payout-Details" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-teal"><i class="fa-solid fa-bank"></i></span>
                                <span><strong>Payout bank details</strong><small>Receive transfers after each job</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a asp-controller="Notifications" asp-action="Index" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-amber"><i class="fa-solid fa-bell"></i></span>
                                <span><strong>Notifications</strong><small>Booking and payment updates</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="/Update-Worker-Details" class="cc-action-link">
                                <span class="cc-action-link__icon cc-tone-violet"><i class="fa-solid fa-pen-to-square"></i></span>
                                <span><strong>Edit profile</strong><small>Service, contact, location</small></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>

                    <article class="cc-panel">
                        <div class="cc-panel__head">
                            <div>
                                <span class="cc-section-label">Reputation</span>
                                <h2>Rating overview</h2>
                            </div>
                            <span class="cc-rating-pill">
                                <i class="fa-solid fa-star"></i>
                                @Model.AverageRating.ToString("F1")
                            </span>
                        </div>

                        @if (totalRatingCount == 0)
                        {
                            <div class="cc-empty cc-empty--compact">
                                <span class="cc-empty__icon"><i class="fa-regular fa-star"></i></span>
                                <h3>No ratings yet</h3>
                                <p>Completed jobs will build your public rating profile.</p>
                            </div>
                        }
                        else
                        {
                            <div class="cc-rating-summary">
                                <div class="cc-rating-summary__score">
                                    <strong>@Model.AverageRating.ToString("F1")</strong>
                                    <div class="cc-stars" aria-label="@Model.AverageRating.ToString("F1") out of 5 stars">
                                        @{
                                            var fullStars = (int)Math.Floor(Model.AverageRating);
                                            var halfStar = Model.AverageRating - fullStars >= 0.5;
                                            for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= fullStars)
                                                {
                                                    <i class="fa-solid fa-star"></i>
                                                }
                                                else if (i == fullStars + 1 && halfStar)
                                                {
                                                    <i class="fa-solid fa-star-half-stroke"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                    <span>@totalRatingCount review@(totalRatingCount == 1 ? "" : "s")</span>
                                </div>

                                <div class="cc-rating-bars">
                                    @{
                                        void RenderRatingBar(int star, int count)
                                        {
                                            var pct = totalRatingCount > 0 ? (count * 100.0 / totalRatingCount) : 0;
                                            <div class="cc-rating-bar">
                                                <span>@star</span>
                                                <div><i style="width:@(pct)%"></i></div>
                                                <small>@count</small>
                                            </div>
                                        }
                                    }
                                    @{ RenderRatingBar(5, Model.FiveStarCount); }
                                    @{ RenderRatingBar(4, Model.FourStarCount); }
                                    @{ RenderRatingBar(3, Model.ThreeStarCount); }
                                    @{ RenderRatingBar(2, Model.TwoStarCount); }
                                    @{ RenderRatingBar(1, Model.OneStarCount); }
                                </div>
                            </div>
                        }
                    </article>
                </aside>
            </section>
        </main>
    </div>
</div>
