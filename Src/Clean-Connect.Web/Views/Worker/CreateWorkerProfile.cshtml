@model Clean_Connect.Application.Command.WorkerCommands.CreateWorkerCommand

@{
    ViewData["Title"] = "Create Worker Profile";
}

<div class="worker-profile-page py-5">

    <div class="container">

        <!-- Page Header -->

        <div class="text-center mb-5">

            <h1 class="worker-title">
                Complete Your Worker Profile
            </h1>

            <p class="worker-subtitle">
                Build your professional profile and start connecting with clients looking for trusted cleaning professionals.
            </p>

        </div>

        <!-- Progress Stepper -->

        <div class="worker-stepper mb-5">

            <div class="step active">

                <div class="step-number">1</div>

                <span>Personal</span>

            </div>

            <div class="step-line"></div>

            <div class="step">

                <div class="step-number">2</div>

                <span>Location</span>

            </div>

            <div class="step-line"></div>

            <div class="step">

                <div class="step-number">3</div>

                <span>Service</span>

            </div>

        </div>

        <form asp-action="Create"
              asp-controller="Worker"
              method="post"
              enctype="multipart/form-data"
              id="workerProfileForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- ===================================================== -->
            <!-- STEP 1 -->
            <!-- ===================================================== -->

            <div id="step1" class="wizard-step active">

                <!-- Profile Picture -->

                <div class="worker-card mb-4">

                    <div class="card-body text-center">

                        <div class="profile-picture mb-4">

                            <img id="previewImage"
                                 src="~/images/profile-placeholder.png"
                                 alt="Profile Photo" />

                        </div>

                        <h3 class="fw-bold">
                            Upload Profile Photo
                        </h3>

                        <p class="text-muted mb-4">
                            A clear profile picture helps clients trust you.
                        </p>

                        <input 
                               type="file"
                               class="form-control"
                               id="profileImage"
                               accept="image/*" />

                      @*   <span asp-validation-for="ProfileImage" *@
                              @* class="text-danger"></span> *@

                    </div>

                </div>

                <!-- Personal Information -->

                <div class="worker-card">

                    <div class="card-header border-0 bg-white pt-4">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-user text-success me-2"></i>

                            Personal Information

                        </h4>

                        <small class="text-muted">
                            Tell us a little about yourself.
                        </small>

                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <!-- First Name -->
                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-user"></i>

                                </span>

                                <div class="form-floating">

                                    <input asp-for="FirstName"
                                           class="form-control"
                                           placeholder="First Name" />

                                    <label asp-for="FirstName"></label>

                                </div>

                            </div>

                            <span asp-validation-for="FirstName" class="text-danger"></span>

                            <!-- Last Name -->

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-user"></i>

                                </span>

                                <div class="form-floating">

                                    <input asp-for="LastName"
                                           class="form-control"
                                           placeholder="Last Name" />

                                    <label asp-for="LastName"></label>

                                </div>

                            </div>

                            <span asp-validation-for="LastName" class="text-danger"></span>

                            <!-- Email -->

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-envelope"></i>

                                </span>

                                <div class="form-floating">

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Email" />

                                    <label asp-for="Email"></label>

                                </div>

                            </div>

                            <span asp-validation-for="Email" class="text-danger"></span>

                            <!-- Contact -->

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-phone"></i>

                                </span>

                                <div class="form-floating">

                                    <input asp-for="Contact"
                                           class="form-control"
                                           placeholder="Phone Number" />

                                    <label asp-for="Contact"></label>

                                </div>

                            </div>

                            <span asp-validation-for="Contact" class="text-danger"></span>

                            <!-- Gender -->

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-venus-mars"></i>

                                </span>

                                <div class="form-floating">

                                    <select asp-for="Gender"
                                            class="form-select">

                                        <option value="">Select Gender</option>

                                        <option value="Male">Male</option>

                                        <option value="Female">Female</option>

                                    </select>

                                    <label asp-for="Gender"></label>

                                </div>

                            </div>

                            <span asp-validation-for="Gender" class="text-danger"></span>

                            <!-- Date Of Birth -->

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </span>

                                <div class="form-floating">

                                    <input asp-for="Dob"
                                           type="date"
                                           class="form-control" />

                                    <label asp-for="Dob"></label>

                                </div>

                            </div>

                            <span asp-validation-for="Dob" class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Next Button -->

                <div class="d-flex justify-content-end mt-5">

                    <button type="button"
                            id="nextBtn1"
                            class="btn btn-success btn-lg px-5">

                        Continue

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </button>

                </div>

            </div>

            <!-- ===================================================== -->
            <!-- STEP 2 - LOCATION -->
            <!-- ===================================================== -->

            <div id="step2" class="wizard-step">

                <div class="worker-card">

                    <div class="card-header border-0 bg-white pt-4">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-location-dot text-success me-2"></i>

                            Location Information

                        </h4>

                        <small class="text-muted">
                            We'll use your location to connect you with nearby clients.
                        </small>

                    </div>

                    <div class="card-body">

                        <!-- Location Card -->

                        <div class="location-box mb-5">

                            <div class="d-flex justify-content-between align-items-center flex-wrap">

                                <div>

                                    <h5 class="fw-bold mb-2">

                                        <i class="fa-solid fa-location-crosshairs text-success me-2"></i>

                                        Detect My Location

                                    </h5>

                                    <p class="text-muted mb-0">

                                        Click the button below to automatically detect your current location.

                                    </p>

                                </div>

                                <button type="button"
                                        class="btn btn-success btn-location px-4">

                                    <i class="fa-solid fa-location-crosshairs me-2"></i>

                                    Use My Current Location

                                </button>

                            </div>

                        </div>

                        <div class="row g-4">

                            <!-- State -->

                            <div class="col-md-4">

                                <div class="form-floating">

                                    <input asp-for="State"
                                           class="form-control"
                                           placeholder="State" />

                                    <label asp-for="State"></label>

                                    <span asp-validation-for="State"
                                          class="text-danger"></span>

                                </div>

                            </div>

                            <!-- Latitude -->

                            <div class="col-md-4">

                                <div class="form-floating">

                                    <input asp-for="Latitude"
                                           id="latitude"
                                           class="form-control"
                                           readonly />

                                    <label asp-for="Latitude"></label>

                                    <span asp-validation-for="Latitude"
                                          class="text-danger"></span>

                                </div>

                            </div>

                            <!-- Longitude -->

                            <div class="col-md-4">

                                <div class="form-floating">

                                    <input asp-for="Longitude"
                                           id="longitude"
                                           class="form-control"
                                           readonly />

                                    <label asp-for="Longitude"></label>

                                    <span asp-validation-for="Longitude"
                                          class="text-danger"></span>

                                </div>

                            </div>

                        </div>

                        <!-- Location Preview -->

                        <div class="location-preview mt-5">

                            <div class="row align-items-center">

                                <div class="col-md-2 text-center">

                                    <i class="fa-solid fa-map-location-dot location-preview-icon"></i>

                                </div>

                                <div class="col-md-10">

                                    <h5 class="fw-bold">

                                        Location Preview

                                    </h5>

                                    <p class="text-muted mb-0">

                                        Once your location is detected, the latitude and longitude above will be filled automatically.

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Navigation -->

                <div class="d-flex justify-content-between mt-5">

                    <button type="button"
                            id="prevBtn2"
                            class="btn btn-outline-secondary btn-lg px-5">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Previous

                    </button>

                    <button type="button"
                            id="nextBtn2"
                            class="btn btn-success btn-lg px-5">

                        Continue

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </button>

                </div>

            </div>

            <!-- ===================================================== -->
            <!-- STEP 3 - PROFESSIONAL INFORMATION -->
            <!-- ===================================================== -->

            <div id="step3" class="wizard-step">

                <div class="worker-card">

                    <div class="card-header border-0 bg-white pt-4">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-briefcase text-success me-2"></i>

                            Professional Information

                        </h4>

                        <small class="text-muted">

                            Tell clients the type of cleaning service you provide.

                        </small>

                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <!-- Service Type -->
                            <div class="col-md-12">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-broom"></i>

                                    </span>

                                    <div class="form-floating">

                                        <select asp-for="ServiceTypeId"
                                                asp-items="ViewBag.ServiceTypes"
                                                class="form-select">

                                            <option value="">
                                                Select a Service Type
                                            </option>

                                        </select>

                                        <label asp-for="ServiceTypeId"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="ServiceTypeId"
                                      class="text-danger"></span>

                            </div>

                            <!-- About Me -->

                            @* <div class="col-md-12">

                                <div class="form-floating">

                                    <textarea asp-for="AboutMe"
                                              class="form-control"
                                              placeholder="About Me"
                                              style="height:180px"></textarea>

                                    <label asp-for="AboutMe">

                                        About Me

                                    </label>

                                </div>

                                <small class="text-muted">

                                    Tell clients why they should hire you.

                                </small>

                            </div> *@

                            <!-- Experience -->

                            @* <div class="col-md-6">

                                <div class="form-floating">

                                    <input asp-for="YearsOfExperience"
                                           class="form-control"
                                           placeholder="Years Of Experience" />

                                    <label asp-for="YearsOfExperience">

                                        Years Of Experience

                                    </label>

                                </div>

                            </div> *@

                            <!-- Availability -->

                          @*   <div class="col-md-6">

                                <div class="form-floating">

                                    <select asp-for="Availability"
                                            class="form-select">

                                        <option value="">
                                            Select Availability
                                        </option>

                                        <option>Weekdays</option>

                                        <option>Weekends</option>

                                        <option>Anytime</option>

                                    </select>

                                    <label asp-for="Availability"></label>

                                </div>

                            </div> *@

                        </div>

                    </div>

                </div>

                <!-- Summary -->
                <div class="worker-card summary-card mt-5">

                    <div class="card-body text-center">

                        <div class="summary-icon mb-4">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <h2 class="fw-bold mb-3">

                            You're Almost Done!

                        </h2>

                        <p class="text-muted mb-4">

                            Please review your information carefully before creating
                            your worker profile.

                        </p>

                        <div class="summary-list">

                            <div class="summary-item">

                                <i class="fa-solid fa-user text-success"></i>

                                <span>Personal Information</span>

                            </div>

                            <div class="summary-item">

                                <i class="fa-solid fa-location-dot text-success"></i>

                                <span>Location Information</span>

                            </div>

                            <div class="summary-item">

                                <i class="fa-solid fa-broom text-success"></i>

                                <span>Selected Service</span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Navigation -->

                <div class="d-flex justify-content-between align-items-center mt-5">

                    <button type="button"
                            id="prevBtn3"
                            class="btn btn-light btn-lg px-5">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Previous

                    </button>

                    <button type="submit"
                            id="saveButton"
                            class="btn btn-success btn-lg px-5">

                        <i class="fa-solid fa-user-check me-2"></i>

                        Create Worker Profile

                    </button>

                </div>

            </div>

        </form>

@section Scripts{

            <partial name="_ValidationScriptsPartial" />

            <script src="~/js/worker-profile.js"></script>

}
