@model Clean_Connect.Application.Command.WorkerCommands.CreateWorkerCommand

@{
    ViewData["Title"] = "Create Worker Profile";
}

<link rel="stylesheet" href="~/css/profile-forms.css" asp-append-version="true" />

<div class="worker-profile-page py-5">
    <div class="container profile-form-container">

        <!-- ========================================= -->
        <!-- PAGE HERO HEADER -->
        <!-- ========================================= -->
        <div class="profile-header" data-aos="fade-down">
            <div class="profile-badge-pill">
                <span class="pulse-dot"></span>
                <i class="fa-solid fa-badge-check"></i>
                Worker Registration
            </div>

            <h1 class="profile-title">
                Complete Your <span class="highlight-text">Worker Profile</span>
            </h1>

            <p class="profile-subtitle">
                Build your verified professional profile to start receiving direct job requests and earning with Clean Connect.
            </p>

            <!-- Trust Perks Strip -->
            <div class="profile-perks-strip">
                <span class="profile-perk-item">
                    <i class="fa-solid fa-calendar-check"></i>
                    Flexible Schedule
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-wallet"></i>
                    Fast Direct Payouts
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-shield-halved"></i>
                    Verified Service Badging
                </span>
                <span class="profile-perk-item">
                    <i class="fa-solid fa-chart-line-up"></i>
                    Top Earning Potential
                </span>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- PROGRESS STEPPER -->
        <!-- ========================================= -->
        <div class="profile-stepper-wrap" data-aos="fade-up" data-aos-delay="100">
            <div class="profile-stepper worker-stepper">
                <div class="step-item step active" id="stepperItem1">
                    <div class="step-circle step-number">1</div>
                    <div class="step-content">
                        <span class="step-label">Step 01</span>
                        <span class="step-title">Personal Details</span>
                    </div>
                </div>

                <div class="step-connector step-line" id="connector1"></div>

                <div class="step-item step" id="stepperItem2">
                    <div class="step-circle step-number">2</div>
                    <div class="step-content">
                        <span class="step-label">Step 02</span>
                        <span class="step-title">Service Area</span>
                    </div>
                </div>

                <div class="step-connector step-line" id="connector2"></div>

                <div class="step-item step" id="stepperItem3">
                    <div class="step-circle step-number">3</div>
                    <div class="step-content">
                        <span class="step-label">Step 03</span>
                        <span class="step-title">Specialization</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- MAIN PROFILE FORM -->
        <!-- ========================================= -->
        <form asp-action="CreateWorkerProfile"
              asp-controller="Worker"
              method="post"
              enctype="multipart/form-data"
              id="workerProfileForm"
              novalidate>

            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="profile-validation-summary" role="alert">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                        <strong>Please review the information you provided:</strong>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                </div>
            }

            <!-- ========================================= -->
            <!-- STEP 1: PERSONAL INFORMATION -->
            <!-- ========================================= -->
            <div id="step1" class="wizard-step active">
                <div class="profile-card" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-header-clean">
                        <div class="profile-card-header-left">
                            <div class="profile-card-icon-box">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="profile-card-header-text">
                                <h3>Personal & Contact Information</h3>
                                <p>Provide accurate identity details for your verified service profile.</p>
                            </div>
                        </div>
                        <span class="profile-card-badge">Step 1 of 3</span>
                    </div>

                    <div class="card-body-clean">
                        <div class="row g-4">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="FirstName"
                                                   class="form-control"
                                                   id="FirstName"
                                                   placeholder="First Name"
                                                   autocomplete="given-name"
                                                   required />
                                            <label asp-for="FirstName">First Name</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="LastName"
                                                   class="form-control"
                                                   id="LastName"
                                                   placeholder="Last Name"
                                                   autocomplete="family-name"
                                                   required />
                                            <label asp-for="LastName">Last Name</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Email Address -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-envelope"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="Email"
                                                   type="email"
                                                   class="form-control"
                                                   id="Email"
                                                   placeholder="name@example.com"
                                                   autocomplete="email"
                                                   required />
                                            <label asp-for="Email">Email Address</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Email" class="field-validation-error"></span>
                                    <small class="field-help-text">Must match your registered Clean Connect login email.</small>
                                </div>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-phone"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="Contact"
                                                   type="tel"
                                                   class="form-control"
                                                   id="Contact"
                                                   placeholder="08012345678"
                                                   autocomplete="tel"
                                                   required />
                                            <label asp-for="Contact">Phone Number</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Contact" class="field-validation-error"></span>
                                    <small class="field-help-text">Clients and dispatch will call or message this number.</small>
                                </div>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-venus-mars"></i>
                                        </div>
                                        <div class="form-floating">
                                            <select asp-for="Gender"
                                                    class="form-select"
                                                    id="Gender"
                                                    required>
                                                <option value="" disabled selected hidden></option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                            <label asp-for="Gender">Select Gender</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Gender" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-calendar-day"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="Dob"
                                                   type="date"
                                                   class="form-control"
                                                   id="Dob"
                                                   required />
                                            <label asp-for="Dob">Date of Birth</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Dob" class="field-validation-error"></span>
                                    <small class="field-help-text">You must be at least 18 years old to register as a worker.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Action -->
                <div class="profile-actions-bar">
                    <div></div>
                    <button type="button"
                            id="nextBtn1"
                            class="btn-wizard-action btn-wizard-primary">
                        Continue to Location
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- ========================================= -->
            <!-- STEP 2: LOCATION INFORMATION -->
            <!-- ========================================= -->
            <div id="step2" class="wizard-step">
                <div class="profile-card">
                    <div class="card-header-clean">
                        <div class="profile-card-header-left">
                            <div class="profile-card-icon-box">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div class="profile-card-header-text">
                                <h3>Service Base & Work Radius</h3>
                                <p>We match you with high-value cleaning opportunities in your coverage zone.</p>
                            </div>
                        </div>
                        <span class="profile-card-badge">Step 2 of 3</span>
                    </div>

                    <div class="card-body-clean">
                        <!-- Auto-Detect Geolocation Banner -->
                        <div class="location-hero-banner">
                            <div class="location-hero-info">
                                <div class="location-hero-icon">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </div>
                                <div class="location-hero-text">
                                    <h5>Auto-Detect Current Location</h5>
                                    <p>Allow location access to pin your operational service coordinates automatically.</p>
                                </div>
                            </div>
                            <button type="button"
                                    id="detectLocationBtn"
                                    class="btn-detect-action">
                                <i class="fa-solid fa-location-crosshairs"></i>
                                Use My Current Location
                            </button>
                        </div>

                        <!-- Manual / Detected Coordinates Fields -->
                        <div class="row g-4 mb-4">
                            <!-- State -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <div class="custom-floating-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-map"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="State"
                                                   id="state"
                                                   class="form-control"
                                                   placeholder="e.g. Lagos, Abuja"
                                                   required />
                                            <label asp-for="State">State / Operational Hub</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="State" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Latitude -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <div class="custom-floating-box readonly-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-compass"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="Latitude"
                                                   id="latitude"
                                                   class="form-control"
                                                   placeholder="0.000000"
                                                   readonly />
                                            <label asp-for="Latitude">Latitude</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Latitude" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Longitude -->
                            <div class="col-md-4">
                                <div class="form-field-group">
                                    <div class="custom-floating-box readonly-box">
                                        <div class="input-icon-pill">
                                            <i class="fa-solid fa-crosshairs"></i>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="Longitude"
                                                   id="longitude"
                                                   class="form-control"
                                                   placeholder="0.000000"
                                                   readonly />
                                            <label asp-for="Longitude">Longitude</label>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Longitude" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Live Metrics Cards -->
                        <div class="location-metrics-grid">
                            <div class="location-metric-card">
                                <div class="location-metric-icon text-success">
                                    <i class="fa-solid fa-map-pin"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Operational State</div>
                                    <span id="statePreview" class="location-metric-value">Not Detected</span>
                                </div>
                            </div>

                            <div class="location-metric-card">
                                <div class="location-metric-icon text-danger">
                                    <i class="fa-solid fa-location-dot"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Latitude</div>
                                    <span id="latPreview" class="location-metric-value">---</span>
                                </div>
                            </div>

                            <div class="location-metric-card">
                                <div class="location-metric-icon text-primary">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </div>
                                <div class="location-metric-body">
                                    <div class="location-metric-label">Longitude</div>
                                    <span id="lngPreview" class="location-metric-value">---</span>
                                </div>
                            </div>
                        </div>

                        <!-- Map Preview Wrapper -->
                        <div class="map-embed-wrapper mb-2">
                            <div id="mapPlaceholder" class="map-placeholder-box">
                                <div class="map-placeholder-icon">
                                    <i class="fa-solid fa-map-location-dot"></i>
                                </div>
                                <h6>Interactive Radar Preview</h6>
                                <p>Click "Use My Current Location" above to verify and lock your base coordinates on the map.</p>
                            </div>
                            <iframe id="mapFrame"
                                    class="map-embed-frame"
                                    style="display:none;"
                                    title="Worker Coverage Area Map"
                                    loading="lazy"></iframe>
                        </div>
                    </div>
                </div>

                <!-- Navigation Actions -->
                <div class="profile-actions-bar">
                    <button type="button"
                            id="prevBtn2"
                            class="btn-wizard-action btn-wizard-secondary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Personal Info
                    </button>

                    <button type="button"
                            id="nextBtn2"
                            class="btn-wizard-action btn-wizard-primary">
                        Continue to Specialization
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- ========================================= -->
            <!-- STEP 3: SPECIALIZATION & SUMMARY -->
            <!-- ========================================= -->
            <div id="step3" class="wizard-step">
                <div class="profile-card">
                    <div class="card-header-clean">
                        <div class="profile-card-header-left">
                            <div class="profile-card-icon-box">
                                <i class="fa-solid fa-broom"></i>
                            </div>
                            <div class="profile-card-header-text">
                                <h3>Cleaning Specialization</h3>
                                <p>Choose the core service category you are experienced and equipped to provide.</p>
                            </div>
                        </div>
                        <span class="profile-card-badge">Step 3 of 3</span>
                    </div>

                    <div class="card-body-clean">
                        <!-- Service Type Selector -->
                        <div class="form-field-group mb-4">
                            <div class="custom-floating-box">
                                <div class="input-icon-pill">
                                    <i class="fa-solid fa-sparkles"></i>
                                </div>
                                <div class="form-floating">
                                    <select asp-for="ServiceTypeId"
                                            asp-items="ViewBag.ServiceType"
                                            id="ServiceTypeId"
                                            class="form-select"
                                            required>
                                        <option value="" disabled selected hidden>Choose your specialty...</option>
                                    </select>
                                    <label asp-for="ServiceTypeId">Primary Cleaning Specialty</label>
                                </div>
                            </div>
                            <span asp-validation-for="ServiceTypeId" class="field-validation-error"></span>
                            <small class="field-help-text">You can add secondary specialties later in your dashboard.</small>
                        </div>

                        <!-- Hourly Rate -->
                        <div class="form-field-group mb-4">
                            <div class="custom-floating-box">
                                <div class="input-icon-pill">
                                    <i class="fa-solid fa-naira-sign"></i>
                                </div>
                                <div class="form-floating">
                                    <input asp-for="HourlyRate"
                                           id="HourlyRate"
                                           type="number"
                                           class="form-control"
                                           min="1"
                                           max="1000000"
                                           step="0.01"
                                           placeholder="2000"
                                           required />
                                    <label asp-for="HourlyRate">Hourly Rate (₦)</label>
                                </div>
                            </div>
                            <span asp-validation-for="HourlyRate" class="field-validation-error"></span>
                            <small class="field-help-text">Your per-hour charge shown to clients when they book you.</small>
                        </div>

                        <!-- Live Summary Panel -->
                        <div class="worker-summary-panel">
                            <div class="summary-header-box">
                                <div class="summary-hero-icon">
                                    <i class="fa-solid fa-user-check"></i>
                                </div>
                                <h4>Profile Summary Review</h4>
                                <p>Please double-check your registration details below before finalizing your worker profile.</p>
                            </div>

                            <div class="summary-cards-grid">
                                <div class="summary-chip-card">
                                    <div class="summary-chip-icon">
                                        <i class="fa-solid fa-id-card"></i>
                                    </div>
                                    <div class="summary-chip-body">
                                        <h6>Full Name</h6>
                                        <span id="summaryFullName">Worker Candidate</span>
                                    </div>
                                </div>

                                <div class="summary-chip-card">
                                    <div class="summary-chip-icon">
                                        <i class="fa-solid fa-address-book"></i>
                                    </div>
                                    <div class="summary-chip-body">
                                        <h6>Contact Channels</h6>
                                        <span id="summaryContact">Pending details</span>
                                    </div>
                                </div>

                                <div class="summary-chip-card">
                                    <div class="summary-chip-icon">
                                        <i class="fa-solid fa-location-crosshairs"></i>
                                    </div>
                                    <div class="summary-chip-body">
                                        <h6>Base Location</h6>
                                        <span id="summaryLocation">State not set</span>
                                    </div>
                                </div>

                                <div class="summary-chip-card">
                                    <div class="summary-chip-icon">
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    </div>
                                    <div class="summary-chip-body">
                                        <h6>Selected Specialty</h6>
                                        <span id="summaryService">Select a category above</span>
                                    </div>
                                </div>

                                <div class="summary-chip-card">
                                    <div class="summary-chip-icon">
                                        <i class="fa-solid fa-naira-sign"></i>
                                    </div>
                                    <div class="summary-chip-body">
                                        <h6>Hourly Rate</h6>
                                        <span id="summaryRate">Set rate above</span>
                                    </div>
                                </div>
                            </div>

                            <div class="agreement-trust-banner">
                                <i class="fa-solid fa-shield-halved"></i>
                                <div>
                                    By submitting this form, you confirm that your details are accurate and agree to Clean Connect's Professional Partner Code of Conduct and Service Standards.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Actions -->
                <div class="profile-actions-bar">
                    <button type="button"
                            id="prevBtn3"
                            class="btn-wizard-action btn-wizard-secondary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Location
                    </button>

                    <button type="submit"
                            id="saveButton"
                            class="btn-wizard-action btn-wizard-primary">
                        <i class="fa-solid fa-user-check"></i>
                        Complete Worker Profile
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/worker-profile.js" asp-append-version="true"></script>
}