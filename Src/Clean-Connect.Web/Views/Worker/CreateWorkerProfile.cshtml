@model Clean_Connect.Application.Command.WorkerCommands.CreateWorkerCommand

@{
    ViewData["Title"] = "Create Worker Profile";
}

<div class="worker-profile-page py-5">

    <div class="container">

        <!-- ========================================= -->
        <!-- PAGE HEADER -->
        <!-- ========================================= -->

        <div class="text-center mb-5">

            <span class="badge bg-success px-3 py-2 mb-3">

                <i class="fa-solid fa-user-check me-2"></i>

                Worker Registration

            </span>

            <h1 class="worker-title">

                Complete Your Worker Profile

            </h1>

            <p class="worker-subtitle">

                Build your professional profile and start connecting with
                clients looking for trusted cleaning professionals.

            </p>

        </div>

        <!-- ========================================= -->
        <!-- PROGRESS STEPPER -->
        <!-- ========================================= -->

        <div class="worker-stepper mb-5">

            <div class="step active">

                <div class="step-number">

                    <i class="fa-solid fa-user"></i>

                </div>

                <span>Personal</span>

            </div>

            <div class="step-line"></div>

            <div class="step">

                <div class="step-number">

                    <i class="fa-solid fa-location-dot"></i>

                </div>

                <span>Location</span>

            </div>

            <div class="step-line"></div>

            <div class="step">

                <div class="step-number">

                    <i class="fa-solid fa-briefcase"></i>

                </div>

                <span>Service</span>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- FORM -->
        <!-- ========================================= -->

        <form asp-action="CreateWorkerProfile"
              asp-controller="Worker"
              method="post"
              enctype="multipart/form-data"
              id="workerProfileForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <!-- ========================================= -->
            <!-- STEP 1 -->
            <!-- ========================================= -->

            <div id="step1" class="wizard-step active">

                <!-- PROFILE PHOTO -->

                @* <div class="worker-card mb-4">

                    <div class="card-body text-center">

                        <div class="profile-picture">

                            <img id="previewImage"
                                 src="~/images/profile-placeholder.png"
                                 alt="Profile Photo" />

                            <label for="profileImage"
                                   class="camera-btn">

                                <i class="fa-solid fa-camera"></i>

                            </label>

                        </div>

                        <h3 class="fw-bold mt-4">

                            Upload Profile Picture

                        </h3>

                        <p class="text-muted">

                            A professional photo increases client trust.

                        </p>

                        <input type="file"
                               id="profileImage"
                               class="form-control"
                               accept="image/*" />

                    </div>

                </div> *@

                <!-- PERSONAL INFORMATION -->

                <div class="worker-card">

                    <div class="card-header border-0">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-user text-success me-2"></i>

                            Personal Information

                        </h4>

                        <small class="text-muted">

                            Tell us about yourself.

                        </small>

                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <!-- First Name -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-user"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="FirstName"
                                               class="form-control"
                                               placeholder="First Name" />

                                        <label asp-for="FirstName"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Last Name -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-user"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="LastName"
                                               class="form-control"
                                               placeholder="Last Name" />

                                        <label asp-for="LastName"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                            <!-- Email -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-envelope"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="Email"
                                               class="form-control"
                                               placeholder="Email" />

                                        <label asp-for="Email"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                            <!-- Contact -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-phone"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="Contact"
                                               class="form-control"
                                               placeholder="Phone Number" />

                                        <label asp-for="Contact"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Contact"
                                      class="text-danger"></span>

                            </div>

                            <!-- Gender -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-venus-mars"></i>

                                    </span>

                                    <div class="form-floating">

                                        <select asp-for="Gender"
                                                class="form-select">

                                            <option value=""></option>

                                            <option value="Male">Male</option>

                                            <option value="Female">Female</option>

                                        </select>

                                        <label asp-for="Gender"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>

                            </div>

                            <!-- Date Of Birth -->

                            <div class="col-md-6">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-calendar-days"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="Dob"
                                               type="date"
                                               class="form-control" />

                                        <label asp-for="Dob"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Dob"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- NEXT BUTTON -->

                <div class="d-flex justify-content-end mt-5">

                    <button type="button"
                            id="nextBtn1"
                            class="btn btn-success btn-lg px-5">

                        Continue

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </button>

                </div>

            </div>

            <!-- ========================================= -->
            <!-- STEP 2 -->
            <!-- LOCATION INFORMATION -->
            <!-- ========================================= -->

            <div id="step2" class="wizard-step">

                <div class="worker-card">

                    <div class="card-header border-0">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-location-dot text-success me-2"></i>

                            Location Information

                        </h4>

                        <small class="text-muted">

                            We'll use your location to connect you with nearby clients.

                        </small>

                    </div>

                    <div class="card-body">

                        <!-- LOCATION DETECTION CARD -->

                        <div class="location-box mb-5">

                            <div class="row align-items-center">

                                <div class="col-lg-8">

                                    <h5 class="fw-bold mb-2">

                                        <i class="fa-solid fa-location-crosshairs text-success me-2"></i>

                                        Detect My Current Location

                                    </h5>

                                    <p class="text-muted mb-0">

                                        Click the button below and allow location access.
                                        We'll automatically fill your coordinates and state.

                                    </p>

                                </div>

                                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                                    <button type="button"
                                            id="detectLocationBtn"
                                            class="btn btn-success btn-location px-4">

                                        <i class="fa-solid fa-location-crosshairs me-2"></i>

                                        Use My Current Location

                                    </button>

                                </div>

                            </div>

                        </div>

                        <!-- LOCATION FIELDS -->

                        <div class="row g-4">

                            <!-- State -->

                            <div class="col-md-4">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-map"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="State"
                                               id="state"
                                               class="form-control"
                                               placeholder="State" />

                                        <label asp-for="State"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="State"
                                      class="text-danger"></span>

                            </div>

                            <!-- Latitude -->

                            <div class="col-md-4">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-location-dot"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="Latitude"
                                               id="latitude"
                                               class="form-control"
                                               readonly />

                                        <label asp-for="Latitude"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Latitude"
                                      class="text-danger"></span>

                            </div>

                            <!-- Longitude -->

                            <div class="col-md-4">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-location-crosshairs"></i>

                                    </span>

                                    <div class="form-floating">

                                        <input asp-for="Longitude"
                                               id="longitude"
                                               class="form-control"
                                               readonly />

                                        <label asp-for="Longitude"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="Longitude"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- LOCATION PREVIEW -->

                        <div class="location-preview mt-5">

                            <div class="text-center mb-4">

                                <i class="fa-solid fa-map-location-dot location-preview-icon"></i>

                                <h4 class="fw-bold mt-3">

                                    Detected Location

                                </h4>

                                <p class="text-muted">

                                    Your detected location details will appear below.

                                </p>

                            </div>

                            <div class="row g-4">

                                <!-- STATE PREVIEW -->

                                <div class="col-md-4">

                                    <div class="location-info text-center">

                                        <i class="fa-solid fa-map text-success"></i>

                                        <h6 class="mt-3">

                                            State

                                        </h6>

                                        <span id="statePreview">

                                            Not Detected

                                        </span>

                                    </div>

                                </div>

                                <!-- LATITUDE PREVIEW -->

                                <div class="col-md-4">

                                    <div class="location-info text-center">

                                        <i class="fa-solid fa-location-dot text-danger"></i>

                                        <h6 class="mt-3">

                                            Latitude

                                        </h6>

                                        <span id="latPreview">

                                            ---

                                        </span>

                                    </div>

                                </div>

                                <!-- LONGITUDE PREVIEW -->

                                <div class="col-md-4">

                                    <div class="location-info text-center">

                                        <i class="fa-solid fa-location-crosshairs text-primary"></i>

                                        <h6 class="mt-3">

                                            Longitude

                                        </h6>

                                        <span id="lngPreview">

                                            ---

                                        </span>

                                    </div>

                                </div>

                            </div>

                            <!-- MAP -->

                            <div class="mt-5">

                                <iframe id="mapFrame"
                                        width="100%"
                                        height="320"
                                        style="border:0;border-radius:20px;"
                                        loading="lazy">
                                </iframe>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- NAVIGATION -->

                <div class="d-flex justify-content-between mt-5">

                    <button type="button"
                            id="prevBtn2"
                            class="btn btn-light btn-lg px-5">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Previous

                    </button>

                    <button type="button"
                            id="nextBtn2"
                            class="btn btn-success btn-lg px-5">

                        Continue

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </button>

                </div>

            </div>

            <!-- ========================================= -->
            <!-- STEP 3 -->
            <!-- PROFESSIONAL INFORMATION -->
            <!-- ========================================= -->

            <div id="step3" class="wizard-step">

                <div class="worker-card">

                    <div class="card-header border-0">

                        <h4 class="fw-bold">

                            <i class="fa-solid fa-briefcase text-success me-2"></i>

                            Professional Information

                        </h4>

                        <small class="text-muted">

                            Tell clients the service you specialize in.

                        </small>

                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <!-- SERVICE TYPE -->

                            <div class="col-12">

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="fa-solid fa-broom"></i>

                                    </span>

                                    <div class="form-floating">

                                        <select asp-for="ServiceTypeId"
                                                asp-items="ViewBag.ServiceType"
                                                class="form-select">

                                            <option value="">
                                                Select Service Type
                                            </option>

                                        </select>

                                        <label asp-for="ServiceTypeId"></label>

                                    </div>

                                </div>

                                <span asp-validation-for="ServiceTypeId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- PROFILE SUMMARY -->
                <!-- ========================================= -->

                <div class="worker-card summary-card mt-4">

                    <div class="card-body">

                        <div class="text-center">

                            <div class="summary-icon">

                                <i class="fa-solid fa-circle-check"></i>

                            </div>

                            <h2 class="fw-bold mt-4">

                                Ready to Create Your Profile?

                            </h2>

                            <p class="text-muted">

                                Please review your information before
                                submitting your worker profile.

                            </p>

                        </div>

                        <hr class="my-4" />

                        <div class="row g-4">

                            <div class="col-md-4">

                                <div class="summary-item">

                                    <i class="fa-solid fa-user"></i>

                                    <div>

                                        <h6 class="mb-1">

                                            Personal Information

                                        </h6>

                                        <small class="text-muted">

                                            Name, Email, Phone,
                                            Gender & Date of Birth

                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="summary-item">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <div>

                                        <h6 class="mb-1">

                                            Location

                                        </h6>

                                        <small class="text-muted">

                                            State, Latitude &
                                            Longitude

                                        </small>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="summary-item">

                                    <i class="fa-solid fa-broom"></i>

                                    <div>

                                        <h6 class="mb-1">

                                            Service

                                        </h6>

                                        <small class="text-muted">

                                            Cleaning Category
                                            Selected

                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="alert alert-success mt-4">

                            <i class="fa-solid fa-shield-heart me-2"></i>

                            By creating your profile, you agree that the
                            information provided is accurate and may be
                            verified by Clean Connect.

                        </div>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- NAVIGATION -->
                <!-- ========================================= -->

                <div class="d-flex justify-content-between mt-5">

                    <button type="button"
                            id="prevBtn3"
                            class="btn btn-outline-secondary btn-lg px-5">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Previous

                    </button>

                    <button type="submit"
                            id="saveButton"
                            class="btn btn-success btn-lg px-5">

                        <i class="fa-solid fa-user-check me-2"></i>

                        Complete Profile

                    </button>

                </div>

            </div>

        </form>
    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/worker-profile.js"></script>

}