@model Clean_Connect.Web.Models.PayoutDetailsViewModel

@{
    ViewData["Title"] = "Payout Details";
    Layout = "_DashboardLayout";
}

<div class="cc-dashboard cc-dashboard--worker">
    <div class="cc-dashboard-shell">
        <aside class="cc-rail" aria-label="Worker dashboard navigation">
            <a class="cc-rail__brand" asp-controller="Home" asp-action="Index" aria-label="Clean Connect home">
                <span class="cc-rail__logo"><i class="fa-solid fa-broom"></i></span>
                <span>
                    <strong>Clean Connect</strong>
                    <small>Worker workspace</small>
                </span>
            </a>

            <nav class="cc-rail__nav">
                <a class="cc-rail__link" asp-controller="Worker" asp-action="Dashboard">
                    <i class="fa-solid fa-table-cells-large"></i>
                    <span>Overview</span>
                </a>
                <a class="cc-rail__link" asp-controller="Booking" asp-action="Responses">
                    <i class="fa-solid fa-inbox"></i>
                    <span>Requests</span>
                </a>
                <a class="cc-rail__link is-active" href="/Payout-Details">
                    <i class="fa-solid fa-bank"></i>
                    <span>Payout details</span>
                </a>
                <a class="cc-rail__link" asp-controller="Notifications" asp-action="Index">
                    <i class="fa-solid fa-bell"></i>
                    <span>Updates</span>
                </a>
                <a class="cc-rail__link" href="/Update-Worker-Details">
                    <i class="fa-solid fa-user-gear"></i>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="cc-rail__panel">
                <span class="cc-rail__panel-label">Payout status</span>
                <strong>@(Model.HasDetails ? "Bank on file" : "Not set")</strong>
                <small>Transfers are sent automatically after each completed job.</small>
            </div>
        </aside>

        <main class="cc-main">
            <section class="cc-hero" aria-labelledby="payout-details-title">
                <div class="cc-hero__content">
                    <span class="cc-kicker">
                        <i class="fa-solid fa-bank"></i>
                        Payout details
                    </span>
                    <h1 id="payout-details-title">Where should we pay you?</h1>
                    <p>
                        Add the bank account your job earnings are transferred to. As soon as a client confirms a completed job,
                        your net pay is sent directly to this account — no wallet, no withdrawal step.
                        @if (Model.HasDetails && !string.IsNullOrWhiteSpace(Model.MaskedAccountNumber))
                        {
                            <text>Your current account ends in <strong>@Model.MaskedAccountNumber.Substring(Model.MaskedAccountNumber.Length - 4)</strong>.</text>
                        }
                    </p>

                    <div class="cc-hero__meta">
                        @if (Model.HasDetails)
                        {
                            <span><i class="fa-solid fa-circle-check"></i>Active payout account</span>
                        }
                        else
                        {
                            <span><i class="fa-solid fa-circle-pause"></i>Awaiting bank details</span>
                        }
                        <span><i class="fa-solid fa-naira-sign"></i>NGN transfers</span>
                    </div>
                </div>
            </section>

            <section class="cc-panel cc-panel--pad" style="max-width: 780px;">
                <form asp-action="PayoutDetails" asp-controller="Worker" method="post" class="cc-form">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "cc-form__error" })

                    <input type="hidden" asp-for="HasDetails" />
                    <input type="hidden" asp-for="BankName" id="hfBankName" />
                    <input type="hidden" asp-for="MaskedAccountNumber" />
                    <input type="hidden" asp-for="Currency" />

                    <div class="cc-form__field">
                        <label class="cc-form__label" asp-for="BankCode">Bank</label>
                        <select asp-for="BankCode" asp-items="@(ViewBag.Banks as SelectList)" class="cc-form__input" id="ddlBank" onchange="syncBankName()">
                            <option value="">Select your bank…</option>
                        </select>
                        <span asp-validation-for="BankCode" class="cc-form__error-text"></span>
                    </div>

                    <div class="cc-form__field">
                        <label class="cc-form__label" asp-for="AccountNumber">Account number</label>
                        <input asp-for="AccountNumber" class="cc-form__input" placeholder="10-digit account number" autocomplete="off" inputmode="numeric" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                        @if (Model.HasDetails && !string.IsNullOrWhiteSpace(Model.MaskedAccountNumber))
                        {
                            <small class="cc-form__hint">Current: <strong>@Model.MaskedAccountNumber</strong> — enter a new number only if you want to change it.</small>
                        }
                        <span asp-validation-for="AccountNumber" class="cc-form__error-text"></span>
                    </div>

                    <div class="cc-form__field">
                        <label class="cc-form__label" asp-for="AccountName">Account name</label>
                        <div class="d-flex gap-2">
                            <input asp-for="AccountName" class="cc-form__input" placeholder="Name on account" id="txtAccountName" />
                            <button type="button" class="cc-btn cc-btn--soft" id="btnVerify">
                                <i class="fa-solid fa-circle-check"></i> Verify
                            </button>
                        </div>
                        <small class="cc-form__hint">
                            Verification is optional — if it fails, just type the exact name as registered with your bank and save.
                        </small>
                        <span id="verifyStatus" class="cc-form__error-text"></span>
                        <span asp-validation-for="AccountName" class="cc-form__error-text"></span>
                    </div>

                    <div class="cc-form__actions">
                        <button type="submit" class="cc-btn cc-btn--primary">
                            <i class="fa-solid fa-bank"></i>
                            @(Model.HasDetails ? "Update payout details" : "Save payout details")
                        </button>
                        <a asp-controller="Worker" asp-action="Dashboard" class="cc-btn cc-btn--soft">Cancel</a>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const bankSelect = document.getElementById('ddlBank');
        const nameInput = document.getElementById('txtAccountName');
        const verifyBtn = document.getElementById('btnVerify');
        const verifyStatus = document.getElementById('verifyStatus');

        function syncBankName() {
            const hf = document.getElementById('hfBankName');
            hf.value = bankSelect.selectedOptions.length ? bankSelect.selectedOptions[0].text : '';
        }
        if (bankSelect) bankSelect.addEventListener('change', syncBankName);
        syncBankName();

        if (verifyBtn) {
            verifyBtn.addEventListener('click', async () => {
                verifyStatus.textContent = '';
                const accountNumber = document.getElementById('AccountNumber').value;
                const bankCode = bankSelect.value;
                if (!bankCode || !/^[0-9]{10}$/.test(accountNumber)) {
                    verifyStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Choose a bank and enter a 10-digit account number first.';
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                verifyBtn.disabled = true;
                verifyBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Checking…';

                try {
                    const res = await fetch('/Resolve-Account', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        credentials: 'same-origin',
                        body: new URLSearchParams({ bankCode, accountNumber, __RequestVerificationToken: token })
                    });
                    const data = await res.json();
                    if (data.ok) {
                        nameInput.value = data.accountName;
                        verifyStatus.className = 'cc-form__success-text';
                        verifyStatus.innerHTML = '<i class="fa-solid fa-circle-check"></i> Account verified: ' + data.accountName;
                    } else {
                        verifyStatus.className = 'cc-form__error-text';
                        verifyStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + (data.message || 'Could not verify the account.') + ' You can still save by typing the name manually.';
                    }
                } catch (err) {
                    verifyStatus.className = 'cc-form__error-text';
                    verifyStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Verification service unavailable right now. Type the name manually.';
                } finally {
                    verifyBtn.disabled = false;
                    verifyBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Verify';
                }
            });
        }
    </script>
}