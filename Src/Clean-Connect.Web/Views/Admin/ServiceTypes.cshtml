@model List<Clean_Connect.Application.DTO.AdminServiceTypeDto>
@{
    ViewData["Title"] = "Service Types";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string FormatNaira(decimal amount) => $"₦{amount:N0}";
    var activeServices = Model.Where(s => s.Status == "Active").ToList();
    var avgRate = activeServices.Count > 0 ? activeServices.Average(s => s.BaseRate) : 0;
    var topService = Model.OrderByDescending(s => s.TotalBookings).FirstOrDefault();
}

<div class="admin-page-header">
    <div class="admin-page-title-wrap">
        <h2>Service Types Catalog</h2>
        <p>Configure offered cleaning categories, base pricing in Naira, service durations, and catalog availability.</p>
    </div>
    <div class="admin-page-actions">
        <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#serviceTypeModal">
            <i class="fa-solid fa-circle-plus me-1"></i> Add Service Type
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Active Services</span>
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            </div>
            <div class="stat-card-value">@activeServices.Count</div>
            <div class="stat-card-meta">
                <span class="text-success fw-bold">@activeServices.Count</span>
                <span>live on customer booking flow</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Workers on Platform</span>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.Sum(s => s.WorkerCount).ToString("N0")</div>
            <div class="stat-card-meta">
                <span class="text-muted">across all service categories</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Top Service Demand</span>
                <div class="stat-icon-wrapper stat-icon-sky">
                    <i class="fa-solid fa-fire"></i>
                </div>
            </div>
            <div class="stat-card-value" style="font-size: 1.45rem;">@(topService?.Name ?? "—")</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up"><i class="fa-solid fa-arrow-up"></i> @(topService?.TotalBookings ?? 0)</span>
                <span>bookings all-time</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Average Base Rate</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="fa-solid fa-naira-sign"></i>
                </div>
            </div>
            <div class="stat-card-value">@FormatNaira(avgRate)</div>
            <div class="stat-card-meta">
                <span class="text-muted">Standard booking base</span>
            </div>
        </div>
    </div>
</div>

<div id="services-data">
    <!-- Filter Toolbar -->
    <div class="admin-filter-bar">
        <div class="filter-left-group">
            <div class="filter-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="filter-search-input" data-table-search="servicesTable" placeholder="Search service title or description..." />
            </div>

            <select class="filter-select" data-table-filter="servicesTable" data-filter-col="4">
                <option value="all">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Deactivated">Deactivated</option>
            </select>

            <button class="btn btn-sm btn-admin-secondary" data-reset-filter="servicesTable">
                <i class="fa-solid fa-filter-circle-xmark me-1"></i> Reset
            </button>
        </div>

        <div class="filter-right-group">
            <span class="results-counter" id="servicesTable-counter">Showing @Model.Count of @Model.Count records</span>
        </div>
    </div>

    <!-- Data Table -->
    <div class="admin-card">
        <div class="admin-table-responsive">
            <table class="admin-table" id="servicesTable">
                <thead>
                    <tr>
                        <th>Service Name</th>
                        <th>Description</th>
                        <th>Base Rate</th>
                        <th>Workers</th>
                        <th>Status</th>
                        <th>Total Bookings</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-layer-group fs-3 mb-2 d-block text-secondary"></i>
                                No services in the catalog yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="stat-icon-wrapper stat-icon-emerald" style="width: 40px; height: 40px; border-radius: 10px;">
                                            <i class="fa-solid @s.Icon"></i>
                                        </div>
                                        <div class="user-details">
                                            <span class="user-name">@s.Name</span>
                                            <span class="user-subtext">ID: #ST-@s.Id.ToString("N").Substring(0, 4).ToUpper()</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@s.Description</span>
                                </td>
                                <td><span class="fw-bold text-success fs-6">@FormatNaira(s.BaseRate)</span></td>
                                <td><span class="fw-bold">@s.WorkerCount</span></td>
                                <td>
                                    <span class="badge-status @(s.Status == "Active" ? "badge-status-success" : "badge-status-neutral")">
                                        <span class="badge-status-dot"></span> @s.Status
                                    </span>
                                </td>
                                <td><span class="fw-bold">@s.TotalBookings</span> bookings</td>
                                <td class="text-end">
                                    <div class="table-actions justify-content-end">
                                        <button class="btn-action-icon" data-bs-toggle="modal" data-bs-target="#serviceTypeModal" title="Edit Service"
                                                data-service-id="@s.Id"
                                                data-service-name="@s.Name"
                                                data-service-desc="@s.Description"
                                                data-service-rate="@s.BaseRate">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        @if (s.Status == "Deactivated")
                                        {
                                            <button class="btn-action-icon text-success" data-bs-toggle="modal" data-bs-target="#deleteServiceModal" title="Reactivate Service"
                                                    data-service-id="@s.Id"
                                                    data-service-name="@s.Name"
                                                    data-mode="restore">
                                                <i class="fa-solid fa-circle-check"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-action-icon text-danger" data-bs-toggle="modal" data-bs-target="#deleteServiceModal" title="Deactivate"
                                                    data-service-id="@s.Id"
                                                    data-service-name="@s.Name">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    <tr id="servicesTable-no-results" style="display: none;">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-magnifying-glass fs-3 mb-2 d-block text-secondary"></i>
                            No services match your search or filter criteria.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="admin-pagination-wrapper" data-paginate="servicesTable" data-page-size="6">
            <span class="pagination-info" data-pagination-info>Showing all @Model.Count services</span>
            <ul class="admin-pagination" data-pagination-list></ul>
        </div>
    </div>
</div>

<!-- Empty State Container -->
<div id="services-empty" class="d-none">
    <div class="admin-card">
        <div class="admin-empty-state">
            <div class="empty-state-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <h4 class="empty-state-title">No Services in Catalog</h4>
            <p class="empty-state-desc">Create your first cleaning package so customers can start booking workers online.</p>
            <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#serviceTypeModal">
                <i class="fa-solid fa-plus me-1"></i> Add New Service
            </button>
        </div>
    </div>
</div>

<!-- Add / Edit Service Modal -->
<div class="modal fade" id="serviceTypeModal" tabindex="-1" aria-labelledby="serviceTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="serviceTypeModalLabel">
                    <i class="fa-solid fa-layer-group text-success me-2"></i>
                    Add Service Type
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="serviceTypeForm">
                    <input type="hidden" id="serviceId" />
                    <div class="mb-3">
                        <label class="form-label">Service Title <span class="text-muted small">(10-50 chars)</span></label>
                        <input type="text" id="serviceName" class="form-control" maxlength="50" placeholder="e.g. Deep Cleaning Service" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Base Rate (₦) <span class="text-muted small">(min ₦1)</span></label>
                        <input type="number" id="serviceRate" class="form-control" min="1" max="1000000" step="0.01" placeholder="15000" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Detailed Description <span class="text-muted small">(10-200 chars)</span></label>
                        <textarea id="serviceDescription" class="form-control" rows="3" maxlength="200" placeholder="Briefly describe the service offering..."></textarea>
                    </div>
                </form>
                <div id="serviceTypeFeedback"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-admin-primary" id="serviceTypeSaveBtn">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="serviceTypeSaveSpinner"></span>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger" id="deleteModalTitle">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Confirm Service Deactivation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteServiceId" />
                <p id="deleteServiceMsg">Are you sure you want to deactivate <strong id="deleteServiceNameText">this service</strong>? It will no longer appear on the customer booking portal. Affected clients and cleaners will be notified.</p>
                <div id="deleteServiceFeedback"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteServiceConfirmBtn">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="deleteServiceSpinner"></span>
                    Deactivate Service
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const headers = { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' };

        /* ---- Add / Edit ---- */
        const modalEl    = document.getElementById('serviceTypeModal');
        const idEl       = document.getElementById('serviceId');
        const nameEl     = document.getElementById('serviceName');
        const rateEl     = document.getElementById('serviceRate');
        const descEl     = document.getElementById('serviceDescription');
        const feedbackEl = document.getElementById('serviceTypeFeedback');
        const saveBtn    = document.getElementById('serviceTypeSaveBtn');
        const spinner    = document.getElementById('serviceTypeSaveSpinner');
        const titleEl    = document.getElementById('serviceTypeModalLabel');
        let editingMode  = false;

        modalEl.addEventListener('show.bs.modal', function (e) {
            var trigger = e.relatedTarget;
            var id      = trigger && trigger.getAttribute('data-service-id');
            var name    = trigger && trigger.getAttribute('data-service-name');
            var desc    = trigger && trigger.getAttribute('data-service-desc');
            var rate    = trigger && trigger.getAttribute('data-service-rate');
            editingMode = !!(id && id !== '');
            idEl.value      = id || '';
            nameEl.value    = name || '';
            rateEl.value    = rate || '';
            descEl.value    = desc || '';
            feedbackEl.innerHTML = '';
            if (editingMode) {
                titleEl.textContent = 'Edit Service Type';
                nameEl.focus();
            } else {
                titleEl.textContent = 'Add Service Type';
                nameEl.value = '';
                rateEl.value = '';
                descEl.value = '';
                nameEl.focus();
            }
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            idEl.value = '';
            nameEl.value = '';
            rateEl.value = '';
            descEl.value = '';
            feedbackEl.innerHTML = '';
            editingMode = false;
        });

        saveBtn.addEventListener('click', function () {
            var name = nameEl.value.trim();
            var rate = parseFloat(rateEl.value);
            var desc = descEl.value.trim();
            if (name.length < 10 || name.length > 50) {
                feedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-2">Service title must be between 10 and 50 characters.</div>';
                return;
            }
            if (!rate || rate <= 0 || rate > 1000000) {
                feedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-2">Base rate must be between ₦1 and ₦1,000,000.</div>';
                return;
            }
            if (desc.length < 10 || desc.length > 200) {
                feedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-2">Description must be between 10 and 200 characters.</div>';
                return;
            }

            spinner.classList.remove('d-none');
            saveBtn.disabled = true;

            var endpoint = editingMode ? '/Admin/ServiceTypes/Edit' : '/Admin/ServiceTypes/Create';
            var body = 'Name=' + encodeURIComponent(name) + '&Description=' + encodeURIComponent(desc) + '&Amount=' + encodeURIComponent(rate);
            if (editingMode) body += '&Id=' + encodeURIComponent(idEl.value);

            fetch(endpoint, { method: 'POST', headers: headers, body: body, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    spinner.classList.add('d-none');
                    saveBtn.disabled = false;
                    if (res.ok) {
                        feedbackEl.innerHTML = '<div class="alert alert-success py-2 mb-0">' + (editingMode ? 'Service updated' : 'Service created') + ' — reloading...</div>';
                        setTimeout(function () { location.reload(); }, 400);
                    } else {
                        feedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-0">' + (res.message || 'An error occurred.') + '</div>';
                    }
                })
                .catch(function () {
                    spinner.classList.add('d-none');
                    saveBtn.disabled = false;
                    feedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-0">Network error. Please try again.</div>';
                });
        });

        /* ---- Deactivate ---- */
        const delIdEl      = document.getElementById('deleteServiceId');
        const delNameEl    = document.getElementById('deleteServiceNameText');
        const delConfirm   = document.getElementById('deleteServiceConfirmBtn');
        const delSpinner   = document.getElementById('deleteServiceSpinner');
        const delFeedback  = document.getElementById('deleteServiceFeedback');
        const delModalEl   = document.getElementById('deleteServiceModal');

        delModalEl.addEventListener('show.bs.modal', function (e) {
            var trigger = e.relatedTarget;
            var mode    = trigger.getAttribute('data-mode') || 'deactivate';
            var name    = trigger.getAttribute('data-service-name') || 'this service';
            window.__delRestoreMode = (mode === 'restore');
            delIdEl.value = trigger.getAttribute('data-service-id') || '';
            delNameEl.textContent = name;
            delFeedback.innerHTML = '';

            var titleEl = document.getElementById('deleteModalTitle');
            var msgEl   = document.getElementById('deleteServiceMsg');
            if (window.__delRestoreMode) {
                titleEl.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> Confirm Service Reactivation';
                titleEl.classList.remove('text-danger');
                titleEl.classList.add('text-success');
                delConfirm.classList.remove('btn-danger');
                delConfirm.classList.add('btn-success');
                delConfirm.textContent = 'Reactivate Service';
                msgEl.innerHTML = 'Are you sure you want to reactivate <strong>' + name + '</strong>? It will be live again on the customer booking portal immediately.';
            } else {
                titleEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-2"></i> Confirm Service Deactivation';
                titleEl.classList.remove('text-success');
                titleEl.classList.add('text-danger');
                delConfirm.classList.remove('btn-success');
                delConfirm.classList.add('btn-danger');
                delConfirm.textContent = 'Deactivate Service';
                msgEl.innerHTML = 'Are you sure you want to deactivate <strong>' + name + '</strong>? It will no longer appear on the customer booking portal. Affected clients and cleaners will be notified.';
            }
        });

        delModalEl.addEventListener('hidden.bs.modal', function () {
            delIdEl.value = '';
            delFeedback.innerHTML = '';
        });

        delConfirm.addEventListener('click', function () {
            var id = delIdEl.value;
            if (!id) return;
            delSpinner.classList.remove('d-none');
            delConfirm.disabled = true;
            var body = 'id=' + encodeURIComponent(id);
            var endpoint = window.__delRestoreMode ? '/Admin/ServiceTypes/' + id + '/Restore' : '/Admin/ServiceTypes/Delete';

            fetch(endpoint, { method: 'POST', headers: headers, body: body, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    delSpinner.classList.add('d-none');
                    delConfirm.disabled = false;
                    if (res.ok) {
                        delFeedback.innerHTML = '<div class="alert alert-success py-2 mb-0">' + (res.message || 'Done') + ' — reloading...</div>';
                        setTimeout(function () { location.reload(); }, 600);
                    } else {
                        delFeedback.innerHTML = '<div class="alert alert-danger py-2 mb-0">' + (res.message || 'An error occurred.') + '</div>';
                    }
                })
                .catch(function () {
                    delSpinner.classList.add('d-none');
                    delConfirm.disabled = false;
                    delFeedback.innerHTML = '<div class="alert alert-danger py-2 mb-0">Network error. Please try again.</div>';
                });
        });
    })();
</script>
}