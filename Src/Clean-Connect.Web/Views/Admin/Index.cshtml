@model Clean_Connect.Application.DTO.AdminDashboardDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string FormatNaira(decimal amount) => $"₦{amount:N0}";
}

<div class="admin-page-header">
    <div class="admin-page-title-wrap">
        <h2>Executive Overview</h2>
        <p>Real-time analytics, revenue distribution, and operational metrics.</p>
    </div>
    <div class="admin-page-actions">
        <button class="btn btn-admin-secondary" onclick="location.reload();">
            <i class="fa-solid fa-arrows-rotate"></i>
            <span>Refresh Data</span>
        </button>
        <a asp-controller="Admin" asp-action="Bookings" class="btn btn-admin-primary">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Manage Bookings</span>
        </a>
    </div>
</div>

<!-- 4 Key Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Total Revenue</span>
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i class="fa-solid fa-naira-sign"></i>
                </div>
            </div>
            <div class="stat-card-value">@FormatNaira(Model.TotalRevenue)</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up">
                    <i class="fa-solid fa-arrow-trend-up"></i> @FormatNaira(Model.RevenueThisMonth)
                </span>
                <span>earned this month</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Active Bookings</span>
                <div class="stat-icon-wrapper stat-icon-sky">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.ActiveBookings</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up">
                    <i class="fa-solid fa-calendar-day"></i> @Model.ScheduledToday scheduled
                </span>
                <span>today</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Active Workers</span>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.ActiveWorkers</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-neutral">
                    <i class="fa-solid fa-clock"></i> @Model.PendingWorkers pending
                </span>
                <span>@Model.ActiveWorkers available now</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Total Clients</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="fa-solid fa-user-group"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.TotalClients</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up">
                    <i class="fa-solid fa-user-plus"></i> @Model.NewClientsThisMonth new
                </span>
                <span>this month</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Row: Performance & Service Breakdown -->
<div class="row g-4 mb-4">
    <!-- Revenue & Monthly Trends -->
    <div class="col-lg-8">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fa-solid fa-chart-simple"></i>
                    Revenue & Booking Velocity
                </h3>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active">Monthly</button>
                    <button type="button" class="btn btn-outline-secondary">Weekly</button>
                </div>
            </div>
            <div class="admin-card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="fs-4 fw-bold text-success">@FormatNaira(Model.RevenueThisMonth) <span class="fs-6 text-muted fw-normal">this month</span></div>
                        <div class="small text-muted">Platform fee share: @FormatNaira(Model.PlatformFeeShare)</div>
                    </div>
                    <div class="d-flex gap-3 text-muted small">
                        <span><i class="fa-solid fa-circle text-success me-1"></i> Completed Bookings</span>
                        <span><i class="fa-solid fa-circle text-info me-1"></i> Escrow Held</span>
                    </div>
                </div>

                <!-- Visual Bar Chart Graph -->
                <div class="d-flex align-items-end justify-content-between pt-4 pb-2" style="height: 180px; gap: 12px;">
                    @foreach (var m in Model.MonthlyRevenue)
                    {
                        var height = m.Percentage <= 0 ? 2 : m.Percentage;
                        var isLast = m == Model.MonthlyRevenue[^1];
                        <div class="d-flex flex-column align-items-center flex-grow-1 h-100 justify-content-end">
                            <div class="w-100 rounded-top" style="background: linear-gradient(180deg, @(isLast ? "#0ea5e9" : "#10b981") 0%, #059669 100%); height: @(height)%;" title="@m.Month: @FormatNaira(m.Amount)"></div>
                            <span class="small @(isLast ? "fw-bold text-success" : "text-muted") mt-2">@m.Month</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Service Distribution -->
    <div class="col-lg-4">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fa-solid fa-bolt"></i>
                    Quick Actions
                </h3>
            </div>
            <div class="admin-card-body d-flex flex-column justify-content-between gap-3">
                <div class="d-grid gap-2">
                    <a asp-controller="Admin" asp-action="ServiceTypes" class="btn btn-admin-secondary text-start d-flex align-items-center justify-content-between p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon-wrapper stat-icon-sky" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-layer-group fs-6"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Manage Services</div>
                                <div class="small text-muted">Edit pricing & categories</div>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </a>

                    <a asp-controller="Admin" asp-action="Workers" class="btn btn-admin-secondary text-start d-flex align-items-center justify-content-between p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon-wrapper stat-icon-amber" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-id-card fs-6"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Workers Directory (@Model.PendingWorkers pending)</div>
                                <div class="small text-muted">Review profiles & availability</div>
                            </div>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill">@Model.PendingWorkers</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Payments" class="btn btn-admin-secondary text-start d-flex align-items-center justify-content-between p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon-wrapper stat-icon-emerald" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-money-bill-transfer fs-6"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Escrow Payouts</div>
                                <div class="small text-muted">Release completed funds</div>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </a>
                </div>

                <div class="pt-3 border-top border-secondary-subtle">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Escrow Held</span>
                        <span class="fw-bold text-dark dark-text-light">@FormatNaira(Model.EscrowHeld)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Row: Recent Bookings & System Activity Feed -->
<div class="row g-4">
    <!-- Recent Bookings Table -->
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Recent Bookings
                </h3>
                <a asp-controller="Admin" asp-action="Bookings" class="btn btn-sm btn-admin-outline">
                    View All
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="admin-table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Client</th>
                            <th>Worker</th>
                            <th>Service</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fa-solid fa-inbox fs-3 d-block mb-2"></i>
                                    No bookings yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var b in Model.RecentBookings)
                            {
                                var statusClass = b.Status == "Completed" ? "badge-status-success" : (b.Status == "In Progress" ? "badge-status-warning" : "badge-status-info");
                                <tr>
                                    <td class="fw-bold text-primary">@b.BookingId</td>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar-initials bg-info-subtle text-info">@b.ClientInitials</div>
                                            <div class="user-details">
                                                <span class="user-name">@b.ClientName</span>
                                                <span class="user-subtext">@b.ClientLocation</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(b.WorkerName))
                                        {
                                            <div class="user-details">
                                                <span class="user-name text-muted fst-italic">Auto-matching...</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="user-details">
                                                <span class="user-name">@b.WorkerName</span>
                                                @if (b.WorkerRating.HasValue)
                                                {
                                                    <span class="user-subtext"><i class="fa-solid fa-star text-warning"></i> @b.WorkerRating.Value.ToString("0.0")</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary-subtle text-dark border">@b.ServiceType</span></td>
                                    <td class="fw-bold">@FormatNaira(b.Amount)</td>
                                    <td>
                                        <span class="badge-status @statusClass">
                                            <span class="badge-status-dot"></span> @b.Status
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-action-icon" data-bs-toggle="modal" data-bs-target="#quickBookingModal" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Live System Activity Feed -->
    <div class="col-lg-4">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fa-solid fa-wave-square"></i>
                    Audit Activity
                </h3>
                <span class="badge bg-success-subtle text-success rounded-pill">Live Feed</span>
            </div>
            <div class="admin-card-body p-3">
                <div class="d-flex flex-column gap-3">
                    @foreach (var a in Model.AuditActivity)
                    {
                        var iconMap = new Dictionary<string, string>
                        {
                            ["emerald"] = "fa-check",
                            ["sky"] = "fa-calendar-plus",
                            ["amber"] = "fa-user-plus",
                            ["rose"] = "fa-flag"
                        };
                        var icon = iconMap.TryGetValue(a.IconVariant, out var ic) ? ic : "fa-circle";
                        <div class="d-flex gap-3 align-items-start">
                            <div class="stat-icon-wrapper stat-icon-@a.IconVariant" style="width: 32px; height: 32px; flex-shrink: 0;">
                                <i class="fa-solid @icon fs-6"></i>
                            </div>
                            <div>
                                <div class="small fw-bold">@a.Title</div>
                                <div class="text-muted" style="font-size: 0.76rem;">@a.Description</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@a.TimeAgo</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Booking Modal Preview -->
@if (Model.RecentBookings.Count > 0)
{
    var b = Model.RecentBookings[0];
    var statusClass = b.Status == "Completed" ? "badge-status-success" : (b.Status == "In Progress" ? "badge-status-warning" : "badge-status-info");
    <div class="modal fade" id="quickBookingModal" tabindex="-1" aria-labelledby="quickBookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="quickBookingModalLabel">
                        <i class="fa-solid fa-calendar-check text-success me-2"></i>
                        Booking Overview: @b.BookingId
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-secondary-subtle rounded-3">
                        <div>
                            <span class="small text-muted d-block">Total Paid</span>
                            <span class="fs-5 fw-bold text-success">@FormatNaira(b.TotalPaid ?? b.Amount)</span>
                        </div>
                        <span class="badge-status @statusClass">
                            <span class="badge-status-dot"></span> @b.EscrowStatus
                        </span>
                    </div>

                    <div class="row g-2 mb-3 small">
                        <div class="col-6">
                            <span class="text-muted d-block">Client</span>
                            <span class="fw-bold">@b.ClientName</span>
                            <div class="text-muted">@b.ClientEmail</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block">Assigned Worker</span>
                            @if (string.IsNullOrWhiteSpace(b.WorkerName))
                            {
                                <span class="fw-bold text-muted fst-italic">Auto-matching...</span>
                            }
                            else
                            {
                                <span class="fw-bold">@b.WorkerName</span>
                                <div class="text-muted">@b.WorkerPhone</div>
                            }
                        </div>
                        <div class="col-6 mt-2">
                            <span class="text-muted d-block">Scheduled Date</span>
                            <span class="fw-bold">@b.DateOfService.ToString("MMM d, yyyy") · @b.TimeRange</span>
                        </div>
                        <div class="col-6 mt-2">
                            <span class="text-muted d-block">Service Type</span>
                            <span class="fw-bold">@b.ServiceType</span>
                        </div>
                    </div>

                    <div class="p-2 border rounded small bg-light dark-bg-dark">
                        <span class="text-muted d-block">Address Location:</span>
                        <span>@b.Address</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Close</button>
                    <a asp-controller="Admin" asp-action="Bookings" class="btn btn-admin-primary">Full Booking Details</a>
                </div>
            </div>
        </div>
    </div>
}