@model List<Clean_Connect.Application.DTO.AdminBookingDto>
@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string FormatNaira(decimal amount) => $"₦{amount:N0}";
    var inProgress = Model.Count(b => b.Status == Clean_Connect.Domain.Enums.BookingStatus.InProgress);
    var scheduledToday = Model.Count(b => b.DateOfService.Date == DateTime.Now.Date);
    var completedToday = Model.Count(b => b.DateOfService.Date == DateTime.Now.Date && b.Status == Clean_Connect.Domain.Enums.BookingStatus.Completed);
    var cancelled = Model.Count(b => b.Status == Clean_Connect.Domain.Enums.BookingStatus.Cancelled || b.Status == Clean_Connect.Domain.Enums.BookingStatus.Rejected);
    var cancelRate = Model.Count > 0 ? (double)cancelled / Model.Count * 100d : 0d;
}

<div class="admin-page-header">
    <div class="admin-page-title-wrap">
        <h2>Bookings & Dispatch Operations</h2>
        <p>Monitor service appointments, cleaner assignments, fulfillment progress, and escrow statuses.</p>
    </div>
    <div class="admin-page-actions">
        <button class="btn btn-admin-secondary">
            <i class="fa-solid fa-download me-1"></i> Export CSV
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Total Bookings</span>
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.Count.ToString("N0")</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up"><i class="fa-solid fa-arrow-up"></i> @Model.Count(b => b.Status == Clean_Connect.Domain.Enums.BookingStatus.Completed)</span>
                <span>completed all-time</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">In Progress Now</span>
                <div class="stat-icon-wrapper stat-icon-sky">
                    <i class="fa-solid fa-person-digging"></i>
                </div>
            </div>
            <div class="stat-card-value">@inProgress</div>
            <div class="stat-card-meta">
                <span class="text-info fw-bold">Live</span>
                <span>cleaners dispatched onsite</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Scheduled Today</span>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
            <div class="stat-card-value">@scheduledToday</div>
            <div class="stat-card-meta">
                <span class="text-warning fw-bold">@completedToday completed</span>
                <span>@(scheduledToday - completedToday) remaining</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Cancellation Rate</span>
                <div class="stat-icon-wrapper stat-icon-rose">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
            </div>
            <div class="stat-card-value">@cancelRate.ToString("0.0")%</div>
            <div class="stat-card-meta">
                <span class="text-success fw-bold">@cancelled</span>
                <span>cancelled bookings</span>
            </div>
        </div>
    </div>
</div>

<div id="bookings-data">
    <!-- Filter Toolbar -->
    <div class="admin-filter-bar">
        <div class="filter-left-group">
            <div class="filter-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="filter-search-input" data-table-search="bookingsTable" placeholder="Search booking ref, client, or worker..." />
            </div>

            <select class="filter-select" data-table-filter="bookingsTable" data-filter-col="5">
                <option value="all">All Booking Statuses</option>
                <option value="Completed">Completed</option>
                <option value="In Progress">In Progress</option>
                <option value="Pending">Pending Dispatch</option>
                <option value="Cancelled">Cancelled</option>
            </select>

            <select class="filter-select" data-table-filter="bookingsTable" data-filter-col="3">
                <option value="all">All Services</option>
                @foreach (var svc in Model.Select(b => b.ServiceType).Where(s => !string.IsNullOrEmpty(s)).Distinct())
                {
                    <option value="@svc">@svc</option>
                }
            </select>

            <button class="btn btn-sm btn-admin-secondary" data-reset-filter="bookingsTable">
                <i class="fa-solid fa-filter-circle-xmark me-1"></i> Reset
            </button>
        </div>

        <div class="filter-right-group">
            <span class="results-counter" id="bookingsTable-counter">Showing @Model.Count of @Model.Count records</span>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="admin-card">
        <div class="admin-table-responsive">
            <table class="admin-table" id="bookingsTable">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Client</th>
                        <th>Cleaner</th>
                        <th>Service</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th>Total (₦)</th>
                        <th>Escrow</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-calendar-check fs-3 mb-2 d-block text-secondary"></i>
                                No bookings yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var b = Model[i];
                            var statusClass = b.Status == Clean_Connect.Domain.Enums.BookingStatus.Completed ? "badge-status-success"
                                : (b.Status == Clean_Connect.Domain.Enums.BookingStatus.Cancelled || b.Status == Clean_Connect.Domain.Enums.BookingStatus.Rejected || b.Status == Clean_Connect.Domain.Enums.BookingStatus.Expired ? "badge-status-danger"
                                : (b.Status == Clean_Connect.Domain.Enums.BookingStatus.InProgress || b.Status == Clean_Connect.Domain.Enums.BookingStatus.AwaitingClientConfirmation || b.Status == Clean_Connect.Domain.Enums.BookingStatus.AwaitingClientStartConfirmation ? "badge-status-warning"
                                : "badge-status-info"));
                            var escClass = b.EscrowStatus == "Released" ? "badge bg-success-subtle text-success border border-success-subtle"
                                : (b.EscrowStatus == "Refunded" ? "badge bg-secondary-subtle text-muted border"
                                : "badge bg-warning-subtle text-dark border border-warning-subtle");
                            var escIcon = b.EscrowStatus == "Released" ? "fa-check" : (b.EscrowStatus == "Refunded" ? "fa-arrow-rotate-left" : "fa-lock");
                            var isCancelled = b.Status == Clean_Connect.Domain.Enums.BookingStatus.Cancelled || b.Status == Clean_Connect.Domain.Enums.BookingStatus.Rejected;
                            <tr>
                                <td class="fw-bold text-primary">@b.BookingId</td>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar-initials bg-info-subtle text-info">@b.ClientInitials</div>
                                        <div class="user-details">
                                            <span class="user-name">@b.ClientName</span>
                                            <span class="user-subtext">@b.ClientLocation</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (b.IsAssigned && !string.IsNullOrWhiteSpace(b.WorkerName))
                                    {
                                        <div class="user-cell">
                                            <div class="user-avatar-initials bg-success-subtle text-success">@b.WorkerInitials</div>
                                            <div class="user-details">
                                                <span class="user-name">@b.WorkerName</span>
                                                @if (b.WorkerRating.HasValue)
                                                {
                                                    <span class="user-subtext"><i class="fa-solid fa-star text-warning"></i> @b.WorkerRating.Value.ToString("0.0")</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="user-details">
                                            <span class="badge bg-light text-muted border">Unassigned</span>
                                        </div>
                                    }
                                </td>
                                <td><span class="badge bg-secondary-subtle text-dark border">@b.ServiceType</span></td>
                                <td>
                                    <div class="small fw-semibold">@b.DateOfService.ToString("MMM d, yyyy")</div>
                                    <span class="user-subtext">@b.TimeRange</span>
                                </td>
                                <td>
                                    <span class="badge-status @statusClass">
                                        <span class="badge-status-dot"></span> @b.Status
                                    </span>
                                </td>
                                <td class="fw-bold @(isCancelled ? "text-muted text-decoration-line-through" : "text-success")">@FormatNaira(b.Amount)</td>
                                <td>
                                    <span class="@escClass">
                                        <i class="fa-solid @escIcon me-1"></i> @b.EscrowStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="table-actions justify-content-end">
                                        <button class="btn-action-icon" onclick="openBookingModal(@i)" title="View Booking">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        @if (!b.IsAssigned)
                                        {
                                            <button class="btn-action-icon text-primary" data-bs-toggle="modal" data-bs-target="#changeBookingStatusModal" title="Assign Cleaner"
                                                    data-booking-id="@b.Id" data-mode="assign">
                                                <i class="fa-solid fa-user-plus"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-action-icon" data-bs-toggle="modal" data-bs-target="#changeBookingStatusModal" title="Update Status"
                                                    data-booking-id="@b.Id" data-mode="status">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    <tr id="bookingsTable-no-results" style="display: none;">
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-magnifying-glass fs-3 mb-2 d-block text-secondary"></i>
                            No bookings match your selected criteria.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="admin-pagination-wrapper" data-paginate="bookingsTable" data-page-size="6">
            <span class="pagination-info" data-pagination-info>Showing all @Model.Count bookings</span>
            <ul class="admin-pagination" data-pagination-list></ul>
        </div>
    </div>
</div>

<!-- Empty State Container -->
<div id="bookings-empty" class="d-none">
    <div class="admin-card">
        <div class="admin-empty-state">
            <div class="empty-state-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <h4 class="empty-state-title">No Bookings Yet</h4>
            <p class="empty-state-desc">Customer appointments, cleaner dispatch statuses, and escrow payment histories will be tracked here in real-time.</p>
        </div>
    </div>
</div>

<!-- Booking Detail Modal -->
<div class="modal fade" id="bookingDetailModal" tabindex="-1" aria-labelledby="bookingDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingDetailModalLabel">
                    <i class="fa-solid fa-calendar-check text-success me-2"></i>
                    Booking Dossier
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center p-3 rounded bg-light dark-bg-dark mb-4">
                    <div>
                        <span class="small text-muted d-block">Scheduled For</span>
                        <div class="fs-6 fw-bold" id="bd-date">—</div>
                    </div>
                    <span class="badge-status badge-status-success fs-6" id="bd-status">
                        <span class="badge-status-dot"></span> —
                    </span>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Customer & Property Details</h6>
                        <div class="small">
                            <div class="fw-bold fs-6" id="bd-client">—</div>
                            <div class="text-muted mb-2" id="bd-client-contact">—</div>
                            <div class="p-2 border rounded bg-white dark-bg-card">
                                <span class="text-muted d-block">Address Location:</span>
                                <div id="bd-address">—</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Assigned Cleaner & Financial Breakdown</h6>
                        <div class="small">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="user-avatar-initials bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" id="bd-worker-initials" style="width: 38px; height: 38px;"></div>
                                <div>
                                    <div class="fw-bold" id="bd-worker">—</div>
                                    <div class="text-muted" id="bd-worker-contact">—</div>
                                </div>
                            </div>

                            <div class="p-3 border rounded bg-white dark-bg-card">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Customer Paid Gross:</span>
                                    <span class="fw-bold" id="bd-gross">—</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1 text-muted">
                                    <span>Clean Connect Commission:</span>
                                    <span id="bd-commission">—</span>
                                </div>
                                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                    <span class="fw-bold text-success">Worker Net Payout:</span>
                                    <span class="fw-bold text-success fs-6" id="bd-net">—</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Change Status / Assign Cleaner Modal -->
<div class="modal fade" id="changeBookingStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changeBookingStatusModalTitle">
                    <i class="fa-solid fa-sliders text-success me-2"></i>
                    Update Booking Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="chgBookingId" />

                <!-- Assign Cleaner mode -->
                <div id="assignCleanerSection" class="d-none">
                    <div class="mb-3">
                        <label class="form-label">Available Cleaners</label>
                        <select class="form-select" id="chgWorkerSelect">
                            @foreach (var w in (List<Clean_Connect.Domain.Entities.Worker>?)ViewBag.Workers ?? new List<Clean_Connect.Domain.Entities.Worker>())
                            {
                                <option value="@w.Id">@(w.FullName?.ToString() ?? "Cleaner") — @(w.ServiceType?.Name ?? "General")</option>
                            }
                        </select>
                    </div>
                    <div class="alert alert-light border small mb-1">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Assigning a cleaner is only allowed while the booking is still pending.
                    </div>
                </div>

                <!-- Update status mode -->
                <div id="updateStatusSection">
                    <div class="mb-3">
                        <label class="form-label">Change Status</label>
                        <select class="form-select" id="chgStatusSelect">
                            <option value="InProgress">Mark In Progress</option>
                            <option value="Completed">Completed &amp; Release Escrow</option>
                            <option value="Expired">Mark Expired</option>
                            <option value="Refund">Issue Refund</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin Reason / Override Log</label>
                        <textarea class="form-control" id="chgReason" rows="2" placeholder="Document reason for manual status override..."></textarea>
                    </div>
                </div>

                <div id="chgFeedback"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-admin-primary" id="chgApplyBtn">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="chgApplySpinner"></span>
                    Apply Update
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const bookingsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));

        function openBookingModal(index) {
            const b = bookingsData[index];
            if (!b) return;
            document.getElementById('bookingDetailModalLabel').textContent = 'Booking Dossier: ' + b.bookingId;
            document.getElementById('bd-date').textContent = new Date(b.dateOfService).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' at ' + b.timeRange;
            document.getElementById('bd-status').innerHTML = '<span class="badge-status-dot"></span> ' + b.status;
            document.getElementById('bd-client').textContent = b.clientName;
            document.getElementById('bd-client-contact').textContent = (b.clientPhone ? b.clientPhone + ' | ' : '') + b.clientEmail;
            document.getElementById('bd-address').textContent = b.address || '—';
            document.getElementById('bd-worker').textContent = b.workerName || 'Unassigned';
            document.getElementById('bd-worker-initials').textContent = b.workerInitials || '—';
            document.getElementById('bd-worker-contact').textContent = b.workerPhone || '';
            document.getElementById('bd-gross').textContent = '\u20A6' + b.amount.toLocaleString();
            document.getElementById('bd-commission').textContent = '-\u20A6' + b.commission.toLocaleString();
            document.getElementById('bd-net').textContent = '\u20A6' + b.workerNetPayout.toLocaleString();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('bookingDetailModal')).show();
        }

        /* ---- Assign Cleaner / Update Status modal ---- */
        const chgModalEl     = document.getElementById('changeBookingStatusModal');
        const chgBookingEl  = document.getElementById('chgBookingId');
        const chgStatusSel  = document.getElementById('chgStatusSelect');
        const chgWorkerSel  = document.getElementById('chgWorkerSelect');
        const chgReasonEl   = document.getElementById('chgReason');
        const chgFeedbackEl = document.getElementById('chgFeedback');
        const chgApplyBtn   = document.getElementById('chgApplyBtn');
        const chgSpinner    = document.getElementById('chgApplySpinner');
        const chgTitle      = document.getElementById('changeBookingStatusModalTitle');
        const assignSection = document.getElementById('assignCleanerSection');
        const statusSection = document.getElementById('updateStatusSection');
        const chgToken      = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let chgMode = 'status';

        chgModalEl.addEventListener('show.bs.modal', function (e) {
            const trigger = e.relatedTarget;
            chgBookingEl.value = trigger.getAttribute('data-booking-id') || '';
            chgMode = trigger.getAttribute('data-mode') || 'status';
            chgReasonEl.value = '';
            chgFeedbackEl.innerHTML = '';

            if (chgMode === 'assign') {
                chgTitle.innerHTML = '<i class="fa-solid fa-user-plus text-success me-2"></i> Assign Cleaner';
                chgApplyBtn.textContent = 'Assign Cleaner';
                assignSection.classList.remove('d-none');
                statusSection.classList.add('d-none');
            } else {
                chgTitle.innerHTML = '<i class="fa-solid fa-sliders text-success me-2"></i> Update Booking Status';
                chgApplyBtn.textContent = 'Apply Update';
                assignSection.classList.add('d-none');
                statusSection.classList.remove('d-none');
            }
        });

        chgApplyBtn.addEventListener('click', function () {
            const bookingId = chgBookingEl.value;
            if (!bookingId) return;

            const bodyArr = [];
            let endpoint;
            if (chgMode === 'assign') {
                endpoint = '/Admin/Bookings/' + bookingId + '/Assign';
                bodyArr.push('workerId=' + encodeURIComponent(chgWorkerSel.value));
            } else {
                endpoint = '/Admin/Bookings/' + bookingId + '/Status';
                bodyArr.push('status=' + encodeURIComponent(chgStatusSel.value));
                bodyArr.push('reason=' + encodeURIComponent(chgReasonEl.value));
            }

            chgSpinner.classList.remove('d-none');
            chgApplyBtn.disabled = true;

            fetch(endpoint, {
                method: 'POST',
                headers: { 'RequestVerificationToken': chgToken, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: bodyArr.join('&'),
                credentials: 'same-origin'
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    chgSpinner.classList.add('d-none');
                    chgApplyBtn.disabled = false;
                    if (res.ok) {
                        chgFeedbackEl.innerHTML = '<div class="alert alert-success py-2 mb-0">' + (res.message || 'Update applied') + ' — reloading...</div>';
                        setTimeout(function () { location.reload(); }, 500);
                    } else {
                        chgFeedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-0">' + (res.message || 'An error occurred.') + '</div>';
                    }
                })
                .catch(function () {
                    chgSpinner.classList.add('d-none');
                    chgApplyBtn.disabled = false;
                    chgFeedbackEl.innerHTML = '<div class="alert alert-danger py-2 mb-0">Network error. Please try again.</div>';
                });
        });
    </script>
}