@model List<Clean_Connect.Application.DTO.AdminWorkerDto>
@{
    ViewData["Title"] = "Workers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var verifiedCount = Model.Count(w => w.KycStatus == "Verified");
    var availableCount = Model.Count(w => w.Availability == "Available");
    var verifiedRate = Model.Count > 0 ? (double)verifiedCount / Model.Count * 100d : 0d;
    var availableRate = Model.Count > 0 ? (double)availableCount / Model.Count * 100d : 0d;
}

<div class="admin-page-header">
    <div class="admin-page-title-wrap">
        <h2>Service Providers & Workers</h2>
        <p>Manage verified cleaners, KYC document validation, ratings, and job availability.</p>
    </div>
    <div class="admin-page-actions">
        <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#workerVerificationModal">
            <i class="fa-solid fa-id-card-clip me-1"></i> Review KYC Queue
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Total Cleaners</span>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.Count.ToString("N0")</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-up"><i class="fa-solid fa-arrow-up"></i> @Model.Count</span>
                <span>registered workers</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Verified Pros</span>
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
            </div>
            <div class="stat-card-value">@verifiedCount</div>
            <div class="stat-card-meta">
                <span class="text-success fw-bold">@verifiedRate.ToString("0.0")%</span>
                <span>fully vetted & approved</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Registered This Month</span>
                <div class="stat-icon-wrapper stat-icon-sky">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
            </div>
            <div class="stat-card-value">@Model.Count(w => w.DateJoined.Month == DateTime.Now.Month && w.DateJoined.Year == DateTime.Now.Year)</div>
            <div class="stat-card-meta">
                <span class="trend-badge trend-badge-neutral">new</span>
                <span>this month</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">Available Today</span>
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i class="fa-solid fa-signal"></i>
                </div>
            </div>
            <div class="stat-card-value">@availableCount</div>
            <div class="stat-card-meta">
                <span class="text-success fw-bold">@availableRate.ToString("0.0")%</span>
                <span>ready for dispatch</span>
            </div>
        </div>
    </div>
</div>

<div id="workers-data">
    <!-- Filter Toolbar -->
    <div class="admin-filter-bar">
        <div class="filter-left-group">
            <div class="filter-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="filter-search-input" data-table-search="workersTable" placeholder="Search cleaner by name, skill, or ID..." />
            </div>

            <select class="filter-select" data-table-filter="workersTable" data-filter-col="5">
                <option value="all">All KYC Statuses</option>
                <option value="verified">Verified</option>
                <option value="pending">Pending KYC</option>
                <option value="suspended">Suspended</option>
            </select>

            <select class="filter-select" data-table-filter="workersTable" data-filter-col="3">
                <option value="all">All Services</option>
                @foreach (var service in Model.Select(w => w.Specialty).Where(s => !string.IsNullOrEmpty(s)).Distinct())
                {
                    <option value="@service">@service</option>
                }
            </select>

            <select class="filter-select" data-table-filter="workersTable" data-filter-col="6">
                <option value="all">All Availability</option>
                <option value="Available">Available</option>
                <option value="On Job">On Job</option>
                <option value="Off-Duty">Off-Duty</option>
            </select>

            <button class="btn btn-sm btn-admin-secondary" data-reset-filter="workersTable">
                <i class="fa-solid fa-filter-circle-xmark me-1"></i> Reset
            </button>
        </div>

        <div class="filter-right-group">
            <span class="results-counter" id="workersTable-counter">Showing @Model.Count of @Model.Count records</span>
        </div>
    </div>

    <!-- Workers Data Table -->
    <div class="admin-card">
        <div class="admin-table-responsive">
            <table class="admin-table" id="workersTable">
                <thead>
                    <tr>
                        <th>Worker</th>
                        <th>Rating</th>
                        <th>Phone / Email</th>
                        <th>Specialty</th>
                        <th>Jobs</th>
                        <th>KYC Status</th>
                        <th>Availability</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-gear fs-3 mb-2 d-block text-secondary"></i>
                                No workers in the directory yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var w = Model[i];
                            var kyClass = w.KycStatus == "Verified" ? "badge-status-success" : (w.KycStatus == "Suspended" ? "badge-status-danger" : "badge-status-warning");
                            var avClass = w.Availability == "Available" ? "badge-status-success" : (w.Availability == "On Job" ? "badge-status-warning" : "badge-status-neutral");
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar-initials bg-warning-subtle text-warning">@w.Initials</div>
                                        <div class="user-details">
                                            <span class="user-name">@w.Name</span>
                                            <span class="user-subtext">ID: @string.Concat("#WK-", w.Id.ToString("N").Substring(0, 4).ToUpper())</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (w.AverageRating.HasValue)
                                    {
                                        <div class="d-flex align-items-center gap-1 text-warning fw-bold">
                                            <i class="fa-solid fa-star"></i>
                                            <span>@w.AverageRating.Value.ToString("0.0")</span>
                                            <span class="text-muted small fw-normal">(@w.RatingCount)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-1 text-muted fw-bold">
                                            <i class="fa-regular fa-star"></i>
                                            <span>New</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="user-details">
                                        <span class="small fw-semibold">@w.Phone</span>
                                        <span class="user-subtext">@w.Email</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border me-1">@w.Specialty</span>
                                </td>
                                <td><span class="fw-bold">@w.CompletedJobs</span> completed</td>
                                <td>
                                    <span class="badge-status @kyClass">
                                        <span class="badge-status-dot"></span> @w.KycStatus
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status @avClass">
                                        <span class="badge-status-dot"></span> @w.Availability
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="table-actions justify-content-end">
                                        <button class="btn-action-icon" onclick="openWorkerModal(@i)" title="View Profile">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button class="btn-action-icon" data-bs-toggle="modal" data-bs-target="#workerVerificationModal" title="Verify KYC">
                                            <i class="fa-solid fa-id-card"></i>
                                        </button>
                                        <button class="btn-action-icon text-danger" title="Suspend Worker">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    <tr id="workersTable-no-results" style="display: none;">
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-magnifying-glass fs-3 mb-2 d-block text-secondary"></i>
                            No service workers match your search or filter parameters.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="admin-pagination-wrapper" data-paginate="workersTable" data-page-size="6">
            <span class="pagination-info" data-pagination-info>Showing all @Model.Count registered workers</span>
            <ul class="admin-pagination" data-pagination-list></ul>
        </div>
    </div>
</div>

<!-- Empty State Container -->
<div id="workers-empty" class="d-none">
    <div class="admin-card">
        <div class="admin-empty-state">
            <div class="empty-state-icon">
                <i class="fa-solid fa-users-gear"></i>
            </div>
            <h4 class="empty-state-title">No Workers in Directory</h4>
            <p class="empty-state-desc">As cleaners submit applications and upload their identification, their profiles will populate here for vetting.</p>
            <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#workerVerificationModal">
                <i class="fa-solid fa-plus me-1"></i> Review Verification Queue
            </button>
        </div>
    </div>
</div>

<!-- Worker Verification Modal (KYC Review) -->
<div class="modal fade" id="workerVerificationModal" tabindex="-1" aria-labelledby="workerVerificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="workerVerificationModalLabel">
                    <i class="fa-solid fa-shield-halved text-warning me-2"></i>
                    KYC Document Verification
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>KYC document management is coming soon. Worker profiles are listed for vetting.</span>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Worker Profile Modal -->
<div class="modal fade" id="workerProfileModal" tabindex="-1" aria-labelledby="workerProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="workerProfileModalLabel">
                    <i class="fa-solid fa-user-gear text-success me-2"></i>
                    Worker Profile
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="user-avatar-initials bg-warning-subtle text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold" id="wp-initials" style="width: 100px; height: 100px; font-size: 2rem; border: 3px solid #10b981;"></div>
                <h5 class="fw-bold mb-1" id="wp-name">—</h5>
                <div class="text-warning mb-2" id="wp-rating">—</div>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge-status badge-status-success" id="wp-kyc">Verified Pro</span>
                    <span class="badge-status badge-status-success" id="wp-avail">Available for Jobs</span>
                </div>
                <div class="row g-2 text-start p-3 bg-light dark-bg-dark rounded small">
                    <div class="col-6">
                        <span class="text-muted d-block">Completed Jobs:</span>
                        <span class="fw-bold" id="wp-jobs">—</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Payout Balance:</span>
                        <span class="fw-bold text-success" id="wp-balance">₦0</span>
                    </div>
                    <div class="col-6 mt-2">
                        <span class="text-muted d-block">Primary City:</span>
                        <span class="fw-bold" id="wp-city">—</span>
                    </div>
                    <div class="col-6 mt-2">
                        <span class="text-muted d-block">Join Date:</span>
                        <span class="fw-bold" id="wp-joined">—</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const workersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));

        function openWorkerModal(index) {
            const w = workersData[index];
            if (!w) return;
            document.getElementById('wp-name').textContent = w.name;
            document.getElementById('wp-initials').textContent = w.initials;
            const ratingEl = document.getElementById('wp-rating');
            if (w.averageRating) {
                ratingEl.innerHTML = '<i class="fa-solid fa-star"></i> ' + w.averageRating.toFixed(1) + ' <span class="text-dark dark-text-light fw-bold ms-1">' + w.averageRating.toFixed(1) + '</span> (' + w.ratingCount + ' ratings)';
            } else {
                ratingEl.innerHTML = '<span class="text-muted fw-bold">New Worker</span>';
            }
            document.getElementById('wp-jobs').textContent = w.completedJobs + ' cleanings';
            document.getElementById('wp-balance').textContent = '\u20A6' + w.balance.toLocaleString();
            document.getElementById('wp-city').textContent = w.city || '—';
            document.getElementById('wp-joined').textContent = new Date(w.dateJoined).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            document.getElementById('wp-kyc').textContent = w.kycStatus;
            document.getElementById('wp-avail').textContent = w.availability === 'Available' ? 'Available for Jobs' : w.availability;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('workerProfileModal')).show();
        }
    </script>
}