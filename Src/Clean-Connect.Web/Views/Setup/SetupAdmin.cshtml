@model Clean_Connect.Application.DTO.SetupAdminDto
@{
    ViewData["Title"] = "Admin Setup";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">

    <!-- LEFT SIDE -->
    <div class="auth-left">

        <div class="overlay"></div>

        <div class="left-content" data-aos="fade-right">

            <div class="brand">

                <i class="fa-solid fa-broom"></i>

                <h1>Clean Connect</h1>

            </div>

            <h2>Create the Platform Administrator.</h2>

            <p>
                This one-time page bootstraps the first admin account for
                Clean Connect. It is hidden and locks itself once an
                administrator exists.
            </p>

        </div>

    </div>

    <!-- RIGHT SIDE -->

    <div class="auth-right">

        <div class="login-card shadow-lg" data-aos="fade-left">

            <div class="text-center mb-4">

                <h2 class="fw-bold">First-Time Setup 🔐</h2>

                <p class="text-muted">
                    Enter your admin setup key and secure credentials
                </p>

            </div>

            <form asp-action="SetupAdmin"
                  asp-controller="Setup"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- SETUP KEY -->

                <div class="mb-4">

                    <label asp-for="SetupKey"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fa-solid fa-key"></i>

                        </span>

                        <input asp-for="SetupKey"
                               class="form-control"
                               placeholder="Admin setup key"
                               type="password" />

                    </div>

                    <span asp-validation-for="SetupKey"
                          class="text-danger">
                    </span>

                </div>

                <!-- EMAIL -->

                <div class="mb-4">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fa-solid fa-envelope"></i>

                        </span>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Admin email address" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- PASSWORD -->

                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fa-solid fa-lock"></i>

                        </span>

                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Password (min 8 characters)"
                               type="password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- CONFIRM PASSWORD -->

                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fa-solid fa-lock"></i>

                        </span>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm password"
                               type="password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <!-- CREATE -->

                <button type="submit"
                        class="btn btn-success w-100 login-btn">

                    <i class="fa-solid fa-shield-halved me-2"></i>

                    Create Administrator

                </button>

            </form>

            <div class="text-center mt-4 text-muted small">

                This page is available only while no administrators exist.

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}