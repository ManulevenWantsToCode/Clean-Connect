@model IEnumerable<Clean_Connect.Application.DTO.ServiceTypeDto>

@{
    ViewData["Title"] = "Service Types";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-card">

    <!-- ===========================
        PAGE HEADER
    ============================ -->

    <div class="page-header">

        <div>

            <h2>

                <i class="fa-solid fa-broom text-success me-2"></i>

                Service Types

            </h2>

            <p class="text-muted">

                Manage all cleaning services available on Clean Connect.

            </p>

        </div>

        <a asp-action="CreateServiceType"
           class="btn btn-success">

            <i class="fa-solid fa-plus me-2"></i>

            New Service

        </a>

    </div>

    <!-- ===========================
        SEARCH BAR
    ============================ -->

    <div class="row mb-4">

        <div class="col-lg-6">

            <div class="input-group">

                <span class="input-group-text">

                    <i class="fa-solid fa-magnifying-glass"></i>

                </span>

                <input type="text"
                       id="serviceSearchInput"
                       class="form-control"
                       placeholder="Search service type..." />

            </div>

        </div>

    </div>

    @if (Model.Any())
    {

        <div class="table-responsive">

            <table class="table align-middle" id="serviceTypeTable">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Service</th>

                        <th>Description</th>

                        <th>Default Price</th>

                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @{

                        int count = 1;

                    }

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td>

                                @count

                            </td>

                            <td>

                                <div class="fw-bold service-name-cell">

                                    @item.Name

                                </div>

                            </td>

                            <td>

                                @item.Description

                            </td>

                            <td>

                                <span class="badge bg-success">

                                    ₦@item.Amount.ToString("N2")

                                </span>

                            </td>

                            <td>

                                <div class="action-buttons justify-content-center">

                                    <a asp-action="UpdateServiceType"
                                       class="edit"
                                       title="Edit Service Type">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>

                        count++;

                    }

                </tbody>

            </table>

        </div>

    }
    else
    {

        <!-- ===========================
            EMPTY STATE
        ============================ -->

        <div class="text-center py-5">

            <div class="mb-4">

                <i class="fa-solid fa-broom fa-5x text-success opacity-50"></i>

            </div>

            <h3>

                No Service Types Yet

            </h3>

            <p class="text-muted">

                Create your first service type to allow workers register under it.

            </p>

            <a asp-action="CreateServiceType"
               class="btn btn-success mt-3">

                <i class="fa-solid fa-plus me-2"></i>

                Create First Service

            </a>

        </div>

    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("serviceSearchInput");
            const table = document.getElementById("serviceTypeTable");

            if (searchInput && table) {
                searchInput.addEventListener("input", function () {
                    const filter = searchInput.value.toLowerCase().trim();
                    const rows = table.querySelectorAll("tbody tr");

                    rows.forEach(function (row) {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
        });
    </script>
}