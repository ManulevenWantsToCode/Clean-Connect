@model IEnumerable<Clean_Connect.Application.DTO.ServiceTypeDto>

@{
    ViewData["Title"] = "Service Types";
    ViewData["ActivePage"] = "ServiceTypes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="admin-page-title-wrap">
        <h2>
            <i class="fa-solid fa-broom text-success me-2"></i>
            Service Types
        </h2>
        <p>Manage all cleaning services available on Clean Connect.</p>
    </div>
    <div class="admin-page-actions">
        <a asp-action="CreateServiceType" class="btn btn-admin-primary">
            <i class="fa-solid fa-plus me-1"></i> New Service
        </a>
    </div>
</div>

<div class="data-table-card">
    <div class="data-table-header">
        <div class="search-input-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="serviceSearchInput" placeholder="Search service type by name or description..." />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle" id="serviceTypeTable">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th style="width: 260px;">Service Name</th>
                        <th>Description</th>
                        <th class="text-center" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted fw-semibold">@count</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill p-2">
                                        <i class="fa-solid fa-broom"></i>
                                    </span>
                                    <span class="fw-bold text-dark">@item.Name</span>
                                </div>
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <a asp-action="UpdateServiceType" class="table-action-btn edit" title="Edit Service Type">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="admin-empty-state text-center py-5">
            <div class="empty-icon-wrap mb-3">
                <i class="fa-solid fa-broom fa-3x text-muted opacity-50"></i>
            </div>
            <h4>No Service Types Yet</h4>
            <p class="text-muted">Create your first service type to allow workers to register under it.</p>
            <a asp-action="CreateServiceType" class="btn btn-admin-primary mt-3">
                <i class="fa-solid fa-plus me-2"></i> Create First Service
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("serviceSearchInput");
            const table = document.getElementById("serviceTypeTable");

            if (searchInput && table) {
                searchInput.addEventListener("input", function () {
                    const filter = searchInput.value.toLowerCase().trim();
                    const rows = table.querySelectorAll("tbody tr");

                    rows.forEach(function (row) {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
        });
    </script>
}