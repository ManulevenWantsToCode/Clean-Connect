@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard">

    <!-- Summary Cards -->

    <div class="row g-4">

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-users"></i>

                <h2>124</h2>

                <p>Workers</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-user-group"></i>

                <h2>86</h2>

                <p>Clients</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-calendar-check"></i>

                <h2>312</h2>

                <p>Bookings</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-naira-sign"></i>

                <h2>₦2.3M</h2>

                <p>Total Revenue</p>

            </div>

        </div>

    </div>

</div>