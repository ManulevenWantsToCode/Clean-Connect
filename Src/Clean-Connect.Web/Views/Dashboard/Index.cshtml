@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard">

    <!-- Summary Cards -->

    <div class="row g-4">

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-users"></i>

                <h2>124</h2>

                <p>Workers</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-user-group"></i>

                <h2>86</h2>

                <p>Clients</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-calendar-check"></i>

                <h2>312</h2>

                <p>Bookings</p>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="dashboard-card">

                <i class="fa-solid fa-naira-sign"></i>

                <h2>₦2.3M</h2>

                <p>Total Revenue</p>

            </div>

        </div>

        <hr class="my-5" />

        <div class="row g-4">

            <!-- Quick Actions -->

            <div class="col-lg-4">

                <div class="page-card h-100">

                    <h4 class="mb-4">

                        <i class="fa-solid fa-bolt text-success me-2"></i>

                        Quick Actions

                    </h4>

                    <div class="d-grid gap-3">

                        <a asp-controller="ServiceType"
                           asp-action="Index"
                           class="btn btn-success">

                            <i class="fa-solid fa-broom me-2"></i>

                            Manage Service Types

                        </a>

                        <a href="#"
                           class="btn btn-outline-primary">

                            <i class="fa-solid fa-users me-2"></i>

                            View Workers

                        </a>

                        <a href="#"
                           class="btn btn-outline-secondary">

                            <i class="fa-solid fa-user-group me-2"></i>

                            View Clients

                        </a>

                    </div>

                </div>

            </div>

            <!-- Recent Activity -->

            <div class="col-lg-4">

                <div class="page-card h-100">

                    <h4 class="mb-4">

                        <i class="fa-solid fa-clock-rotate-left text-success me-2"></i>

                        Recent Activity

                    </h4>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">

                            New worker registered.

                        </li>

                        <li class="list-group-item">

                            New client created.

                        </li>

                        <li class="list-group-item">

                            Booking completed.

                        </li>

                        <li class="list-group-item">

                            Service type updated.

                        </li>

                    </ul>

                </div>

            </div>

            <!-- System Information -->

            <div class="col-lg-4">

                <div class="page-card h-100">

                    <h4 class="mb-4">

                        <i class="fa-solid fa-circle-info text-success me-2"></i>

                        System Information

                    </h4>

                    <table class="table table-borderless mb-0">

                        <tr>

                            <td>Application</td>

                            <td><strong>Clean Connect</strong></td>

                        </tr>

                        <tr>

                            <td>Version</td>

                            <td>1.0.0</td>

                        </tr>

                        <tr>

                            <td>Status</td>

                            <td>

                                <span class="badge bg-success">

                                    Running

                                </span>

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>