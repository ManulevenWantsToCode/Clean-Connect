@model Clean_Connect.Application.DTO.BookingDto
@using Clean_Connect.Web.Helpers

@{
    ViewData["Title"] = "Booking Details";
    Layout = "_DashboardLayout";

    var statusLabel = BookingStatusHelper.BookingLabel(Model.BookingStatus);
    var statusTone = BookingStatusHelper.BookingTone(Model.BookingStatus);
    var paymentLabel = BookingStatusHelper.PaymentLabel(Model.PaymentStatus);
    var paymentTone = BookingStatusHelper.PaymentTone(Model.PaymentStatus);
    var step = BookingStatusHelper.FlowStep(Model.BookingStatus);
    var isPending = string.Equals(Model.BookingStatus, "Pending", StringComparison.OrdinalIgnoreCase);
    var isPaid = string.Equals(Model.BookingStatus, "MarkAsPaid", StringComparison.OrdinalIgnoreCase);
    var isAwaitingStart = string.Equals(Model.BookingStatus, "AwaitingClientStartConfirmation", StringComparison.OrdinalIgnoreCase);
    var isInProgress = string.Equals(Model.BookingStatus, "InProgress", StringComparison.OrdinalIgnoreCase);
    var isAwaitingConfirm = string.Equals(Model.BookingStatus, "AwaitingClientConfirmation", StringComparison.OrdinalIgnoreCase);
    var isCompleted = string.Equals(Model.BookingStatus, "Completed", StringComparison.OrdinalIgnoreCase);
    var isExpired = string.Equals(Model.BookingStatus, "Expired", StringComparison.OrdinalIgnoreCase);
    var isResolved = string.Equals(Model.BookingStatus, "Rejected", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.BookingStatus, "Cancelled", StringComparison.OrdinalIgnoreCase)
        || isExpired;

    var steps = new[] { "Requested", "Accepted", "Payment", "In Progress", "Completed" };
}

<div class="dash-page booking-workflow-page">
    <div class="container">
        <a asp-controller="Booking" asp-action="Responses" class="booking-back-link mb-4">
            <i class="fa-solid fa-arrow-left"></i>
            Back to bookings
        </a>

        <div class="booking-hero booking-hero--detail">
            <div>
                <span class="booking-kicker">
                    <i class="fa-solid fa-broom"></i>
                    Booking Details
                </span>
                <h1>@Model.ServiceName</h1>
                <p>Client @Model.ClientName requested this service for @Model.DateOfService.ToString("MMM dd, yyyy").</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="status-badge tone-@statusTone">@statusLabel</span>
                <span class="status-badge tone-@paymentTone">@paymentLabel</span>
            </div>
        </div>

        <div class="booking-flow-progress mb-4">
            <div class="client-flow-card">
<div class="client-flow-card__top">
                        <div class="client-flow-card__icon @(isPending ? "warning" : isResolved ? "danger" : "success")">
                            <i class="fa-solid @(isPending ? "fa-envelope" : isResolved ? "fa-ban" : "fa-circle-check")"></i>
                        </div>
                        <div>
                            <h2>@(isPending ? "Awaiting your response" : isResolved ? (isExpired ? "Booking expired" : "Booking closed") : "Job progress")</h2>
                            <p>@(isPending ? "Review the request below before accepting or declining." : isResolved ? "You no longer need to act on this booking." : "Here's where this job stands.")</p>
                        </div>
                    </div>

                @if (!isResolved)
                {
                    <div class="client-flow-steps">
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            var done = i < step;
                            var current = i == step;
                            <div class="client-flow-step @(done ? "is-done" : "") @(current ? "is-current" : "")">
                                <span>
                                    @if (done) { <i class="fa-solid fa-check"></i> }
                                    else { <i class="fa-solid @(steps[i] switch { "Requested" => "fa-paper-plane", "Accepted" => "fa-handshake", "Payment" => "fa-credit-card", "In Progress" => "fa-hammer", _ => "fa-flag-checkered" })"></i> }
                                </span>
                                <strong>@steps[i]</strong>
                                <small>@(i == 0 ? "Request placed" : i == 1 ? "Worker accepted" : i == 2 ? "Payment secured" : i == 3 ? "Worker on the job" : "Service finished")</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <article class="client-flow-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon green">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <h2>@Model.ClientName</h2>
                            <p>@Model.ServiceName</p>
                        </div>
                    </div>

                    <div class="booking-response-card__details booking-flow-details flex-wrap">
                        <span><i class="fa-solid fa-calendar"></i>Service Date: @Model.DateOfService.ToString("MMM dd, yyyy")</span>
                        <span><i class="fa-solid fa-clock"></i>@Model.TimeRange</span>
                        <span><i class="fa-solid fa-wallet"></i>&#8358;@Model.Amount.ToString("N0")</span>
                        <span><i class="fa-solid fa-location-dot"></i>@Model.Address</span>
                    </div>

                    <div class="client-flow-card__footer">
                        <span class="booking-response-note">
                            @if (isPending)
                            {
                                <text><i class="fa-solid fa-inbox me-2"></i>Respond to this request to confirm availability.</text>
                            }
                            else if (isPaid)
                            {
                                <text><i class="fa-solid fa-play me-2"></i>Client has paid. Request to start the job when you arrive.</text>
                            }
                            else if (isAwaitingStart)
                            {
                                <text><i class="fa-solid fa-hourglass-half me-2"></i>Start request sent. Waiting for the client to confirm the job is in progress.</text>
                            }
                            else if (isInProgress)
                            {
                                <text><i class="fa-solid fa-hammer me-2"></i>Job is in progress. Mark it done when you finish.</text>
                            }
                            else if (isAwaitingConfirm)
                            {
                                <text><i class="fa-solid fa-hourglass-half me-2"></i>Job finished. Waiting for the client to confirm.</text>
                            }
                            else if (isCompleted)
                            {
                                <text><i class="fa-solid fa-circle-check me-2"></i>Job completed and payment released. Great work!</text>
                            }
                            else if (isExpired)
                            {
                                <text><i class="fa-solid fa-calendar-xmark me-2"></i>This booking expired because the service date passed before it was completed.</text>
                            }
                            else
                            {
                                <text><i class="fa-solid fa-circle-check me-2"></i>Your response has been recorded.</text>
                            }
                        </span>

                        @if (isPending)
                        {
                            <div class="booking-response-actions">
                                <form asp-action="Reject" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                        <i class="fa-solid fa-xmark me-2"></i>Decline
                                    </button>
                                </form>
                                <form asp-action="Accept" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success rounded-pill px-4">
                                        <i class="fa-solid fa-check me-2"></i>Accept
                                    </button>
                                </form>
                            </div>
                        }
                        else if (isPaid)
                        {
                            <form asp-action="StartJob" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success rounded-pill px-4">
                                    <i class="fa-solid fa-play me-2"></i>Request to Start
                                </button>
                            </form>
                        }
                        else if (isInProgress)
                        {
                            <form asp-action="CompleteJob" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success rounded-pill px-4">
                                    <i class="fa-solid fa-flag-checkered me-2"></i>Mark as Done
                                </button>
                            </form>
                        }
                    </div>
                </article>
            </div>

            <div class="col-lg-4">
                <article class="client-flow-card request-summary-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon neutral">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div>
                            <h2>Request Summary</h2>
                            <p class="small text-muted mb-0">Booking breakdown & details</p>
                        </div>
                    </div>

                    <div class="booking-review-list">
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-user text-muted me-2"></i>Client</span>
                            <strong>@Model.ClientName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-broom text-muted me-2"></i>Service</span>
                            <strong>@Model.ServiceName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-check text-muted me-2"></i>Requested on</span>
                            <strong>@Model.BookingDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-days text-muted me-2"></i>Service date</span>
                            <strong>@Model.DateOfService.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-clock text-muted me-2"></i>Time slot</span>
                            <strong>@Model.TimeRange</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-tag text-muted me-2"></i>Status</span>
                            <strong><span class="status-badge tone-@statusTone">@statusLabel</span></strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-credit-card text-muted me-2"></i>Payment</span>
                            <strong><span class="status-badge tone-@paymentTone">@paymentLabel</span></strong>
                        </div>
                    </div>

                    <div class="request-summary-price-box">
                        <span class="request-summary-price-label">Total Amount</span>
                        <strong class="request-summary-price-value">&#8358;@Model.Amount.ToString("N0")</strong>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>