@model Clean_Connect.Application.DTO.BookingDto
@using Clean_Connect.Web.Helpers

@{
    ViewData["Title"] = "Booking Request Details";
    Layout = "_DashboardLayout";

    var statusLabel = BookingStatusHelper.BookingLabel(Model.BookingStatus);
    var statusTone = BookingStatusHelper.BookingTone(Model.BookingStatus);
    var paymentLabel = BookingStatusHelper.PaymentLabel(Model.PaymentStatus);
    var paymentTone = BookingStatusHelper.PaymentTone(Model.PaymentStatus);
    var step = BookingStatusHelper.FlowStep(Model.BookingStatus);
    var isPending = string.Equals(Model.BookingStatus, "Pending", StringComparison.OrdinalIgnoreCase);
    var isPaid = string.Equals(Model.BookingStatus, "MarkAsPaid", StringComparison.OrdinalIgnoreCase);
    var isAwaitingStart = string.Equals(Model.BookingStatus, "AwaitingClientStartConfirmation", StringComparison.OrdinalIgnoreCase);
    var isInProgress = string.Equals(Model.BookingStatus, "InProgress", StringComparison.OrdinalIgnoreCase);
    var isAwaitingConfirm = string.Equals(Model.BookingStatus, "AwaitingClientConfirmation", StringComparison.OrdinalIgnoreCase);
    var isCompleted = string.Equals(Model.BookingStatus, "Completed", StringComparison.OrdinalIgnoreCase);
    var isExpired = string.Equals(Model.BookingStatus, "Expired", StringComparison.OrdinalIgnoreCase);
    var isRejected = string.Equals(Model.BookingStatus, "Rejected", StringComparison.OrdinalIgnoreCase);
    var isCancelled = string.Equals(Model.BookingStatus, "Cancelled", StringComparison.OrdinalIgnoreCase);
    var isResolved = isRejected || isCancelled || isExpired;

    var steps = new[] { "Requested", "Accepted", "Payment", "In Progress", "Completed" };
}

<div class="dash-page booking-workflow-page">
    <div class="container">
        <!-- Back Link -->
        <a asp-controller="Booking" asp-action="Responses" class="booking-back-link mb-4">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to incoming bookings</span>
        </a>

        <!-- Hero Section -->
        <div class="booking-hero booking-hero--detail">
            <div>
                <span class="booking-kicker">
                    <i class="fa-solid fa-broom"></i>
                    Booking Request #@Model.Id.ToString().Substring(0, 8).ToUpper()
                </span>
                <h1>@Model.ServiceName</h1>
                <p>Client <strong>@Model.ClientName</strong> requested your services for @Model.DateOfService.ToString("dddd, MMM dd, yyyy").</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="status-badge tone-@statusTone">@statusLabel</span>
                <span class="status-badge tone-@paymentTone">@paymentLabel</span>
            </div>
        </div>

        <!-- Flow Progress -->
        <div class="booking-flow-progress mb-4">
            <div class="client-flow-card">
                <div class="client-flow-card__top">
                    <div class="client-flow-card__icon @(isPending ? "warning" : isResolved ? "danger" : "success")">
                        <i class="fa-solid @(isPending ? "fa-envelope" : isResolved ? "fa-ban" : "fa-circle-check")"></i>
                    </div>
                    <div>
                        <h2>@(isPending ? "Awaiting your response" : isResolved ? (isExpired ? "Booking expired" : "Booking closed") : "Job Status & Progress")</h2>
                        <p class="mb-0">@(isPending ? "Please review the request details below and respond to confirm your availability." : isResolved ? "This booking is concluded. No further action is required." : "Keep track of this job's active milestones.")</p>
                    </div>
                </div>

                @if (!isResolved)
                {
                    <div class="client-flow-steps">
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            var done = i < step;
                            var current = i == step;
                            <div class="client-flow-step @(done ? "is-done" : "") @(current ? "is-current" : "")">
                                <span>
                                    @if (done) { <i class="fa-solid fa-check"></i> }
                                    else { <i class="fa-solid @(steps[i] switch { "Requested" => "fa-paper-plane", "Accepted" => "fa-handshake", "Payment" => "fa-credit-card", "In Progress" => "fa-hammer", _ => "fa-flag-checkered" })"></i> }
                                </span>
                                <strong>@steps[i]</strong>
                                <small>@(i == 0 ? "Request received" : i == 1 ? "You accepted" : i == 2 ? "Payment secured" : i == 3 ? "On the job" : "Job completed")</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <article class="client-flow-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon green">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <h2>@Model.ClientName</h2>
                            <p class="text-muted mb-0">Client &bull; @Model.ServiceName</p>
                        </div>
                    </div>

                    <div class="booking-response-card__details booking-flow-details flex-wrap">
                        <span><i class="fa-regular fa-calendar"></i> Service Date: <strong>@Model.DateOfService.ToString("MMM dd, yyyy")</strong></span>
                        <span><i class="fa-regular fa-clock"></i> Time Slot: <strong>@Model.TimeRange</strong></span>
                        <span><i class="fa-solid fa-coins text-success"></i> Gross Amount: <strong>&#8358;@Model.Amount.ToString("N0")</strong></span>
                        <span><i class="fa-solid fa-location-dot text-teal"></i> Address: <strong>@Model.Address</strong></span>
                    </div>

                    <div class="client-flow-card__footer client-flow-card__footer--worker">
                        <div class="client-flow-card__footer-top">
                            <span class="booking-response-note">
                                @if (isPending)
                                {
                                    <text><i class="fa-solid fa-inbox text-warning me-1"></i> Respond to this booking to confirm your availability for this date.</text>
                                }
                                else if (isRejected)
                                {
                                    <text><i class="fa-solid fa-circle-xmark text-danger me-1"></i> You declined this booking request.</text>
                                }
                                else if (isCancelled)
                                {
                                    <text><i class="fa-solid fa-ban text-muted me-1"></i> This booking was cancelled.</text>
                                }
                                else if (isPaid)
                                {
                                    <text><i class="fa-solid fa-play text-success me-1"></i> Client payment is secured in escrow. When you arrive on site, tap Request to Start.</text>
                                }
                                else if (isAwaitingStart)
                                {
                                    <text><i class="fa-solid fa-hourglass-half text-teal me-1"></i> Start request submitted. Waiting for the client to confirm work has begun.</text>
                                }
                                else if (isInProgress)
                                {
                                    <text><i class="fa-solid fa-broom text-teal me-1"></i> Job is currently in progress. Mark it as done when you finish the cleaning.</text>
                                }
                                else if (isAwaitingConfirm)
                                {
                                    <text><i class="fa-solid fa-hourglass-half text-teal me-1"></i> Completion request submitted. Waiting for client approval to release escrow payment.</text>
                                }
                                else if (isCompleted)
                                {
                                    <text><i class="fa-solid fa-circle-check text-success me-1"></i> Job successfully completed! Escrow payment has been credited to your account.</text>
                                }
                                else if (isExpired)
                                {
                                    <text><i class="fa-solid fa-calendar-xmark text-danger me-1"></i> This booking expired because the service date passed before completion.</text>
                                }
                                else
                                {
                                    <text><i class="fa-solid fa-circle-check text-muted me-1"></i> Your response has been recorded.</text>
                                }
                            </span>

                            <div class="booking-response-actions">
                                @if (isPending)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                            <i class="fa-solid fa-message me-1"></i> Message Client
                                        </a>
                                        <form asp-action="Accept" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post" class="d-inline" id="formAcceptBooking">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn cc-action-button cc-action-button--primary" id="btnAcceptBooking">
                                                <i class="fa-solid fa-check me-1"></i> Accept Request
                                            </button>
                                        </form>

                                        <button type="button" id="btnToggleDecline" class="btn cc-action-button cc-action-button--outline-danger" aria-expanded="false" aria-controls="declineDropdownCard">
                                            <i class="fa-solid fa-xmark me-1"></i> Decline
                                        </button>
                                    </div>
                                }
                                else if (isPaid)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                        <i class="fa-solid fa-message me-1"></i> Message Client
                                    </a>
                                    <form asp-action="StartJob" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn cc-action-button cc-action-button--primary">
                                            <i class="fa-solid fa-play me-1"></i> Request to Start Job
                                        </button>
                                    </form>
                                    </div>
                                }
                                else if (isInProgress)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                        <i class="fa-solid fa-message me-1"></i> Message Client
                                    </a>
                                    <form asp-action="CompleteJob" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn cc-action-button cc-action-button--primary">
                                            <i class="fa-solid fa-flag-checkered me-1"></i> Mark as Done
                                        </button>
                                    </form>
                                    </div>
                                }
                                else if (!isResolved)
                                {
                                    <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                        <i class="fa-solid fa-message me-1"></i> Message Client
                                    </a>
                                }
                            </div>
                        </div>

                        @if (isPending)
                        {
                            <!-- Full-width Dropdown / Pop-up Box for Comment & Decline Reason -->
                            <div id="declineDropdownCard" class="booking-decline-dropdown-box mt-3" style="display: none;">
                                <div class="booking-decline-card">
                                    <div class="booking-decline-card__header d-flex justify-content-between align-items-center mb-2">
                                        <span class="booking-decline-card__title">
                                            <i class="fa-solid fa-circle-exclamation text-danger me-2"></i>
                                            <strong>Decline Booking Request</strong>
                                        </span>
                                        <button type="button" id="btnCloseDecline" class="btn-close" aria-label="Close decline box"></button>
                                    </div>

                                    <p class="small text-muted mb-3">
                                        Please provide a reason or comment for declining so the client is informed.
                                    </p>

                                    <form asp-action="Reject" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post" id="formRejectBooking" novalidate>
                                        @Html.AntiForgeryToken()

                                        <!-- Dropdown Select for Predefined Reasons -->
                                        <div class="mb-3">
                                            <label for="declineReasonDropdown" class="form-label small fw-semibold">
                                                Select reason <span class="text-muted fw-normal">(quick select)</span>:
                                            </label>
                                            <select id="declineReasonDropdown" class="form-select">
                                                <option value="">-- Choose a reason or write custom comment --</option>
                                                <option value="Schedule conflict: I am unavailable at the requested time slot.">Schedule conflict / Unavailable at requested time</option>
                                                <option value="Location is outside my service coverage area.">Location is outside my service coverage area</option>
                                                <option value="Fully booked for this date and cannot take more jobs.">Fully booked for this date</option>
                                                <option value="Unable to accommodate specific equipment or service requirements.">Cannot accommodate specific service requirements</option>
                                                <option value="Personal emergency or unexpected unavailability.">Personal emergency or illness</option>
                                                <option value="CUSTOM">Other reason (write custom comment)</option>
                                            </select>
                                        </div>

                                        <!-- Comment Input Box (Textarea) -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label for="rejectionReasonTextarea" class="form-label small fw-semibold mb-0">
                                                    Comment / Reason <span class="text-danger">*</span>:
                                                </label>
                                                <small class="text-muted" id="rejectionCharCounter">0/500</small>
                                            </div>
                                            <textarea name="rejectionReason" id="rejectionReasonTextarea" class="form-control" rows="3" maxlength="500" placeholder="Type your comment or reason for declining here (required)..."></textarea>
                                            <div class="invalid-feedback d-none" id="rejectionReasonError">
                                                Please select a reason or provide a comment before declining.
                                            </div>
                                        </div>

                                        <!-- Submit & Cancel Actions -->
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <button type="submit" class="btn cc-action-button cc-action-button--outline-danger" id="btnSubmitDecline">
                                                <i class="fa-solid fa-xmark me-1"></i> Submit &amp; Decline
                                            </button>
                                            <button type="button" id="btnCancelDecline" class="btn cc-action-button cc-action-button--secondary">
                                                <i class="fa-solid fa-arrow-rotate-left me-1"></i> Cancel
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        @if (isRejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <div class="booking-rejection-reason mt-3">
                                <i class="fa-solid fa-comment-dots text-danger"></i>
                                <div>
                                    <strong>Reason provided to client:</strong>
                                    <p class="mb-0">@Model.RejectionReason</p>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            </div>

            <!-- Request Summary Column -->
            <div class="col-lg-4">
                <article class="client-flow-card request-summary-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon neutral">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div>
                            <h2>Request Summary</h2>
                            <p class="small text-muted mb-0">Booking breakdown &amp; details</p>
                        </div>
                    </div>

                    <div class="booking-review-list">
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-user text-muted me-2"></i>Client</span>
                            <strong>@Model.ClientName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-broom text-muted me-2"></i>Service</span>
                            <strong>@Model.ServiceName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-check text-muted me-2"></i>Requested on</span>
                            <strong>@Model.BookingDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-days text-muted me-2"></i>Service date</span>
                            <strong>@Model.DateOfService.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-clock text-muted me-2"></i>Time slot</span>
                            <strong>@Model.TimeRange</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-tag text-muted me-2"></i>Status</span>
                            <strong><span class="status-badge tone-@statusTone">@statusLabel</span></strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-credit-card text-muted me-2"></i>Payment</span>
                            <strong><span class="status-badge tone-@paymentTone">@paymentLabel</span></strong>
                        </div>
                    </div>

                    <div class="request-summary-price-box">
                        <span class="request-summary-price-label">Total Job Amount</span>
                        <strong class="request-summary-price-value">&#8358;@Model.Amount.ToString("N0")</strong>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toggleBtn = document.getElementById("btnToggleDecline");
            var closeBtn = document.getElementById("btnCloseDecline");
            var cancelBtn = document.getElementById("btnCancelDecline");
            var declineBox = document.getElementById("declineDropdownCard");
            var reasonSelect = document.getElementById("declineReasonDropdown");
            var reasonTextarea = document.getElementById("rejectionReasonTextarea");
            var charCounter = document.getElementById("rejectionCharCounter");
            var rejectForm = document.getElementById("formRejectBooking");
            var errorFeedback = document.getElementById("rejectionReasonError");
            var submitBtn = document.getElementById("btnSubmitDecline");
            var acceptForm = document.getElementById("formAcceptBooking");
            var acceptBtn = document.getElementById("btnAcceptBooking");

            if (acceptForm && acceptBtn) {
                acceptForm.addEventListener("submit", function () {
                    acceptBtn.disabled = true;
                    acceptBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Accepting...';
                });
            }

            if (!toggleBtn || !declineBox) return;

            function openDeclineBox() {
                declineBox.style.display = "block";
                toggleBtn.setAttribute("aria-expanded", "true");
                toggleBtn.classList.add("active");
                setTimeout(function () {
                    declineBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
                    if (reasonSelect) {
                        reasonSelect.focus();
                    }
                }, 50);
            }

            function closeDeclineBox() {
                declineBox.style.display = "none";
                toggleBtn.setAttribute("aria-expanded", "false");
                toggleBtn.classList.remove("active");
                if (reasonSelect) reasonSelect.value = "";
                if (reasonTextarea) {
                    reasonTextarea.value = "";
                    reasonTextarea.classList.remove("is-invalid");
                }
                if (errorFeedback) {
                    errorFeedback.classList.add("d-none");
                }
                if (charCounter) charCounter.textContent = "0/500";
                toggleBtn.focus();
            }

            toggleBtn.addEventListener("click", function () {
                var isVisible = declineBox.style.display !== "none";
                if (isVisible) {
                    closeDeclineBox();
                } else {
                    openDeclineBox();
                }
            });

            if (closeBtn) closeBtn.addEventListener("click", closeDeclineBox);
            if (cancelBtn) cancelBtn.addEventListener("click", closeDeclineBox);

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && declineBox.style.display !== "none") {
                    closeDeclineBox();
                }
            });

            function updateCharCount() {
                if (reasonTextarea && charCounter) {
                    charCounter.textContent = reasonTextarea.value.length + "/500";
                }
            }

            if (reasonSelect && reasonTextarea) {
                reasonSelect.addEventListener("change", function () {
                    var selectedVal = reasonSelect.value;
                    if (selectedVal === "CUSTOM") {
                        reasonTextarea.value = "";
                        reasonTextarea.focus();
                    } else if (selectedVal) {
                        reasonTextarea.value = selectedVal;
                    } else {
                        reasonTextarea.value = "";
                    }
                    updateCharCount();
                    reasonTextarea.classList.remove("is-invalid");
                    if (errorFeedback) errorFeedback.classList.add("d-none");
                });
            }

            if (reasonTextarea) {
                reasonTextarea.addEventListener("input", function () {
                    updateCharCount();
                    if (reasonTextarea.value.trim().length > 0) {
                        reasonTextarea.classList.remove("is-invalid");
                        if (errorFeedback) errorFeedback.classList.add("d-none");
                    }
                });
            }

            if (rejectForm && reasonTextarea) {
                rejectForm.addEventListener("submit", function (e) {
                    var val = reasonTextarea.value.trim();
                    if (!val) {
                        e.preventDefault();
                        reasonTextarea.classList.add("is-invalid");
                        if (errorFeedback) errorFeedback.classList.remove("d-none");
                        reasonTextarea.focus();
                        return false;
                    }
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Declining...';
                    }
                    if (cancelBtn) cancelBtn.disabled = true;
                    if (closeBtn) closeBtn.disabled = true;
                });
            }
        });
    </script>
}
