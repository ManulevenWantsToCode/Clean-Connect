@model Clean_Connect.Application.DTO.BookingDto
@using Clean_Connect.Web.Helpers

@{
    ViewData["Title"] = "Booking Details";
    Layout = "_DashboardLayout";

    var statusLabel = BookingStatusHelper.BookingLabel(Model.BookingStatus);
    var statusTone = BookingStatusHelper.BookingTone(Model.BookingStatus);
    var paymentLabel = BookingStatusHelper.PaymentLabel(Model.PaymentStatus);
    var paymentTone = BookingStatusHelper.PaymentTone(Model.PaymentStatus);
    var step = BookingStatusHelper.FlowStep(Model.BookingStatus);
    var isAccepted = string.Equals(Model.BookingStatus, "AcceptedAwaitingPayment", StringComparison.OrdinalIgnoreCase);
    var isPaid = string.Equals(Model.BookingStatus, "MarkAsPaid", StringComparison.OrdinalIgnoreCase);
    var isAwaitingStart = string.Equals(Model.BookingStatus, "AwaitingClientStartConfirmation", StringComparison.OrdinalIgnoreCase);
    var isInProgress = string.Equals(Model.BookingStatus, "InProgress", StringComparison.OrdinalIgnoreCase);
    var isAwaitingConfirm = string.Equals(Model.BookingStatus, "AwaitingClientConfirmation", StringComparison.OrdinalIgnoreCase);
    var isRejected = string.Equals(Model.BookingStatus, "Rejected", StringComparison.OrdinalIgnoreCase);
    var isCancelled = string.Equals(Model.BookingStatus, "Cancelled", StringComparison.OrdinalIgnoreCase);
    var isCompleted = string.Equals(Model.BookingStatus, "Completed", StringComparison.OrdinalIgnoreCase);
    var isExpired = string.Equals(Model.BookingStatus, "Expired", StringComparison.OrdinalIgnoreCase);
    var isResolved = isRejected || isCancelled || isExpired;

    var steps = new[] { "Requested", "Accepted", "Payment", "In Progress", "Completed" };
}

<div class="dash-page booking-workflow-page">
    <div class="container">
        <!-- Back Link -->
        <a asp-controller="Booking" asp-action="ClientResponses" class="booking-back-link mb-4">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to my bookings</span>
        </a>

        <!-- Hero Section -->
        <div class="booking-hero booking-hero--detail">
            <div>
                <span class="booking-kicker">
                    <i class="fa-solid fa-receipt"></i>
                    Booking #@Model.Id.ToString().Substring(0, 8).ToUpper()
                </span>
                <h1>@Model.ServiceName</h1>
                <p>Your cleaning appointment with <strong>@Model.WorkersName</strong>, requested on @Model.BookingDate.ToString("MMM dd, yyyy").</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="status-badge tone-@statusTone">@statusLabel</span>
                <span class="status-badge tone-@paymentTone">@paymentLabel</span>
            </div>
        </div>

        <!-- Flow Progress -->
        <div class="booking-flow-progress mb-4">
            <div class="client-flow-card">
                <div class="client-flow-card__top">
                    <div class="client-flow-card__icon @(isResolved ? "danger" : isAccepted ? "success" : "warning")">
                        <i class="fa-solid @(isRejected ? "fa-circle-xmark" : isCancelled || isExpired ? "fa-ban" : isAccepted ? "fa-circle-check" : "fa-clock")"></i>
                    </div>
                    <div>
                        <h2>@(isRejected ? "Declined by cleaner" : isCancelled ? "Booking cancelled" : isExpired ? "Booking expired" : "Service Progress")</h2>
                        <p class="mb-0">@(isResolved ? "This request is no longer active. You can find another cleaner at any time." : "Track the realtime status of your booking below.")</p>
                    </div>
                </div>

                @if (!isResolved)
                {
                    <div class="client-flow-steps">
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            var done = i < step;
                            var current = i == step;
                            <div class="client-flow-step @(done ? "is-done" : "") @(current ? "is-current" : "")">
                                <span>
                                    @if (done) { <i class="fa-solid fa-check"></i> }
                                    else { <i class="fa-solid @(steps[i] switch { "Requested" => "fa-paper-plane", "Accepted" => "fa-handshake", "Payment" => "fa-credit-card", "In Progress" => "fa-hammer", _ => "fa-flag-checkered" })"></i> }
                                </span>
                                <strong>@steps[i]</strong>
                                <small>@(i == 0 ? "Request placed" : i == 1 ? "Cleaner accepted" : i == 2 ? "Payment secured" : i == 3 ? "Cleaner on the job" : "Service finished")</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <article class="client-flow-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon green">
                            <i class="fa-solid fa-user-check"></i>
                        </div>
                        <div>
                            <h2>@Model.WorkersName</h2>
                            <p class="text-muted mb-0">Assigned Professional &bull; @Model.ServiceName</p>
                        </div>
                    </div>

                    <div class="booking-response-card__details booking-flow-details flex-wrap">
                        <span><i class="fa-regular fa-calendar"></i> Service Date: <strong>@Model.DateOfService.ToString("MMM dd, yyyy")</strong></span>
                        <span><i class="fa-regular fa-clock"></i> Time Slot: <strong>@Model.TimeRange</strong></span>
                        <span><i class="fa-solid fa-coins text-success"></i> Amount: <strong>&#8358;@Model.Amount.ToString("N0")</strong></span>
                        <span><i class="fa-solid fa-location-dot text-teal"></i> Address: <strong>@Model.Address</strong></span>
                    </div>

                    @if (isRejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
                    {
                        <div class="booking-rejection-reason">
                            <i class="fa-solid fa-comment-dots text-danger"></i>
                            <div>
                                <strong>Reason provided by the cleaner:</strong>
                                <p class="mb-0">@Model.RejectionReason</p>
                            </div>
                        </div>
                    }

                    <div class="client-flow-card__footer @(isAccepted ? "client-flow-card__footer--payment" : "")">
                        <span class="booking-response-note">
                            @if (isAccepted) {
                                <text><i class="fa-solid fa-lock text-success me-1"></i> Cleaner accepted your request! Proceed to secure your booking with escrow payment.</text>
                            }
                            else if (isAwaitingStart) {
                                <text><i class="fa-solid fa-user-check text-success me-1"></i> @Model.WorkersName has arrived. Confirm to mark the job as started.</text>
                            }
                            else if (isInProgress) {
                                <text><i class="fa-solid fa-broom text-teal me-1"></i> @Model.WorkersName is currently on the job. Track updates here.</text>
                            }
                            else if (isAwaitingConfirm) {
                                <text><i class="fa-solid fa-circle-check text-success me-1"></i> @Model.WorkersName completed the job. Confirm completion to release payment.</text>
                            }
                            else if (isRejected) {
                                <text><i class="fa-solid fa-circle-info text-danger me-1"></i> This cleaner was unable to take your request.</text>
                            }
                            else if (isCancelled) {
                                <text><i class="fa-solid fa-circle-info text-muted me-1"></i> This booking has been cancelled.</text>
                            }
                            else if (isExpired) {
                                <text><i class="fa-solid fa-clock text-warning me-1"></i> This booking expired because it was not completed by the service date.</text>
                            }
                            else if (isCompleted && Model.HasRating) {
                                <text><i class="fa-solid fa-star text-warning me-1"></i> Thank you! Your review for @Model.WorkersName has been recorded.</text>
                            }
                            else if (isCompleted) {
                                <text><i class="fa-solid fa-star text-warning me-1"></i> Job successfully completed! Please rate your experience with @Model.WorkersName.</text>
                            }
                            else {
                                <text><i class="fa-solid fa-hourglass-half text-teal me-1"></i> Waiting for @Model.WorkersName to respond to your request.</text>
                            }
                        </span>

                        <div class="@(isAccepted ? "booking-payment-actions" : "mt-3")">
                            @if (isAccepted)
                            {
                                <div class="booking-payment-actions__stack">
                                <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                    <i class="fa-solid fa-message me-1"></i> Message Worker
                                </a>
                                <form class="booking-payment-actions__form" asp-action="Pay" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn cc-action-button cc-action-button--primary cc-action-button--large booking-payment-actions__button">
                                        <i class="fa-solid fa-lock me-1"></i> Proceed to Payment (&#8358;@Model.Amount.ToString("N0"))
                                    </button>
                                </form>
                                </div>
                            }
                            else if (isAwaitingStart)
                            {
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                    <i class="fa-solid fa-message me-1"></i> Message Worker
                                </a>
                                <form asp-action="ConfirmStart" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn cc-action-button cc-action-button--primary">
                                        <i class="fa-solid fa-play me-1"></i> Confirm Job Started
                                    </button>
                                </form>
                                </div>
                            }
                            else if (isAwaitingConfirm)
                            {
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                    <i class="fa-solid fa-message me-1"></i> Message Worker
                                </a>
                                <form asp-action="ConfirmCompletion" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn cc-action-button cc-action-button--primary">
                                        <i class="fa-solid fa-circle-check me-1"></i> Confirm Completion &amp; Release Funds
                                    </button>
                                </form>
                                </div>
                            }
                            else if (!isResolved && !isCompleted)
                            {
                                <a asp-controller="Booking" asp-action="Chat" asp-route-bookingId="@Model.Id" class="btn cc-action-button cc-action-button--secondary">
                                    <i class="fa-solid fa-message me-1"></i> Message Worker
                                </a>
                            }
                            else if (isRejected)
                            {
                                <a asp-controller="Booking" asp-action="ChooseWorker" class="btn cc-action-button cc-action-button--secondary">
                                    <i class="fa-solid fa-magnifying-glass me-1"></i> Find Another Cleaner
                                </a>
                            }
                            else if (isCompleted && !Model.HasRating)
                            {
                                <form asp-action="Rate" asp-controller="Booking" asp-route-bookingId="@Model.Id" method="post" class="booking-rating-form mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="RatingValue" id="ratingValue" value="5" />
                                    <label class="form-label fw-bold">Rate @Model.WorkersName:</label>
                                    <div class="booking-rating-stars">
                                        @for (int s = 5; s >= 1; s--)
                                        {
                                            <button type="button" class="booking-rating-star is-active" data-value="@s" title="@s Stars"><i class="fa-solid fa-star"></i></button>
                                        }
                                    </div>
                                    <textarea name="Comment" class="form-control mt-2" rows="2" placeholder="Share your experience with @Model.WorkersName (optional)" maxlength="500"></textarea>
                                    <button type="submit" class="btn cc-action-button cc-action-button--primary mt-2">
                                        <i class="fa-solid fa-star me-1"></i> Submit Review
                                    </button>
                                </form>
                            }
                            else if (isCompleted && Model.HasRating)
                            {
                                <span class="booking-rating-done d-inline-flex align-items-center gap-1 text-success fw-semibold">
                                    <i class="fa-solid fa-circle-check"></i> Review submitted. Thank you!
                                </span>
                            }
                        </div>
                    </div>
                </article>
            </div>

            <!-- Summary Sidebar -->
            <div class="col-lg-4">
                <article class="client-flow-card request-summary-card">
                    <div class="client-flow-card__top">
                        <div class="client-flow-card__icon neutral">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div>
                            <h2>Request Summary</h2>
                            <p class="small text-muted mb-0">Booking breakdown &amp; details</p>
                        </div>
                    </div>

                    <div class="booking-review-list">
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-user text-muted me-2"></i>Cleaner</span>
                            <strong>@Model.WorkersName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-broom text-muted me-2"></i>Service</span>
                            <strong>@Model.ServiceName</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-check text-muted me-2"></i>Requested on</span>
                            <strong>@Model.BookingDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-calendar-days text-muted me-2"></i>Service date</span>
                            <strong>@Model.DateOfService.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-regular fa-clock text-muted me-2"></i>Time slot</span>
                            <strong>@Model.TimeRange</strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-tag text-muted me-2"></i>Status</span>
                            <strong><span class="status-badge tone-@statusTone">@statusLabel</span></strong>
                        </div>
                        <div class="booking-review-row">
                            <span><i class="fa-solid fa-credit-card text-muted me-2"></i>Payment</span>
                            <strong><span class="status-badge tone-@paymentTone">@paymentLabel</span></strong>
                        </div>
                    </div>

                    <div class="request-summary-price-box">
                        <span class="request-summary-price-label">Total Booking Amount</span>
                        <strong class="request-summary-price-value">&#8358;@Model.Amount.ToString("N0")</strong>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".booking-rating-star").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var value = parseInt(btn.dataset.value, 10);
                document.getElementById("ratingValue").value = value;
                document.querySelectorAll(".booking-rating-star").forEach(function (b) {
                    b.classList.toggle("is-active", parseInt(b.dataset.value, 10) <= value);
                });
            });
        });
    </script>
}
