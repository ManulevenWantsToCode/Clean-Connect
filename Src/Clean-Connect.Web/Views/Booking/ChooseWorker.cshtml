@model Clean_Connect.Web.Models.ChooseWorkerViewModel
@using System.Text.Json
@using Clean_Connect.Web.Helpers

@{
    ViewData["Title"] = "Choose a Cleaner";
    Layout = "_DashboardLayout";
}

<div class="dash-page booking-workflow-page">
    <div class="container">
        <!-- Navigation Breadcrumb -->
        <a asp-controller="Booking" asp-action="Create" class="booking-back-link mb-4">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to booking details</span>
        </a>

        <!-- Hero Section -->
        <div class="booking-hero booking-hero--detail">
            <div>
                <span class="booking-kicker">
                    <i class="fa-solid fa-user-check"></i>
                    Verified Cleaners
                </span>
                <h1>Find available cleaners for @Model.DateOfService.ToString("MMM dd, yyyy")</h1>
                <p>
                    Browse verified, background-checked cleaning professionals near you. Check live ratings, hourly rates, and tap <strong>View Details</strong> to review full profiles before booking.
                </p>
            </div>
            <div class="booking-hero__summary">
                <span class="booking-hero__count">
                    <span class="cc-pulse-dot"></span>
                    @Model.AvailableCount cleaner@(Model.AvailableCount == 1 ? "" : "s") available
                </span>
                <strong>Active &amp; ready to book</strong>
            </div>
        </div>

        <!-- Filter Form -->
        <form asp-action="WorkerResults" asp-controller="Booking" method="get" class="choose-worker-filters mb-4" id="chooseWorkerFilters">
            <div class="filter-col">
                <label class="form-label" for="cwService">
                    <i class="fa-solid fa-broom me-1 text-muted"></i> Service type
                </label>
                <select name="serviceTypeId" id="cwService" class="form-select">
                    <option value="">All cleaning services</option>
                    @if (Model.ServiceTypes != null)
                    {
                        foreach (var s in Model.ServiceTypes)
                        {
                            <option value="@s.Value" selected="@(s.Value == Model.SelectedServiceTypeId?.ToString())">@s.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-col">
                <label class="form-label" for="cwDate">
                    <i class="fa-regular fa-calendar me-1 text-muted"></i> Service date
                </label>
                <input type="date" name="dateOfService" id="cwDate" class="form-control" value="@Model.DateOfService.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-col">
                <label class="form-label" for="cwTime">
                    <i class="fa-regular fa-clock me-1 text-muted"></i> Preferred time
                </label>
                <select name="timeRange" id="cwTime" class="form-select">
                    @if (Model.TimeRanges != null)
                    {
                        foreach (var t in Model.TimeRanges)
                        {
                            <option value="@t.Value" selected="@(t.Value == Model.TimeRange)">@t.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-col">
                <label class="form-label" for="cwRadius">
                    <i class="fa-solid fa-location-crosshairs me-1 text-muted"></i> Search distance
                </label>
                <select name="radiusInMeters" id="cwRadius" class="form-select">
                    @if (Model.RadiusOptions != null)
                    {
                        foreach (var r in Model.RadiusOptions)
                        {
                            var isSelected = string.IsNullOrEmpty(r.Value)
                                ? !Model.SelectedRadiusInMeters.HasValue
                                : (r.Value == Model.SelectedRadiusInMeters?.ToString());
                            <option value="@r.Value" selected="@isSelected">@r.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="choose-worker-filters__action">
                <button type="submit" class="btn cc-action-button cc-action-button--primary w-100" id="showCleanersBtn">
                    <i class="fa-solid fa-filter"></i> Apply Filters
                </button>
            </div>
        </form>

        <!-- Dynamic Results Container -->
        <div id="workerResultsContainer">
            @await Html.PartialAsync("_WorkerResults", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("chooseWorkerFilters");
            const container = document.getElementById("workerResultsContainer");
            const dateInput = document.getElementById("cwDate");
            const serviceSelect = document.getElementById("cwService");
            const timeSelect = document.getElementById("cwTime");
            const radiusSelect = document.getElementById("cwRadius");
            const showBtn = document.getElementById("showCleanersBtn");

            if (dateInput) {
                dateInput.min = new Date().toISOString().split("T")[0];
            }

            let requestId = 0;

            function refreshResults() {
                if (!form || !container) return;

                const id = ++requestId;
                const params = new URLSearchParams(new FormData(form)).toString();
                const url = form.action.split("?")[0] + (params ? "?" + params : "");

                if (showBtn) {
                    showBtn.disabled = true;
                    showBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Searching...';
                }

                container.classList.add("loading-fade");

                fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (res) {
                        if (!res.ok) throw new Error("Request failed");
                        return res.text();
                    })
                    .then(function (html) {
                        if (id !== requestId) return;
                        container.innerHTML = html;
                    })
                    .catch(function (err) {
                        if (id !== requestId) return;
                        console.debug("Could not refresh workers.", err);
                    })
                    .finally(function () {
                        if (id !== requestId) return;
                        container.classList.remove("loading-fade");
                        if (showBtn) {
                            showBtn.disabled = false;
                            showBtn.innerHTML = '<i class="fa-solid fa-filter"></i> Apply Filters';
                        }
                    });
            }

            [serviceSelect, timeSelect, radiusSelect].forEach(function (el) {
                if (el) el.addEventListener("change", refreshResults);
            });

            if (dateInput) {
                dateInput.addEventListener("change", refreshResults);
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    refreshResults();
                });
            }
        });
    </script>
}
