@model Clean_Connect.Application.DTO.Pagination.PagedResponse<Clean_Connect.Application.DTO.BookingDto>
@using Clean_Connect.Web.Helpers

@{
    ViewData["Title"] = "Worker Responses";
    Layout = "_DashboardLayout";

    var rows = Model.Items;
    var total = Model.TotalCount;
    var pending = rows.Count(b => b.BookingStatus == "Pending");
    var active = rows.Count(b => b.BookingStatus is "AcceptedAwaitingPayment" or "MarkAsPaid" or "AwaitingClientStartConfirmation" or "InProgress" or "AwaitingClientConfirmation");
    var completed = rows.Count(b => b.BookingStatus == "Completed");
    var declined = rows.Count(b => b.BookingStatus is "Rejected" or "Cancelled" or "Expired");
    var currentStatus = Context.Request.Query["Status"].ToString();
    var currentSort = string.IsNullOrWhiteSpace(Context.Request.Query["SortBy"]) ? "serviceDate" : Context.Request.Query["SortBy"].ToString();
    var currentDirection = string.IsNullOrWhiteSpace(Context.Request.Query["SortDirection"]) ? "desc" : Context.Request.Query["SortDirection"].ToString();
    var currentFromDate = Context.Request.Query["FromDate"].ToString();
    var currentToDate = Context.Request.Query["ToDate"].ToString();
    var currentSearchTerm = Context.Request.Query["SearchTerm"].ToString();
    var previousRoute = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
    previousRoute["page"] = (Model.Page - 1).ToString();
    previousRoute["pageSize"] = Model.PageSize.ToString();
    var nextRoute = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
    nextRoute["page"] = (Model.Page + 1).ToString();
    nextRoute["pageSize"] = Model.PageSize.ToString();
}

<div class="dash-page booking-workflow-page">
    <div class="container">
        <div class="booking-hero">
            <div>
                <span class="booking-kicker">
                    <i class="fa-solid fa-bell"></i>
                    Booking Flow
                </span>
                <h1>Your client bookings</h1>
                <p>Track each request after the worker responds, secure payment, or choose another professional when a request is declined.</p>
            </div>
            <a asp-controller="Booking" asp-action="ChooseWorker" class="booking-hero__link">
                <i class="fa-solid fa-calendar-plus"></i>
                New Booking
            </a>
        </div>

        <form method="get" asp-action="ClientResponses" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <input type="hidden" name="SortBy" value="@currentSort" />
            <input type="hidden" name="SortDirection" value="@currentDirection" />
            <div class="col-sm-5 col-lg-3"><label class="form-label" for="bookingSearchFilter">Search</label><input class="form-control" id="bookingSearchFilter" type="search" maxlength="100" name="SearchTerm" value="@currentSearchTerm" placeholder="Worker or service" /></div>
            <div class="col-sm-4 col-lg-3">
                <label class="form-label" for="bookingStatusFilter">Status</label>
                <select class="form-select" id="bookingStatusFilter" name="Status">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetNames<Clean_Connect.Domain.Enums.BookingStatus>())
                    {
                        if (currentStatus == status) { <option value="@status" selected>@status</option> }
                        else { <option value="@status">@status</option> }
                    }
                </select>
            </div>
            <div class="col-sm-3 col-lg-2"><label class="form-label" for="fromDateFilter">From</label><input class="form-control" id="fromDateFilter" type="date" name="FromDate" value="@currentFromDate" /></div>
            <div class="col-sm-3 col-lg-2"><label class="form-label" for="toDateFilter">To</label><input class="form-control" id="toDateFilter" type="date" name="ToDate" value="@currentToDate" /></div>
            <div class="col-auto"><button class="btn btn-success" type="submit">Apply filters</button></div>
            <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="ClientResponses">Reset</a></div>
        </form>

        @if (total == 0)
        {
            <div class="booking-empty">
                <i class="fa-solid fa-inbox"></i>
                <h2>No bookings yet</h2>
                <p>Once a worker accepts or declines your booking request, the response will appear here.</p>
                <a asp-controller="Booking" asp-action="ChooseWorker" class="btn btn-success rounded-pill px-4 mt-3">
                    <i class="fa-solid fa-calendar-plus me-2"></i>Create a booking
                </a>
            </div>
        }
        else
        {
            <div class="bookings-stats">
                <div class="bookings-stat">
                    <span class="bookings-stat__icon neutral"><i class="fa-solid fa-list"></i></span>
                    <div><strong>@total</strong><small>Total</small></div>
                </div>
                <div class="bookings-stat">
                    <span class="bookings-stat__icon warning"><i class="fa-solid fa-hourglass-half"></i></span>
                    <div><strong>@pending</strong><small>Pending on page</small></div>
                </div>
                <div class="bookings-stat">
                    <span class="bookings-stat__icon success"><i class="fa-solid fa-gears"></i></span>
                    <div><strong>@active</strong><small>Active on page</small></div>
                </div>
                <div class="bookings-stat">
                    <span class="bookings-stat__icon info"><i class="fa-solid fa-circle-check"></i></span>
                    <div><strong>@completed</strong><small>Completed on page</small></div>
                </div>
                <div class="bookings-stat">
                    <span class="bookings-stat__icon danger"><i class="fa-solid fa-circle-xmark"></i></span>
                    <div><strong>@declined</strong><small>Declined on page</small></div>
                </div>
            </div>

            <div class="bookings-card">
                <div class="bookings-card__toolbar">
                    <div class="bookings-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="bookingsSearch" placeholder="Search worker or service..." />
                    </div>
                    <div class="bookings-chips" id="bookingsChips">
                        <button type="button" class="chip is-active" data-filter="all">All</button>
                        <button type="button" class="chip" data-filter="pending">Pending</button>
                        <button type="button" class="chip" data-filter="active">Active</button>
                        <button type="button" class="chip" data-filter="completed">Completed</button>
                        <button type="button" class="chip" data-filter="declined">Declined</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 bookings-table">
                        <thead>
                            <tr>
                                <th>Worker</th>
                                <th>Service</th>
                                <th>Service Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th class="text-end">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Items)
                            {
                                var tone = BookingStatusHelper.BookingTone(b.BookingStatus);
                                var ptone = BookingStatusHelper.PaymentTone(b.PaymentStatus);
                                var group = b.BookingStatus == "Pending" ? "pending"
                                    : b.BookingStatus == "Completed" ? "completed"
                                    : b.BookingStatus is "Rejected" or "Cancelled" or "Expired" ? "declined"
                                    : "active";

                                <tr class="bookings-row" data-href="@Url.Action("Details", "Booking", new { bookingId = b.Id })"
                                    data-status="@group"
                                    data-search="@b.WorkersName @b.ServiceName"
                                    role="link" tabindex="0" aria-label="View booking details for @b.ServiceName">
                                    <td>
                                        <span class="bookings-worker">
                                            <span class="bookings-avatar"><i class="fa-solid fa-user"></i></span>
                                            <span class="fw-semibold">@b.WorkersName</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="bookings-service">
                                            <span class="bookings-service__icon"><i class="fa-solid fa-spray-can-sparkles"></i></span>
                                            @b.ServiceName
                                        </span>
                                    </td>
                                    <td class="bookings-date"><i class="fa-regular fa-calendar me-2"></i>@b.DateOfService.ToString("MMM dd, yyyy")</td>
                                    <td class="bookings-amount">&#8358;@b.Amount.ToString("N0")</td>
                                    <td><span class="status-badge tone-@tone">@BookingStatusHelper.BookingLabel(b.BookingStatus)</span></td>
                                    <td><span class="status-badge tone-@ptone">@BookingStatusHelper.PaymentLabel(b.PaymentStatus)</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Booking" asp-action="Details" asp-route-bookingId="@b.Id" class="bookings-view">
                                            <span>View</span><i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 p-3 border-top">
                    <small class="text-muted">Showing page @Model.Page of @(Math.Max(1, Model.TotalPages)) (@Model.TotalCount bookings)</small>
                    <nav aria-label="Booking pages" class="d-flex gap-2">
                        @if (Model.HasPreviousPage) { <a class="btn btn-sm btn-outline-secondary" asp-action="ClientResponses" asp-all-route-data="previousRoute">Previous</a> }
                        else { <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Previous</span> }
                        @if (Model.HasNextPage) { <a class="btn btn-sm btn-outline-secondary" asp-action="ClientResponses" asp-all-route-data="nextRoute">Next</a> }
                        else { <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Next</span> }
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var rows = document.querySelectorAll(".bookings-row");
            var search = document.getElementById("bookingsSearch");
            var chips = document.querySelectorAll("#bookingsChips .chip");
            var activeFilter = "all";

            rows.forEach(function (row) {
                row.addEventListener("click", function (e) {
                    if (e.target.closest("a")) return;
                    window.location.href = row.dataset.href;
                });
                row.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        window.location.href = row.dataset.href;
                    }
                });
            });

            function apply() {
                var q = (search.value || "").toLowerCase().trim();
                rows.forEach(function (row) {
                    var matchFilter = activeFilter === "all" || row.dataset.status === activeFilter;
                    var matchSearch = !q || (row.dataset.search || "").toLowerCase().indexOf(q) !== -1;
                    row.style.display = matchFilter && matchSearch ? "" : "none";
                });
            }

            chips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    chips.forEach(function (c) { c.classList.remove("is-active"); });
                    chip.classList.add("is-active");
                    activeFilter = chip.dataset.filter;
                    apply();
                });
            });

            search.addEventListener("input", apply);
        });
    </script>
}
